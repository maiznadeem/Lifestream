<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Desktop UI (referenced by the spike) -->
    <PackageVersion Include="WPF-UI" Version="4.3.0" />
    <PackageVersion Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.2.0" />
    <!-- LiveCharts 2.2 asks for SkiaSharp 3.119.2 or later and runs on 4.x. These two pins lift the rest of its Skia graph to the
         SkiaSharp version below, so the Desktop loads one SkiaSharp release (and its HarfBuzzSharp), not a 3.x/4.x mix. -->
    <PackageVersion Include="SkiaSharp.Views.WPF" Version="4.157.0" />
    <PackageVersion Include="SkiaSharp.HarfBuzz" Version="4.157.0" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Velopack" Version="1.2.161" />
    <!-- Versions pinned here for the modules built next, so no builder has to edit this file. Not referenced yet. -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Identity.Core" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Microsoft.Data.SqlClient.Extensions.Azure" Version="7.1.2" />
    <!-- Photo re-encoding in the API, and (through transitive pinning) the SkiaSharp the Desktop's charts load. Keep these two and the
         two Skia pins above on the same version. -->
    <PackageVersion Include="SkiaSharp" Version="4.157.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.157.0" />
    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
  </ItemGroup>
</Project>
