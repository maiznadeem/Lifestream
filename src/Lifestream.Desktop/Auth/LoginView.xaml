<UserControl x:Class="Lifestream.Desktop.Auth.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Lifestream.Desktop.Controls"
             xmlns:services="clr-namespace:Lifestream.Desktop.Services"
             Focusable="False">
  <UserControl.Resources>
    <services:HasTextToVisibilityConverter x:Key="HasText" />
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </UserControl.Resources>
  <Grid Background="{DynamicResource Brush.SurfaceCanvas}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
      <StackPanel Width="360" Margin="0,32" VerticalAlignment="Center" HorizontalAlignment="Center" KeyboardNavigation.TabNavigation="Cycle">
        <Image Source="{DynamicResource Image.Logo}" Width="56" Height="56" HorizontalAlignment="Left" />
        <TextBlock Style="{DynamicResource Text.Title}" Text="Lifestream" Margin="0,16,0,0" AutomationProperties.HeadingLevel="Level1" />
        <TextBlock Style="{DynamicResource Text.Body}" Foreground="{DynamicResource Brush.TextSecondary}" Text="Sign in to manage donors, requests and stock." Margin="0,4,0,32" />

        <!-- Notice (for example "Your session expired") -->
        <Border Margin="0,0,0,16" Padding="12,8" Background="{DynamicResource Brush.SurfaceRaised}" BorderBrush="{DynamicResource Brush.StatusInfo}" BorderThickness="1"
                CornerRadius="{DynamicResource Radius.Control}" Visibility="{Binding Notice, Converter={StaticResource HasText}}" AutomationProperties.LiveSetting="Polite">
          <TextBlock Style="{DynamicResource Text.Body}" Text="{Binding Notice}" />
        </Border>

        <controls:FormField Label="Username">
          <TextBox x:Name="UsernameBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding AreFieldsReadOnly}" MaxLength="64"
                   AutomationProperties.Name="Username" />
        </controls:FormField>
        <controls:FormField Label="Password">
          <controls:PasswordField x:Name="PasswordBox" Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding AreFieldsReadOnly}"
                                  AutomationProperties.Name="Password" />
        </controls:FormField>

        <!-- Inline message with icon and text; a polite live region so a screen reader hears it. -->
        <Border Margin="0,0,0,16" Padding="12,8" Background="{DynamicResource Brush.SurfaceRaised}" BorderBrush="{DynamicResource Brush.StatusDanger}" BorderThickness="1"
                CornerRadius="{DynamicResource Radius.Control}" Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisibility}}"
                AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="Sign-in problem">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <controls:IconText Style="{DynamicResource Text.Icon}" Text="&#xE783;" Foreground="{DynamicResource Brush.StatusDanger}" VerticalAlignment="Top" Margin="0,2,10,0" />
              <TextBlock Style="{DynamicResource Text.Body}" Text="{Binding Message}" MaxWidth="290" />
            </StackPanel>
            <Button Style="{DynamicResource Button.Secondary}" Content="Retry" Command="{Binding RetryCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" MinHeight="32"
                    Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
        </Border>

        <Button x:Name="SignInButton" Style="{DynamicResource Button.Primary}" Content="Sign in" Command="{Binding SignInCommand}" IsDefault="True"
                controls:ButtonAssist.IsBusy="{Binding SignInCommand.IsRunning}" controls:ButtonAssist.BusyText="Signing in..." HorizontalAlignment="Stretch"
                AutomationProperties.Name="Sign in" />
        <TextBlock Style="{DynamicResource Text.Caption}" Text="or" HorizontalAlignment="Center" Margin="0,12" />
        <Button x:Name="DemoButton" Style="{DynamicResource Button.Secondary}" Content="Try the demo" Command="{Binding DemoCommand}"
                controls:ButtonAssist.IsBusy="{Binding DemoCommand.IsRunning}" controls:ButtonAssist.BusyText="Opening the demo..." HorizontalAlignment="Stretch"
                AutomationProperties.Name="Try the demo" />
        <TextBlock Style="{DynamicResource Text.Caption}" Margin="0,12,0,0" TextAlignment="Center"
                   Text="The demo uses made-up data and is reset every day." />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
