<UserControl x:Class="Lifestream.Desktop.Auth.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Lifestream.Desktop.Controls"
             xmlns:services="clr-namespace:Lifestream.Desktop.Services"
             xmlns:auth="clr-namespace:Lifestream.Client.Auth;assembly=Lifestream.Client"
             FontFamily="{DynamicResource Font.Family}" FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource Brush.Ink}" Focusable="False" SizeChanged="OnSizeChanged" Loaded="OnLoaded">
  <UserControl.Resources>
    <services:HasTextToVisibilityConverter x:Key="HasText" />
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <!-- An inline status row under the fields (notice, problem, waking): a 16 DIP icon in the status colour and the words; no box. -->
    <Style x:Key="StatusRow" TargetType="Grid">
      <Setter Property="Margin" Value="{DynamicResource Inset.T14}" />
    </Style>
  </UserControl.Resources>

  <!-- Direction A sign-in: the form on its own layer at the left (560 DIP, 440 in a compact window); the right side, on Mica, shows the red-cell
       compatibility matrix, something only a blood bank has, centred in the room it has. The matrix side is never scaled: when the window is too
       small for all of it, its caption and then its overline go, and when the matrix itself does not fit the side folds away and the form takes
       the window (LoginView.ApplyLayout). -->
  <Grid x:Name="Root" Background="{DynamicResource Brush.Mica}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="FormColumn" Width="560" />
      <ColumnDefinition x:Name="HeroColumn" Width="*" />
    </Grid.ColumnDefinitions>

    <!-- The form side -->
    <Border x:Name="FormSide" Background="{DynamicResource Brush.Layer}" BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="0,0,1,0">
      <ScrollViewer x:Name="FormScroll" VerticalScrollBarVisibility="Auto" Focusable="False">
        <Grid x:Name="Form" Margin="{DynamicResource Inset.L72T48R72B40}" MinHeight="560" KeyboardNavigation.TabNavigation="Cycle">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel Orientation="Horizontal">
            <controls:LogoMark Width="34" Height="34" />
            <TextBlock Text="Lifestream" FontSize="{DynamicResource FontSize.Section}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" Margin="{DynamicResource Inset.L12}" />
          </StackPanel>

          <StackPanel Grid.Row="2" MaxWidth="416">
            <TextBlock Style="{DynamicResource Text.Display}" Text="Sign in" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock Style="{DynamicResource Text.Body}" FontSize="15" Foreground="{DynamicResource Brush.Ink2}" Text="Use the staff account your administrator set up for you."
                       Margin="{DynamicResource Inset.T8B32}" />

            <!-- Update ready: the feed is checked when the app starts, so this shows before anyone signs in (SHELL-44). -->
            <Grid x:Name="UpdateBanner" Style="{StaticResource StatusRow}" Margin="{DynamicResource Inset.B20}" Visibility="{Binding UpdatePrompt, Converter={StaticResource HasText}}" AutomationProperties.LiveSetting="Polite">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <controls:Icon Kind="Info" Size="16" Foreground="{DynamicResource Brush.Info}" VerticalAlignment="Center" Margin="{DynamicResource Inset.R10}" />
              <TextBlock Grid.Column="1" Style="{DynamicResource Text.Secondary}" Text="{Binding UpdatePrompt}" VerticalAlignment="Center" AutomationProperties.Name="Update ready" />
              <Button Grid.Column="2" Style="{DynamicResource Button.Secondary.Small}" Content="Restart and update" Command="{Binding ApplyUpdateCommand}" Margin="{DynamicResource Inset.L12}"
                      controls:ButtonAssist.IsBusy="{Binding ApplyUpdateCommand.IsRunning}" controls:ButtonAssist.BusyText="Updating" />
            </Grid>

            <!-- Notice (for example "Your session expired") -->
            <Grid Style="{StaticResource StatusRow}" Margin="{DynamicResource Inset.B20}" Visibility="{Binding Notice, Converter={StaticResource HasText}}" AutomationProperties.LiveSetting="Polite">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <controls:Icon Kind="Info" Size="16" Foreground="{DynamicResource Brush.Info}" VerticalAlignment="Top" Margin="{DynamicResource Inset.T1R10}" />
              <TextBlock Grid.Column="1" Style="{DynamicResource Text.Secondary}" Text="{Binding Notice}" />
            </Grid>

            <TextBlock Style="{DynamicResource Text.Label}" Text="Username" Margin="{DynamicResource Inset.B6}" />
            <TextBox x:Name="UsernameBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding AreFieldsReadOnly}" MaxLength="64"
                     controls:InputAssist.Placeholder="Your username" AutomationProperties.Name="Username" />
            <TextBlock Style="{DynamicResource Text.Label}" Text="Password" Margin="{DynamicResource Inset.T18B6}" />
            <controls:PasswordField x:Name="PasswordBox" Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding AreFieldsReadOnly}"
                                    AutomationProperties.Name="Password" PreviewKeyDown="OnPasswordKey" GotKeyboardFocus="OnPasswordFocus" LostKeyboardFocus="OnPasswordFocus" />
            <StackPanel x:Name="CapsLockWarning" Orientation="Horizontal" Margin="{DynamicResource Inset.T6}" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite">
              <controls:Icon Kind="Alert" Size="14" Foreground="{DynamicResource Brush.Warning}" VerticalAlignment="Center" Margin="{DynamicResource Inset.R6}" />
              <TextBlock Style="{DynamicResource Text.Caption}" Foreground="{DynamicResource Brush.Warning}" Text="Caps Lock is on." />
            </StackPanel>

            <CheckBox x:Name="RememberBox" Content="Remember my username on this PC" IsChecked="{Binding RememberUsername}" Margin="{DynamicResource Inset.T16}"
                      Visibility="{Binding CanRememberUsername, Converter={StaticResource BoolToVisibility}}" />

            <!-- The last attempt's problem: an icon and the words, assertive so a screen reader hears it at once; Retry where it helps. -->
            <Grid x:Name="ProblemRow" Style="{StaticResource StatusRow}" Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisibility}}"
                  AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="Sign-in problem">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <controls:Icon Kind="Alert" Size="16" Foreground="{DynamicResource Brush.Critical}" VerticalAlignment="Top" Margin="{DynamicResource Inset.T1R10}" />
              <TextBlock Grid.Column="1" Style="{DynamicResource Text.Secondary}" Foreground="{DynamicResource Brush.Critical}" Text="{Binding Message}" />
              <Button Grid.Column="2" Style="{DynamicResource Button.Secondary.Small}" Content="Retry" Command="{Binding RetryCommand}" Margin="{DynamicResource Inset.L12}" VerticalAlignment="Top"
                      Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <!-- Cold start (2.1.9): the wait card. A cold wake shown as three steps, starting the server, waking the database and signing in, each
                 with its own picture, a clock for the whole wait, the time each finished step took and the active step's progress. A sign-in
                 clicked meanwhile waits for the server and goes as soon as it is ready; Cancel stops it (SHELL-07). Compact, so that Sign in and
                 Try the demo stay in view in an 800 DIP tall window. -->
            <controls:CrispBorder x:Name="WakingBanner" Margin="{DynamicResource Inset.T14}" Padding="{DynamicResource Pad.12}" Background="{DynamicResource Brush.SurfaceRaised}"
                                  BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Control}"
                                  Visibility="{Binding IsWakeCardVisible, Converter={StaticResource BoolToVisibility}}"
                                  AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding WakeTitle}">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Viewbox Width="80" Height="44" VerticalAlignment="Top" Margin="{DynamicResource Inset.R12}">
                    <controls:WakeStepArt x:Name="WakeArt" Step="{Binding Step}" />
                  </Viewbox>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="WakeTitle" Style="{DynamicResource Text.BodyStrong}" Text="{Binding WakeTitle}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="{DynamicResource Inset.T2R6}">
                      <TextBlock x:Name="WakeStepOf" Style="{DynamicResource Text.Caption}" Text="{Binding StepOfText}" />
                      <TextBlock Style="{DynamicResource Text.Caption}" Text="·" Margin="{DynamicResource Inset.H5}" />
                      <TextBlock x:Name="WakeClock" Style="{DynamicResource Text.Caption}" Text="{Binding WakeClock}" AutomationProperties.Name="Time waited" />
                    </StackPanel>
                  </StackPanel>
                  <Button x:Name="CancelButton" Grid.Column="2" Style="{DynamicResource Button.Subtle.Small}" Content="Cancel" Command="{Binding CancelCommand}" VerticalAlignment="Top"
                          Margin="{DynamicResource Inset.L12}" Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Cancel sign-in" />
                </Grid>
                <TextBlock x:Name="WakeExplanation" Style="{DynamicResource Text.Secondary}" Text="{Binding WakeExplanation}" TextWrapping="Wrap" Margin="{DynamicResource Inset.T8}" />
                <ItemsControl x:Name="WakeSteps" ItemsSource="{Binding Steps}" Margin="{DynamicResource Inset.T10}" Focusable="False" IsTabStop="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type auth:WakeStepRow}">
                      <Grid Margin="{DynamicResource Inset.B4}" AutomationProperties.Name="{Binding AutomationName}">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="22" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- The mark: a ring still to come, a turning arc in progress, a tick when done. -->
                        <Ellipse Width="10" Height="10" Stroke="{DynamicResource Brush.Ink3}" StrokeThickness="1.5" HorizontalAlignment="Left" VerticalAlignment="Center"
                                 Margin="{DynamicResource Inset.L2}" Visibility="{Binding IsPending, Converter={StaticResource BoolToVisibility}}" />
                        <controls:WakeSpinner HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                        <controls:Icon Kind="Check" Size="14" Foreground="{DynamicResource Brush.Success}" HorizontalAlignment="Left" VerticalAlignment="Center"
                                       Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                          <TextBlock x:Name="StepLabel" Style="{DynamicResource Text.Secondary}" Text="{Binding Label}" />
                          <TextBlock x:Name="StepHint" Style="{DynamicResource Text.Caption}" Text="{Binding Hint, StringFormat='· {0}'}" Margin="{DynamicResource Inset.L6}" VerticalAlignment="Center"
                                     Visibility="Collapsed" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Style="{DynamicResource Text.Caption}" Text="{Binding Took}" VerticalAlignment="Center" Margin="{DynamicResource Inset.L12}" />
                        <ProgressBar x:Name="StepProgress" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Maximum="1" Margin="{DynamicResource Inset.T4}"
                                     Value="{Binding DataContext.StepProgress, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=OneWay}"
                                     Visibility="Collapsed" AutomationProperties.Name="Progress of this step" />
                      </Grid>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                          <Setter TargetName="StepLabel" Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                          <Setter TargetName="StepLabel" Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsPending}" Value="True">
                          <Setter TargetName="StepLabel" Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
                        </DataTrigger>
                        <MultiDataTrigger>
                          <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsActive}" Value="True" />
                            <Condition Binding="{Binding IsHinted}" Value="True" />
                          </MultiDataTrigger.Conditions>
                          <Setter TargetName="StepHint" Property="Visibility" Value="Visible" />
                          <Setter TargetName="StepProgress" Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </controls:CrispBorder>

            <Button x:Name="SignInButton" Style="{DynamicResource Button.Primary}" Content="Sign in" Command="{Binding SignInCommand}" IsDefault="True" Margin="{DynamicResource Inset.T24}"
                    Height="{DynamicResource Height.ControlLarge}" FontSize="15"
                    controls:ButtonAssist.IsBusy="{Binding SignInCommand.IsRunning}" controls:ButtonAssist.BusyText="{Binding SignInBusyText}" HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Sign in" />

            <Grid Margin="{DynamicResource Inset.V22}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Rectangle Height="1" Fill="{DynamicResource Brush.Stroke}" VerticalAlignment="Center" SnapsToDevicePixels="True" />
              <TextBlock Grid.Column="1" Style="{DynamicResource Text.Caption}" Text="or" Margin="{DynamicResource Inset.H12}" />
              <Rectangle Grid.Column="2" Height="1" Fill="{DynamicResource Brush.Stroke}" VerticalAlignment="Center" SnapsToDevicePixels="True" />
            </Grid>

            <Button x:Name="DemoButton" Style="{DynamicResource Button.Secondary}" Content="Try the demo" Command="{Binding DemoCommand}" Height="{DynamicResource Height.ControlLarge}" FontSize="15"
                    controls:ButtonAssist.IsBusy="{Binding DemoCommand.IsRunning}" controls:ButtonAssist.BusyText="{Binding DemoBusyText}" HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Try the demo" />
            <TextBlock Style="{DynamicResource Text.Caption}" Margin="{DynamicResource Inset.T10}" TextAlignment="Center"
                       Text="No account needed. The demo clinic uses made-up people and resets every night." />
          </StackPanel>

          <!-- Footer: the version and whether the server is ready. -->
          <Grid Grid.Row="4" MaxWidth="416">
            <TextBlock x:Name="VersionText" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" />
            <controls:Badge x:Name="ServerPill" HorizontalAlignment="Right" Text="{Binding ServerText}" ShowDot="True" Kind="Neutral" AutomationProperties.LiveSetting="Polite" />
          </Grid>
        </Grid>
      </ScrollViewer>
    </Border>

    <!-- The Mica side: one line of context and the ABO/RhD compatibility matrix (donor rows, patient columns), drawn from the domain rule. -->
    <Grid x:Name="Hero" Grid.Column="1" Margin="{DynamicResource Pad.24}">
      <StackPanel x:Name="HeroBlock" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock x:Name="HeroOverline" Text="Red cell compatibility" FontSize="{DynamicResource FontSize.Label}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Blood}" />
        <TextBlock x:Name="HeroTitle" Style="{DynamicResource Text.Hero}" Text="Who can give to whom, at a glance." MaxWidth="330" HorizontalAlignment="Left" Margin="{DynamicResource Inset.T6B28}" />
        <Grid x:Name="Matrix" AutomationProperties.Name="Red cell compatibility: donor groups by patient groups">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Donor" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Top" Margin="{DynamicResource Inset.T70R18}">
            <TextBlock.LayoutTransform>
              <RotateTransform Angle="-90" />
            </TextBlock.LayoutTransform>
          </TextBlock>
          <StackPanel Grid.Column="1">
            <TextBlock Text="Patient" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Ink3}" Margin="{DynamicResource Inset.L62B10}" />
            <!-- Patient group headings -->
            <ItemsControl ItemsSource="{x:Static auth:LoginViewModel.PatientGroups}" Margin="{DynamicResource Inset.L62}" Focusable="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" Width="54" TextAlignment="Center" FontSize="{DynamicResource FontSize.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink2}" Margin="{DynamicResource Inset.B6}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{x:Static auth:LoginViewModel.Compatibility}" Focusable="False" ItemContainerStyle="{DynamicResource ListItem.Named}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Margin="{DynamicResource Inset.V3}">
                    <TextBlock Text="{Binding Label}" Width="56" Padding="{DynamicResource Inset.R8}" TextAlignment="Right" VerticalAlignment="Center" FontSize="{DynamicResource FontSize.Caption}" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Ink2}" />
                    <ItemsControl ItemsSource="{Binding Cells}" Focusable="False" Margin="{DynamicResource Inset.L6}" ItemContainerStyle="{DynamicResource ListItem.Named}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Width="40" Height="40" Margin="{DynamicResource Inset.H7}" AutomationProperties.Name="{Binding AutomationName}">
                            <Ellipse x:Name="Dot" Fill="{DynamicResource Brush.Blood}" Opacity="0.78" Visibility="Collapsed" />
                            <Ellipse x:Name="Ring" Stroke="{DynamicResource Brush.Stroke2}" StrokeThickness="1.5" />
                          </Grid>
                          <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding CanGive}" Value="True">
                              <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                              <Setter TargetName="Ring" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsUniversal}" Value="True">
                              <Setter TargetName="Dot" Property="Opacity" Value="1" />
                            </DataTrigger>
                          </DataTemplate.Triggers>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Grid>
        <!-- What the two reds mean: the dots of the matrix, at legend size, each with its words. -->
        <StackPanel x:Name="HeroLegend" Orientation="Horizontal" Margin="{DynamicResource Inset.T20}" AutomationProperties.Name="Legend">
          <Ellipse Width="12" Height="12" Fill="{DynamicResource Brush.Blood}" Opacity="0.78" VerticalAlignment="Center" Margin="{DynamicResource Inset.R6}" />
          <TextBlock Text="Can give" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Ink2}" VerticalAlignment="Center" Margin="{DynamicResource Inset.R16}" />
          <Ellipse Width="12" Height="12" Fill="{DynamicResource Brush.Blood}" VerticalAlignment="Center" Margin="{DynamicResource Inset.R6}" />
          <TextBlock Text="Universal: O&#x2212; gives to every group, AB+ receives from every group" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Ink2}"
                     VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock x:Name="HeroCaption" Style="{DynamicResource Text.Body}" Foreground="{DynamicResource Brush.Ink2}" MaxWidth="440" HorizontalAlignment="Left" Margin="{DynamicResource Inset.T16}"
                   Text="Lifestream checks this for you every time you fulfil a request." />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
