<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Lifestream.Desktop.Controls">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Lifestream;component/Theme/Tokens.xaml" />
    <ResourceDictionary Source="/Lifestream;component/Theme/Motion.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- Windows 11 style overlay scroll bars (direction A). The ScrollViewer template puts the content and both bars in the same grid cell, so a bar
       showing, hiding or widening never moves the layout. A bar is a 12 DIP transparent strip on the right / bottom edge of the content. At rest it
       shows only a 2 DIP thumb (ink3 at 55 %, inset 3 from the edge). With the pointer on the strip (Controls/OverlayScroll.cs sets
       OverlayScroll.IsExpanded) the well appears and the thumb widens to 6 DIP at 85 %; while dragging the thumb is ink2 at 100 %. The resting thumb is
       quiet on purpose (about 2:1); a thumb in use is not: while the pointer is on the strip, the thumb is dragged, or keyboard focus is inside the viewer
       (OverlayScroll.IsEmphasized, set with or without animations) it is ink3 at 85 % or stronger, 3:1 or more against every surface. The auto-hide
       (fade after 1.2 s idle) lives in OverlayScroll.cs and is switched on by the implicit ScrollViewer style below; with Windows animations off
       nothing fades or widens (the durations here are zero and IsExpanded is never set).
       Styles: implicit ScrollViewer (overlay + auto-hide), ScrollViewer.Plain (overlay, always visible at rest width, for small popups),
       ScrollViewer.DataGrid (the data grid's own viewer: header row above the overlaid rows, see Controls/DataGridStyles.xaml). -->

  <!-- Vertical thumb: the transparent outer Grid is the hit area (the whole strip width), Pill is the 2 DIP (6 DIP expanded) wide pill 3 DIP from the right edge. Radius 3 clamps to 1 at 2 DIP wide. Rest is the
       idle colour layer, Drag the ink2 layer that appears while dragging (a separate layer so the hover animation never fights the drag state). -->
  <Style x:Key="ScrollBar.Thumb" TargetType="Thumb">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Grid Background="Transparent">
            <Grid x:Name="Pill" HorizontalAlignment="Right" Width="{StaticResource Size.ScrollThumbRest}" Margin="0,0,3,0">
              <Border x:Name="Rest" Background="{DynamicResource Brush.Ink3}" CornerRadius="3" Opacity="0.55" />
              <Border x:Name="Strong" Background="{DynamicResource Brush.Ink3}" CornerRadius="3" Opacity="0" />
              <Border x:Name="Drag" Background="{DynamicResource Brush.Ink2}" CornerRadius="3" Opacity="0" />
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding Path=(controls:OverlayScroll.IsExpanded), RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="True">
              <DataTrigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Pill" Storyboard.TargetProperty="Width" To="{StaticResource Size.ScrollThumbHover}" Duration="{StaticResource Motion.Page}" />
                    <DoubleAnimation Storyboard.TargetName="Rest" Storyboard.TargetProperty="Opacity" To="0.85" Duration="{StaticResource Motion.Page}" />
                  </Storyboard>
                </BeginStoryboard>
              </DataTrigger.EnterActions>
              <DataTrigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Pill" Storyboard.TargetProperty="Width" To="{StaticResource Size.ScrollThumbRest}" Duration="{StaticResource Motion.Page}" />
                    <DoubleAnimation Storyboard.TargetName="Rest" Storyboard.TargetProperty="Opacity" To="0.55" Duration="{StaticResource Motion.Page}" />
                  </Storyboard>
                </BeginStoryboard>
              </DataTrigger.ExitActions>
            </DataTrigger>
            <!-- In use (pointer on the strip, dragging, keyboard focus in the viewer): the emphasised layer replaces the resting one. Set, not animated, so it
                 also holds with animations off. -->
            <DataTrigger Binding="{Binding Path=(controls:OverlayScroll.IsEmphasized), RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="True">
              <Setter TargetName="Rest" Property="Visibility" Value="Hidden" />
              <Setter TargetName="Strong" Property="Opacity" Value="0.85" />
            </DataTrigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Drag" Property="Opacity" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Horizontal thumb: the same, 3 DIP from the bottom edge, growing in height. -->
  <Style x:Key="ScrollBar.Thumb.Horizontal" TargetType="Thumb">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Grid Background="Transparent">
            <Grid x:Name="Pill" VerticalAlignment="Bottom" Height="{StaticResource Size.ScrollThumbRest}" Margin="0,0,0,3">
              <Border x:Name="Rest" Background="{DynamicResource Brush.Ink3}" CornerRadius="3" Opacity="0.55" />
              <Border x:Name="Strong" Background="{DynamicResource Brush.Ink3}" CornerRadius="3" Opacity="0" />
              <Border x:Name="Drag" Background="{DynamicResource Brush.Ink2}" CornerRadius="3" Opacity="0" />
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding Path=(controls:OverlayScroll.IsExpanded), RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="True">
              <DataTrigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Pill" Storyboard.TargetProperty="Height" To="{StaticResource Size.ScrollThumbHover}" Duration="{StaticResource Motion.Page}" />
                    <DoubleAnimation Storyboard.TargetName="Rest" Storyboard.TargetProperty="Opacity" To="0.85" Duration="{StaticResource Motion.Page}" />
                  </Storyboard>
                </BeginStoryboard>
              </DataTrigger.EnterActions>
              <DataTrigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Pill" Storyboard.TargetProperty="Height" To="{StaticResource Size.ScrollThumbRest}" Duration="{StaticResource Motion.Page}" />
                    <DoubleAnimation Storyboard.TargetName="Rest" Storyboard.TargetProperty="Opacity" To="0.55" Duration="{StaticResource Motion.Page}" />
                  </Storyboard>
                </BeginStoryboard>
              </DataTrigger.ExitActions>
            </DataTrigger>
            <!-- In use (pointer on the strip, dragging, keyboard focus in the viewer): the emphasised layer replaces the resting one. Set, not animated, so it
                 also holds with animations off. -->
            <DataTrigger Binding="{Binding Path=(controls:OverlayScroll.IsEmphasized), RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="True">
              <Setter TargetName="Rest" Property="Visibility" Value="Hidden" />
              <Setter TargetName="Strong" Property="Opacity" Value="0.85" />
            </DataTrigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Drag" Property="Opacity" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The track areas above and below the thumb: invisible, but they still take the page-up / page-down click. -->
  <Style x:Key="ScrollBar.Page" TargetType="RepeatButton">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The outer Grid is the whole 12 DIP strip with a transparent fill, so the pointer hits it (and a 2 DIP thumb can be grabbed). The well is
       the track shown while the strip is under the pointer: full strip width, radius 6, 4 DIP off the top and bottom. -->
  <ControlTemplate x:Key="ScrollBar.Vertical" TargetType="ScrollBar">
    <Grid Background="{TemplateBinding Background}">
      <Grid Margin="0,4,0,4">
        <Border x:Name="Well" Background="{DynamicResource Brush.Well}" CornerRadius="6" Opacity="0" />
        <Track x:Name="PART_Track" IsDirectionReversed="True">
          <Track.DecreaseRepeatButton>
            <RepeatButton Style="{StaticResource ScrollBar.Page}" Command="ScrollBar.PageUpCommand" />
          </Track.DecreaseRepeatButton>
          <Track.Thumb>
            <Thumb Style="{StaticResource ScrollBar.Thumb}" />
          </Track.Thumb>
          <Track.IncreaseRepeatButton>
            <RepeatButton Style="{StaticResource ScrollBar.Page}" Command="ScrollBar.PageDownCommand" />
          </Track.IncreaseRepeatButton>
        </Track>
      </Grid>
    </Grid>
    <ControlTemplate.Triggers>
        <Trigger Property="controls:OverlayScroll.IsExpanded" Value="True">
          <Trigger.EnterActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="Well" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Page}" />
              </Storyboard>
            </BeginStoryboard>
          </Trigger.EnterActions>
          <Trigger.ExitActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="Well" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Page}" />
              </Storyboard>
            </BeginStoryboard>
          </Trigger.ExitActions>
        </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="ScrollBar.Horizontal" TargetType="ScrollBar">
    <Grid Background="{TemplateBinding Background}">
      <Grid Margin="4,0,4,0">
        <Border x:Name="Well" Background="{DynamicResource Brush.Well}" CornerRadius="6" Opacity="0" />
        <Track x:Name="PART_Track">
          <Track.DecreaseRepeatButton>
            <RepeatButton Style="{StaticResource ScrollBar.Page}" Command="ScrollBar.PageLeftCommand" />
          </Track.DecreaseRepeatButton>
          <Track.Thumb>
            <Thumb Style="{StaticResource ScrollBar.Thumb.Horizontal}" />
          </Track.Thumb>
          <Track.IncreaseRepeatButton>
            <RepeatButton Style="{StaticResource ScrollBar.Page}" Command="ScrollBar.PageRightCommand" />
          </Track.IncreaseRepeatButton>
        </Track>
      </Grid>
    </Grid>
    <ControlTemplate.Triggers>
        <Trigger Property="controls:OverlayScroll.IsExpanded" Value="True">
          <Trigger.EnterActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="Well" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Page}" />
              </Storyboard>
            </BeginStoryboard>
          </Trigger.EnterActions>
          <Trigger.ExitActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="Well" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Page}" />
              </Storyboard>
            </BeginStoryboard>
          </Trigger.ExitActions>
        </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <!-- The one scroll bar, applied to every ScrollBar without a key. Never a tab stop. -->
  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Width" Value="{StaticResource Size.ScrollBar}" />
    <Setter Property="MinWidth" Value="{StaticResource Size.ScrollBar}" />
    <Setter Property="Template" Value="{StaticResource ScrollBar.Vertical}" />
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="{StaticResource Size.ScrollBar}" />
        <Setter Property="MinHeight" Value="{StaticResource Size.ScrollBar}" />
        <Setter Property="Template" Value="{StaticResource ScrollBar.Horizontal}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- The overlay ScrollViewer template: content, vertical bar (right) and horizontal bar (bottom) in one cell. Part names are the standard ones, so
       ListBox, virtualising panels (CanContentScroll) and ScrollViewer-aware code keep working. -->
  <ControlTemplate x:Key="ScrollViewer.Overlay" TargetType="ScrollViewer">
    <Grid Background="{TemplateBinding Background}">
      <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                              Margin="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              CanContentScroll="{TemplateBinding CanContentScroll}"
                              CanHorizontallyScroll="False" CanVerticallyScroll="False" />
      <ScrollBar x:Name="PART_VerticalScrollBar" HorizontalAlignment="Right" Orientation="Vertical" Cursor="Arrow"
                 Minimum="0" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                 Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                 Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                 AutomationProperties.AutomationId="VerticalScrollBar" />
      <ScrollBar x:Name="PART_HorizontalScrollBar" VerticalAlignment="Bottom" Orientation="Horizontal" Cursor="Arrow"
                 Minimum="0" Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}"
                 Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                 Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                 AutomationProperties.AutomationId="HorizontalScrollBar" />
    </Grid>
  </ControlTemplate>

  <!-- The data grid's viewer: column headers in the top row, the rows (and both bars) below. Needs DataGrid.HeadersVisibility="Column" (there is
       no select-all corner or row-header column). -->
  <ControlTemplate x:Key="ScrollViewer.DataGrid.Template" TargetType="ScrollViewer">
    <Grid Background="{TemplateBinding Background}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <DataGridColumnHeadersPresenter x:Name="PART_ColumnHeadersPresenter" Grid.Row="0"
                                      Visibility="{Binding HeadersVisibility, ConverterParameter={x:Static DataGridHeadersVisibility.Column}, Converter={x:Static DataGrid.HeadersVisibilityConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
      <Grid Grid.Row="1">
        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                CanContentScroll="{TemplateBinding CanContentScroll}"
                                CanHorizontallyScroll="False" CanVerticallyScroll="False" />
        <ScrollBar x:Name="PART_VerticalScrollBar" HorizontalAlignment="Right" Orientation="Vertical" Cursor="Arrow"
                   Minimum="0" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                   Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                   AutomationProperties.AutomationId="VerticalScrollBar" />
        <ScrollBar x:Name="PART_HorizontalScrollBar" VerticalAlignment="Bottom" Orientation="Horizontal" Cursor="Arrow"
                   Minimum="0" Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}"
                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                   Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                   AutomationProperties.AutomationId="HorizontalScrollBar" />
      </Grid>
    </Grid>
  </ControlTemplate>

  <!-- Every ScrollViewer (list boxes, dialogs, screens) without its own style: overlay bars that fade when idle. -->
  <Style TargetType="ScrollViewer">
    <Setter Property="Template" Value="{StaticResource ScrollViewer.Overlay}" />
    <Setter Property="controls:OverlayScroll.IsEnabled" Value="True" />
  </Style>

  <!-- A scrolling body inside a side panel (Controls/SidePanel marks everything in it with SidePanel.IsInside). The viewer reaches through the panel's 24 DIP
       right padding to the panel's edge and pads its content by the same 24: the content keeps its width and its 24 DIP right padding whether or not it
       scrolls, and the bar's 12 DIP strip lies in that padding, never over the content. Outside a side panel the style changes nothing. -->
  <Style x:Key="ScrollViewer.Panel" TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
    <Style.Triggers>
      <Trigger Property="controls:SidePanel.IsInside" Value="True">
        <Setter Property="Margin" Value="{StaticResource Inset.RN24}" />
        <Setter Property="Padding" Value="{StaticResource Inset.R24}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Overlay bars that never fade or widen: always visible at rest width when the content scrolls. For small popups. -->
  <Style x:Key="ScrollViewer.Plain" TargetType="ScrollViewer">
    <Setter Property="Template" Value="{StaticResource ScrollViewer.Overlay}" />
  </Style>

  <!-- For the ScrollViewer inside the DataGrid template (name it DG_ScrollViewer). -->
  <Style x:Key="ScrollViewer.DataGrid" TargetType="ScrollViewer">
    <Setter Property="Template" Value="{StaticResource ScrollViewer.DataGrid.Template}" />
    <Setter Property="controls:OverlayScroll.IsEnabled" Value="True" />
  </Style>
</ResourceDictionary>
