<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!-- Design tokens (docs/design-system.md). The ONLY place a colour literal may appear: views use these keys. Dark theme only. -->

  <!-- Surfaces -->
  <Color x:Key="Color.SurfaceCanvas">#17121A</Color>
  <Color x:Key="Color.SurfaceRaised">#221B24</Color>
  <Color x:Key="Color.SurfaceHover">#2E2530</Color>
  <Color x:Key="Color.SurfacePressed">#3A303D</Color>
  <Color x:Key="Color.SurfaceSelected">#4A1F2B</Color>
  <!-- Input fills: a touch lighter under the pointer, a touch darker while typing (the Windows 11 field behaviour) -->
  <Color x:Key="Color.SurfaceInputHover">#2A222D</Color>
  <Color x:Key="Color.SurfaceInputFocus">#1B151D</Color>
  <!-- Tinted surfaces: the tonal "Try the demo" button and the info and error bars -->
  <Color x:Key="Color.SurfaceAccent">#3A1520</Color>
  <Color x:Key="Color.SurfaceAccentHover">#4A1B29</Color>
  <Color x:Key="Color.SurfaceAccentPressed">#2E1019</Color>
  <Color x:Key="Color.SurfaceInfo">#162436</Color>
  <Color x:Key="Color.SurfaceDanger">#3A1A22</Color>
  <!-- Card and popup edges: a hairline lighter than the card so it reads against the canvas -->
  <Color x:Key="Color.BorderCard">#342A37</Color>
  <!-- The sign-in hero: brand crimson fading into the canvas -->
  <Color x:Key="Color.LogoTop">#F0475C</Color>
  <Color x:Key="Color.LogoBottom">#B3122E</Color>
  <Color x:Key="Color.HeroTop">#B0102B</Color>
  <Color x:Key="Color.HeroMid">#5A0C1F</Color>
  <Color x:Key="Color.HeroBottom">#1E1220</Color>
  <Color x:Key="Color.Scrim">#B3000000</Color>
  <Color x:Key="Color.Shadow">#000000</Color>

  <!-- Text -->
  <Color x:Key="Color.TextPrimary">#F4EFEF</Color>
  <Color x:Key="Color.TextSecondary">#C4B8BC</Color>
  <Color x:Key="Color.TextMuted">#AA9DA2</Color>
  <Color x:Key="Color.TextDisabled">#7A6E73</Color>
  <Color x:Key="Color.TextOnPrimary">#FFFFFF</Color>

  <!-- Brand and interaction -->
  <Color x:Key="Color.Primary">#C8102E</Color>
  <Color x:Key="Color.PrimaryHover">#D21C38</Color>
  <Color x:Key="Color.PrimaryPressed">#870A1F</Color>
  <Color x:Key="Color.FocusRing">#FFB4BF</Color>
  <Color x:Key="Color.BorderInput">#8C7F85</Color>
  <Color x:Key="Color.BorderSubtle">#3A303D</Color>
  <Color x:Key="Color.DangerHover">#3A1A22</Color>
  <Color x:Key="Color.DangerPressed">#4A222C</Color>

  <!-- Status -->
  <Color x:Key="Color.StatusDanger">#FF8A8A</Color>
  <Color x:Key="Color.StatusSuccess">#6EDC9A</Color>
  <Color x:Key="Color.StatusWarning">#FFC861</Color>
  <Color x:Key="Color.StatusInfo">#8EC5FF</Color>

  <!-- Scroll bars: a dark track and a thumb that is at least 3:1 against it -->
  <Color x:Key="Color.ScrollTrack">#221B24</Color>
  <Color x:Key="Color.ScrollThumb">#8C7F85</Color>
  <Color x:Key="Color.ScrollThumbHover">#B0A3A9</Color>
  <Color x:Key="Color.ScrollThumbPressed">#C4B8BC</Color>

  <!-- Skeleton (decorative) and charts -->
  <Color x:Key="Color.SkeletonBase">#2E2530</Color>
  <Color x:Key="Color.SkeletonHighlight">#3A303D</Color>
  <Color x:Key="Color.Chart1">#FF7A8A</Color>
  <Color x:Key="Color.Chart2">#7CB8FF</Color>

  <SolidColorBrush x:Key="Brush.SurfaceCanvas" Color="{StaticResource Color.SurfaceCanvas}" />
  <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="{StaticResource Color.SurfaceRaised}" />
  <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource Color.SurfaceHover}" />
  <SolidColorBrush x:Key="Brush.SurfacePressed" Color="{StaticResource Color.SurfacePressed}" />
  <SolidColorBrush x:Key="Brush.SurfaceSelected" Color="{StaticResource Color.SurfaceSelected}" />
  <SolidColorBrush x:Key="Brush.SurfaceInputHover" Color="{StaticResource Color.SurfaceInputHover}" />
  <SolidColorBrush x:Key="Brush.SurfaceInputFocus" Color="{StaticResource Color.SurfaceInputFocus}" />
  <SolidColorBrush x:Key="Brush.SurfaceAccent" Color="{StaticResource Color.SurfaceAccent}" />
  <SolidColorBrush x:Key="Brush.SurfaceAccentHover" Color="{StaticResource Color.SurfaceAccentHover}" />
  <SolidColorBrush x:Key="Brush.SurfaceAccentPressed" Color="{StaticResource Color.SurfaceAccentPressed}" />
  <SolidColorBrush x:Key="Brush.SurfaceInfo" Color="{StaticResource Color.SurfaceInfo}" />
  <SolidColorBrush x:Key="Brush.SurfaceDanger" Color="{StaticResource Color.SurfaceDanger}" />
  <SolidColorBrush x:Key="Brush.BorderCard" Color="{StaticResource Color.BorderCard}" />
  <LinearGradientBrush x:Key="Brush.Hero" StartPoint="0,0" EndPoint="0.6,1">
    <GradientStop Color="{StaticResource Color.HeroTop}" Offset="0" />
    <GradientStop Color="{StaticResource Color.HeroMid}" Offset="0.55" />
    <GradientStop Color="{StaticResource Color.HeroBottom}" Offset="1" />
  </LinearGradientBrush>
  <!-- The 1 px sheen along the top edge of a primary button -->
  <LinearGradientBrush x:Key="Brush.PrimarySheen" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#40FFFFFF" Offset="0" />
    <GradientStop Color="#00FFFFFF" Offset="0.12" />
    <GradientStop Color="#00000000" Offset="0.85" />
    <GradientStop Color="#40000000" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="Brush.Scrim" Color="{StaticResource Color.Scrim}" />
  <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
  <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
  <SolidColorBrush x:Key="Brush.TextDisabled" Color="{StaticResource Color.TextDisabled}" />
  <SolidColorBrush x:Key="Brush.TextOnPrimary" Color="{StaticResource Color.TextOnPrimary}" />
  <SolidColorBrush x:Key="Brush.Primary" Color="{StaticResource Color.Primary}" />
  <SolidColorBrush x:Key="Brush.PrimaryHover" Color="{StaticResource Color.PrimaryHover}" />
  <SolidColorBrush x:Key="Brush.PrimaryPressed" Color="{StaticResource Color.PrimaryPressed}" />
  <SolidColorBrush x:Key="Brush.FocusRing" Color="{StaticResource Color.FocusRing}" />
  <SolidColorBrush x:Key="Brush.BorderInput" Color="{StaticResource Color.BorderInput}" />
  <SolidColorBrush x:Key="Brush.BorderSubtle" Color="{StaticResource Color.BorderSubtle}" />
  <SolidColorBrush x:Key="Brush.DangerHover" Color="{StaticResource Color.DangerHover}" />
  <SolidColorBrush x:Key="Brush.DangerPressed" Color="{StaticResource Color.DangerPressed}" />
  <SolidColorBrush x:Key="Brush.StatusDanger" Color="{StaticResource Color.StatusDanger}" />
  <SolidColorBrush x:Key="Brush.StatusSuccess" Color="{StaticResource Color.StatusSuccess}" />
  <SolidColorBrush x:Key="Brush.StatusWarning" Color="{StaticResource Color.StatusWarning}" />
  <SolidColorBrush x:Key="Brush.StatusInfo" Color="{StaticResource Color.StatusInfo}" />
  <SolidColorBrush x:Key="Brush.ScrollTrack" Color="{StaticResource Color.ScrollTrack}" />
  <SolidColorBrush x:Key="Brush.ScrollThumb" Color="{StaticResource Color.ScrollThumb}" />
  <SolidColorBrush x:Key="Brush.ScrollThumbHover" Color="{StaticResource Color.ScrollThumbHover}" />
  <SolidColorBrush x:Key="Brush.ScrollThumbPressed" Color="{StaticResource Color.ScrollThumbPressed}" />
  <SolidColorBrush x:Key="Brush.SkeletonBase" Color="{StaticResource Color.SkeletonBase}" />
  <SolidColorBrush x:Key="Brush.Chart1" Color="{StaticResource Color.Chart1}" />
  <SolidColorBrush x:Key="Brush.Chart2" Color="{StaticResource Color.Chart2}" />

  <!-- Spacing: 4-DIP base -->
  <sys:Double x:Key="Space.4">4</sys:Double>
  <sys:Double x:Key="Space.8">8</sys:Double>
  <sys:Double x:Key="Space.12">12</sys:Double>
  <sys:Double x:Key="Space.16">16</sys:Double>
  <sys:Double x:Key="Space.24">24</sys:Double>
  <sys:Double x:Key="Space.32">32</sys:Double>
  <sys:Double x:Key="Space.48">48</sys:Double>
  <!-- The gap between the two bars of a month on the dashboard chart (a charting-library setting, in pixels) -->
  <sys:Double x:Key="Chart.BarGap">2</sys:Double>
  <!-- The printed receipt: paper margins and the small gaps of its table, in print units -->
  <Thickness x:Key="Print.Page">48</Thickness>
  <Thickness x:Key="Print.B2">0,0,0,2</Thickness>
  <Thickness x:Key="Print.B1">0,0,0,1</Thickness>
  <Thickness x:Key="Print.CellLabel">0,4,8,4</Thickness>
  <Thickness x:Key="Print.CellValue">0,4,0,4</Thickness>
  <Thickness x:Key="Pad.4">4</Thickness>
  <Thickness x:Key="Pad.8">8</Thickness>
  <Thickness x:Key="Pad.12">12</Thickness>
  <Thickness x:Key="Pad.16">16</Thickness>
  <Thickness x:Key="Pad.24">24</Thickness>
  <Thickness x:Key="Pad.32">32</Thickness>
  <Thickness x:Key="Pad.48">48</Thickness>
  <Thickness x:Key="Inset.T4B24">0,4,0,24</Thickness>
  <Thickness x:Key="Inset.V24">0,24,0,24</Thickness>
  <Thickness x:Key="Pad.Page">24</Thickness>
  <Thickness x:Key="Gap.Field">0,0,0,16</Thickness>

  <!-- Insets and radii used by the views: the name says which sides (H = left and right, V = top and bottom, L T R B = one side) -->
  <Thickness x:Key="Inset.B16">0,0,0,16</Thickness>
  <Thickness x:Key="Inset.B24">0,0,0,24</Thickness>
  <Thickness x:Key="Inset.R16B16">0,0,16,16</Thickness>
  <Thickness x:Key="Inset.R24B24">0,0,24,24</Thickness>
  <Thickness x:Key="Inset.T44">0,44,0,0</Thickness>
  <Thickness x:Key="Chrome.ResizeBorder">6</Thickness>
  <Thickness x:Key="Chrome.GlassFrame">0,0,0,1</Thickness>
  <sys:Double x:Key="Chrome.MaximizedTopOffset">1</sys:Double>
  <CornerRadius x:Key="Radius.Avatar">36</CornerRadius>
  <CornerRadius x:Key="Radius.AvatarLarge">48</CornerRadius>
  <Thickness x:Key="Inset.B12">0,0,0,12</Thickness>
  <Thickness x:Key="Inset.B4">0,0,0,4</Thickness>
  <Thickness x:Key="Inset.L24">24,0,0,0</Thickness>
  <Thickness x:Key="Inset.V4">0,4,0,4</Thickness>
  <Thickness x:Key="Inset.H1">1,0,1,0</Thickness>
  <Thickness x:Key="Inset.L2">2,0,0,0</Thickness>
  <Thickness x:Key="Pad.1">1</Thickness>
  <!-- A popup's offset from its field plus room for its shadow -->
  <Thickness x:Key="Inset.Popup">8,4,8,16</Thickness>
  <Thickness x:Key="Inset.H12">12,0,12,0</Thickness>
  <Thickness x:Key="Inset.H12V16">12,16,12,16</Thickness>
  <Thickness x:Key="Inset.H12V4">12,4,12,4</Thickness>
  <Thickness x:Key="Inset.H12V6">12,6,12,6</Thickness>
  <Thickness x:Key="Inset.H12V8">12,8,12,8</Thickness>
  <Thickness x:Key="Inset.H16">16,0,16,0</Thickness>
  <Thickness x:Key="Inset.H16V12">16,12,16,12</Thickness>
  <Thickness x:Key="Inset.H16V8">16,8,16,8</Thickness>
  <Thickness x:Key="Inset.H8">8,0,8,0</Thickness>
  <Thickness x:Key="Inset.H8V4">8,4,8,4</Thickness>
  <Thickness x:Key="Inset.L12">12,0,0,0</Thickness>
  <Thickness x:Key="Inset.L12R36">12,0,36,0</Thickness>
  <Thickness x:Key="Inset.L12R4">12,0,4,0</Thickness>
  <Thickness x:Key="Inset.L12R44">12,0,44,0</Thickness>
  <Thickness x:Key="Inset.L12R48">12,0,48,0</Thickness>
  <Thickness x:Key="Inset.L12T8R4B8">12,8,4,8</Thickness>
  <Thickness x:Key="Inset.L13R36">13,0,36,0</Thickness>
  <Thickness x:Key="Inset.L20T16R12B4">20,16,12,4</Thickness>
  <Thickness x:Key="Inset.L20T16R20B8">20,16,20,8</Thickness>
  <Thickness x:Key="Inset.L24R16">24,0,16,0</Thickness>
  <Thickness x:Key="Inset.L24R24B24">24,0,24,24</Thickness>
  <Thickness x:Key="Inset.L24R24B8">24,0,24,8</Thickness>
  <Thickness x:Key="Inset.L24T16R24B24">24,16,24,24</Thickness>
  <Thickness x:Key="Inset.L4R8">4,0,8,0</Thickness>
  <Thickness x:Key="Inset.L8">8,0,0,0</Thickness>
  <Thickness x:Key="Inset.L8R8B2">8,0,8,2</Thickness>
  <Thickness x:Key="Inset.Neg3">-3</Thickness>
  <Thickness x:Key="Inset.Neg4">-4</Thickness>
  <Thickness x:Key="Inset.R12">0,0,12,0</Thickness>
  <Thickness x:Key="Inset.R16">0,0,16,0</Thickness>
  <Thickness x:Key="Inset.R4">0,0,4,0</Thickness>
  <Thickness x:Key="Inset.R6">0,0,6,0</Thickness>
  <Thickness x:Key="Inset.R8">0,0,8,0</Thickness>
  <Thickness x:Key="Inset.T12">0,12,0,0</Thickness>
  <Thickness x:Key="Inset.T16">0,16,0,0</Thickness>
  <Thickness x:Key="Inset.T24">0,24,0,0</Thickness>
  <Thickness x:Key="Inset.T2R10">0,2,10,0</Thickness>
  <Thickness x:Key="Inset.T2R6">0,2,6,0</Thickness>
  <Thickness x:Key="Inset.T4">0,4,0,0</Thickness>
  <Thickness x:Key="Inset.T4B32">0,4,0,32</Thickness>
  <Thickness x:Key="Inset.T4B8">0,4,0,8</Thickness>
  <Thickness x:Key="Inset.T8">0,8,0,0</Thickness>
  <Thickness x:Key="Inset.V12">0,12,0,12</Thickness>
  <Thickness x:Key="Inset.V32">0,32,0,32</Thickness>
  <CornerRadius x:Key="Radius.14">14</CornerRadius>
  <CornerRadius x:Key="Radius.2">2</CornerRadius>
  <CornerRadius x:Key="Radius.6">6</CornerRadius>
  <CornerRadius x:Key="Radius.Left8">12,0,0,12</CornerRadius>

  <!-- Motion, in milliseconds: 100 to 150 for hover and press, 150 to 200 for drawers and dialogs, a 1.2 s skeleton shimmer and a 0.9 s
       spinner turn. Theme/Motion.xaml turns them into the Duration resources the templates use (all zero when Windows "Animation effects" is off). -->
  <sys:Double x:Key="Motion.Fast.Milliseconds">120</sys:Double>
  <sys:Double x:Key="Motion.Standard.Milliseconds">180</sys:Double>
  <sys:Double x:Key="Motion.Shimmer.Milliseconds">1200</sys:Double>
  <sys:Double x:Key="Motion.SpinnerTurn.Milliseconds">900</sys:Double>

  <!-- Insets and radii used by the views: the name says which sides (H = left and right, V = top and bottom, L T R B = one side) -->

  <!-- Sizes -->
  <sys:Double x:Key="Height.Compact">32</sys:Double>
  <sys:Double x:Key="Height.Control">40</sys:Double>
  <sys:Double x:Key="Height.Row">40</sys:Double>
  <sys:Double x:Key="Width.CaptionButton">46</sys:Double>
  <sys:Double x:Key="Height.CaptionButton">32</sys:Double>
  <sys:Double x:Key="Width.Sidebar">232</sys:Double>
  <GridLength x:Key="Grid.Width.Sidebar">232</GridLength>
  <GridLength x:Key="Grid.Height.Caption">32</GridLength>
  <sys:Double x:Key="Size.FocusRing">2</sys:Double>
  <sys:Double x:Key="Size.ScrollBar">12</sys:Double>
  <Thickness x:Key="Pad.ScrollThumb">2</Thickness>
  <Thickness x:Key="Thickness.FocusRing">2</Thickness>

  <!-- Radii -->
  <CornerRadius x:Key="Radius.Control">8</CornerRadius>
  <CornerRadius x:Key="Radius.Card">12</CornerRadius>
  <!-- The keyboard focus ring sits 4 DIP outside a control, so its radius is the control's plus 4 -->
  <CornerRadius x:Key="Radius.FocusRing">12</CornerRadius>
  <!-- The bottom accent line of a focused input follows the field's rounded bottom corners -->
  <CornerRadius x:Key="Radius.Underline">0,0,8,8</CornerRadius>
  <CornerRadius x:Key="Radius.Pill">12</CornerRadius>
</ResourceDictionary>
