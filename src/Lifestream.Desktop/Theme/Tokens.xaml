<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!-- Shared design tokens of direction A, "Ward" (docs/design-system.md): spacing, sizes, radii, elevation and motion. Colours live in
       Colors.Light.xaml and Colors.Dark.xaml (swapped at runtime by ThemeService); type lives in Typography.xaml. No colour literal here. -->

  <!-- Spacing: 4-DIP base -->
  <sys:Double x:Key="Space.4">4</sys:Double>
  <sys:Double x:Key="Space.8">8</sys:Double>
  <sys:Double x:Key="Space.12">12</sys:Double>
  <sys:Double x:Key="Space.16">16</sys:Double>
  <sys:Double x:Key="Space.20">20</sys:Double>
  <sys:Double x:Key="Space.24">24</sys:Double>
  <sys:Double x:Key="Space.32">32</sys:Double>
  <sys:Double x:Key="Space.48">48</sys:Double>
  <!-- The gap between the two bars of a month on the dashboard chart (a charting-library setting, in pixels) -->
  <sys:Double x:Key="Chart.BarGap">2</sys:Double>
  <!-- The printed receipt: paper margins and the small gaps of its table, in print units -->
  <Thickness x:Key="Print.Page">48</Thickness>
  <Thickness x:Key="Print.B2">0,0,0,2</Thickness>
  <Thickness x:Key="Print.B1">0,0,0,1</Thickness>
  <Thickness x:Key="Print.CellLabel">0,4,8,4</Thickness>
  <Thickness x:Key="Print.CellValue">0,4,0,4</Thickness>
  <Thickness x:Key="Pad.4">4</Thickness>
  <Thickness x:Key="Pad.8">8</Thickness>
  <Thickness x:Key="Pad.12">12</Thickness>
  <Thickness x:Key="Pad.16">16</Thickness>
  <Thickness x:Key="Pad.20">20</Thickness>
  <Thickness x:Key="Pad.24">24</Thickness>
  <Thickness x:Key="Pad.32">32</Thickness>
  <Thickness x:Key="Pad.48">48</Thickness>
  <Thickness x:Key="Inset.T4B24">0,4,0,24</Thickness>
  <Thickness x:Key="Inset.V24">0,24,0,24</Thickness>
  <Thickness x:Key="Pad.Page">24</Thickness>
  <Thickness x:Key="Gap.Field">0,0,0,16</Thickness>

  <!-- Insets and radii used by the views: the name says which sides (H = left and right, V = top and bottom, L T R B = one side) -->
  <Thickness x:Key="Inset.B16">0,0,0,16</Thickness>
  <Thickness x:Key="Inset.B24">0,0,0,24</Thickness>
  <Thickness x:Key="Inset.R16B16">0,0,16,16</Thickness>
  <Thickness x:Key="Inset.R24B24">0,0,24,24</Thickness>
  <Thickness x:Key="Inset.T44">0,44,0,0</Thickness>
  <Thickness x:Key="Chrome.ResizeBorder">6</Thickness>
  <Thickness x:Key="Chrome.GlassFrame">0,0,0,1</Thickness>
  <sys:Double x:Key="Chrome.MaximizedTopOffset">1</sys:Double>
  <CornerRadius x:Key="Radius.Avatar">36</CornerRadius>
  <CornerRadius x:Key="Radius.AvatarLarge">48</CornerRadius>
  <Thickness x:Key="Inset.B12">0,0,0,12</Thickness>
  <Thickness x:Key="Inset.B4">0,0,0,4</Thickness>
  <Thickness x:Key="Inset.L24">24,0,0,0</Thickness>
  <Thickness x:Key="Inset.V4">0,4,0,4</Thickness>
  <Thickness x:Key="Inset.H1">1,0,1,0</Thickness>
  <Thickness x:Key="Inset.L2">2,0,0,0</Thickness>
  <Thickness x:Key="Pad.1">1</Thickness>
  <!-- A popup's offset from its field plus room for its shadow -->
  <Thickness x:Key="Inset.Popup">8,4,8,16</Thickness>
  <Thickness x:Key="Inset.H12">12,0,12,0</Thickness>
  <Thickness x:Key="Inset.H12V16">12,16,12,16</Thickness>
  <Thickness x:Key="Inset.H12V4">12,4,12,4</Thickness>
  <Thickness x:Key="Inset.H12V6">12,6,12,6</Thickness>
  <Thickness x:Key="Inset.H12V8">12,8,12,8</Thickness>
  <Thickness x:Key="Inset.H16">16,0,16,0</Thickness>
  <Thickness x:Key="Inset.H16V12">16,12,16,12</Thickness>
  <Thickness x:Key="Inset.H16V8">16,8,16,8</Thickness>
  <Thickness x:Key="Inset.H8">8,0,8,0</Thickness>
  <Thickness x:Key="Inset.H8V4">8,4,8,4</Thickness>
  <Thickness x:Key="Inset.L12">12,0,0,0</Thickness>
  <Thickness x:Key="Inset.L12R36">12,0,36,0</Thickness>
  <Thickness x:Key="Inset.L12R4">12,0,4,0</Thickness>
  <Thickness x:Key="Inset.L12R44">12,0,44,0</Thickness>
  <Thickness x:Key="Inset.L12R48">12,0,48,0</Thickness>
  <Thickness x:Key="Inset.L12T8R4B8">12,8,4,8</Thickness>
  <Thickness x:Key="Inset.L13R36">13,0,36,0</Thickness>
  <Thickness x:Key="Inset.L20T16R12B4">20,16,12,4</Thickness>
  <Thickness x:Key="Inset.L20T16R20B8">20,16,20,8</Thickness>
  <Thickness x:Key="Inset.L24R16">24,0,16,0</Thickness>
  <Thickness x:Key="Inset.L24R24B24">24,0,24,24</Thickness>
  <Thickness x:Key="Inset.L24R24B8">24,0,24,8</Thickness>
  <Thickness x:Key="Inset.L24T16R24B24">24,16,24,24</Thickness>
  <Thickness x:Key="Inset.L4R8">4,0,8,0</Thickness>
  <Thickness x:Key="Inset.L8">8,0,0,0</Thickness>
  <Thickness x:Key="Inset.L8R8B2">8,0,8,2</Thickness>
  <Thickness x:Key="Inset.Neg3">-3</Thickness>
  <Thickness x:Key="Inset.Neg4">-4</Thickness>
  <Thickness x:Key="Inset.R12">0,0,12,0</Thickness>
  <Thickness x:Key="Inset.R16">0,0,16,0</Thickness>
  <Thickness x:Key="Inset.R4">0,0,4,0</Thickness>
  <Thickness x:Key="Inset.R6">0,0,6,0</Thickness>
  <Thickness x:Key="Inset.R8">0,0,8,0</Thickness>
  <Thickness x:Key="Inset.T12">0,12,0,0</Thickness>
  <Thickness x:Key="Inset.T16">0,16,0,0</Thickness>
  <Thickness x:Key="Inset.T24">0,24,0,0</Thickness>
  <Thickness x:Key="Inset.T2R10">0,2,10,0</Thickness>
  <Thickness x:Key="Inset.T2R6">0,2,6,0</Thickness>
  <Thickness x:Key="Inset.T4">0,4,0,0</Thickness>
  <Thickness x:Key="Inset.T4B32">0,4,0,32</Thickness>
  <Thickness x:Key="Inset.T4B8">0,4,0,8</Thickness>
  <Thickness x:Key="Inset.T8">0,8,0,0</Thickness>
  <Thickness x:Key="Inset.V12">0,12,0,12</Thickness>
  <Thickness x:Key="Inset.V32">0,32,0,32</Thickness>
  <CornerRadius x:Key="Radius.14">14</CornerRadius>
  <CornerRadius x:Key="Radius.2">2</CornerRadius>
  <CornerRadius x:Key="Radius.6">6</CornerRadius>
  <CornerRadius x:Key="Radius.Left8">12,0,0,12</CornerRadius>

  <!-- Motion, in milliseconds (docs/design-system.md, "Motion"): 100 for hover and press, 120 for a page cross-fade and the scrollbar widening,
       180 for dialogs and the palette, 200 to open a side panel and 150 to close it, a 1.4 s skeleton shimmer, a 0.9 s spinner turn, and 1.2 s
       before an idle scrollbar fades. Theme/Motion.xaml turns them into the Duration resources the templates use (all zero when Windows
       "Animation effects" is off). -->
  <sys:Double x:Key="Motion.Fast.Milliseconds">100</sys:Double>
  <sys:Double x:Key="Motion.Page.Milliseconds">120</sys:Double>
  <sys:Double x:Key="Motion.Standard.Milliseconds">180</sys:Double>
  <sys:Double x:Key="Motion.PanelOpen.Milliseconds">200</sys:Double>
  <sys:Double x:Key="Motion.PanelClose.Milliseconds">150</sys:Double>
  <sys:Double x:Key="Motion.Shimmer.Milliseconds">1400</sys:Double>
  <sys:Double x:Key="Motion.SpinnerTurn.Milliseconds">900</sys:Double>
  <sys:Double x:Key="Motion.ScrollIdle.Milliseconds">1200</sys:Double>
  <!-- Easing: decelerate into place when something opens, accelerate away when it closes -->
  <CubicEase x:Key="Ease.Decelerate" EasingMode="EaseOut" />
  <CubicEase x:Key="Ease.Accelerate" EasingMode="EaseIn" />
  <sys:Double x:Key="Motion.SlideDistance">24</sys:Double>
  <sys:Double x:Key="Motion.ToastRise">12</sys:Double>
  <sys:Double x:Key="Motion.DialogScaleFrom">0.98</sys:Double>

  <!-- Sizes (DIP): controls 34 (compact 28), table rows 44 (compact 34), table header 38, title bar 44 (40 in a compact window),
       caption buttons 46 wide, the sidebar 236 (52 as a rail), the side panel 420 (352 compact), the command palette 640. -->
  <sys:Double x:Key="Height.Compact">28</sys:Double>
  <sys:Double x:Key="Height.Control">34</sys:Double>
  <sys:Double x:Key="Height.ControlLarge">40</sys:Double>
  <sys:Double x:Key="Height.Row">44</sys:Double>
  <sys:Double x:Key="Height.RowCompact">34</sys:Double>
  <sys:Double x:Key="Height.HeaderRow">38</sys:Double>
  <sys:Double x:Key="Height.NavItem">36</sys:Double>
  <sys:Double x:Key="Height.Badge">22</sys:Double>
  <sys:Double x:Key="Height.TitleBar">44</sys:Double>
  <sys:Double x:Key="Height.TitleBarCompact">40</sys:Double>
  <sys:Double x:Key="Width.CaptionButton">46</sys:Double>
  <sys:Double x:Key="Height.CaptionButton">44</sys:Double>
  <sys:Double x:Key="Width.Sidebar">236</sys:Double>
  <sys:Double x:Key="Width.Rail">52</sys:Double>
  <sys:Double x:Key="Width.Panel">420</sys:Double>
  <sys:Double x:Key="Width.PanelCompact">352</sys:Double>
  <sys:Double x:Key="Width.Palette">640</sys:Double>
  <sys:Double x:Key="Width.TitleSearch">440</sys:Double>
  <sys:Double x:Key="Width.Dialog">480</sys:Double>
  <sys:Double x:Key="MaxWidth.Dashboard">1600</sys:Double>
  <sys:Double x:Key="MaxWidth.Form">720</sys:Double>
  <sys:Double x:Key="MaxWidth.Settings">960</sys:Double>
  <GridLength x:Key="Grid.Width.Sidebar">236</GridLength>
  <GridLength x:Key="Grid.Height.Caption">44</GridLength>
  <sys:Double x:Key="Size.FocusRing">2</sys:Double>
  <sys:Double x:Key="Size.Icon">18</sys:Double>
  <sys:Double x:Key="Size.IconSmall">16</sys:Double>
  <sys:Double x:Key="Size.Avatar">32</sys:Double>
  <!-- Overlay scrollbar: a 2 DIP thumb at rest, 6 DIP on a 12 DIP track under the pointer -->
  <sys:Double x:Key="Size.ScrollBar">12</sys:Double>
  <sys:Double x:Key="Size.ScrollThumbRest">2</sys:Double>
  <sys:Double x:Key="Size.ScrollThumbHover">6</sys:Double>
  <Thickness x:Key="Pad.ScrollThumb">2</Thickness>
  <Thickness x:Key="Thickness.FocusRing">2</Thickness>
  <!-- Breakpoints (window width, DIP): Compact below 1280, Standard 1280 to 1599, Wide from 1600 -->
  <sys:Double x:Key="Breakpoint.Standard">1280</sys:Double>
  <sys:Double x:Key="Breakpoint.Wide">1600</sys:Double>
  <!-- Page layout: 32 DIP side padding (24 compact), 24 on top, 20 between panels -->
  <Thickness x:Key="Pad.PageA">32,24,32,24</Thickness>
  <Thickness x:Key="Pad.PageCompact">22,18,16,16</Thickness>
  <Thickness x:Key="Pad.PanelHeader">18,14,18,10</Thickness>
  <Thickness x:Key="Pad.PanelBody">18,0,18,14</Thickness>
  <Thickness x:Key="Pad.Button">14,0,14,0</Thickness>
  <Thickness x:Key="Pad.ButtonSmall">10,0,10,0</Thickness>
  <Thickness x:Key="Pad.Field">10,0,10,0</Thickness>
  <Thickness x:Key="Pad.Badge">8,0,8,0</Thickness>
  <Thickness x:Key="Gap.Panels">0,20,0,0</Thickness>

  <!-- Radii: 4 badges and checkboxes, 6 buttons and fields, 8 panels and menus, 12 dialogs. All whole numbers (crisp at every scale). -->
  <CornerRadius x:Key="Radius.Small">4</CornerRadius>
  <CornerRadius x:Key="Radius.Control">6</CornerRadius>
  <CornerRadius x:Key="Radius.Panel">8</CornerRadius>
  <CornerRadius x:Key="Radius.Dialog">12</CornerRadius>
  <CornerRadius x:Key="Radius.Card">8</CornerRadius>
  <!-- The content area's rounded top-left corner where it meets the sidebar and the title bar -->
  <CornerRadius x:Key="Radius.ContentCorner">8,0,0,0</CornerRadius>
  <!-- The keyboard focus ring sits 4 DIP outside a control (2 offset + 2 ring), so its radius is the control's plus 4 -->
  <CornerRadius x:Key="Radius.FocusRing">10</CornerRadius>
  <!-- The bottom accent line of a focused input follows the field's rounded bottom corners -->
  <CornerRadius x:Key="Radius.Underline">0,0,6,6</CornerRadius>
  <CornerRadius x:Key="Radius.Pill">4</CornerRadius>
  <CornerRadius x:Key="Radius.Round">999</CornerRadius>

  <!-- Elevation (docs/design-system.md, "Elevation"). Panels are flat with a 1 DIP stroke. Menus, flyouts and toasts: 0 8 16 at 14 %;
       dialogs and the palette: 0 32 64 at 22 % over a 40 % scrim; the side panel: a soft left edge. A shadow is only ever drawn by a separate
       element BEHIND the content (controls:Elevation), never by an effect on an element that contains text. -->
  <sys:Double x:Key="Elevation.Flyout.Blur">16</sys:Double>
  <sys:Double x:Key="Elevation.Flyout.Offset">8</sys:Double>
  <sys:Double x:Key="Elevation.Flyout.Opacity">0.14</sys:Double>
  <sys:Double x:Key="Elevation.Dialog.Blur">64</sys:Double>
  <sys:Double x:Key="Elevation.Dialog.Offset">32</sys:Double>
  <sys:Double x:Key="Elevation.Dialog.Opacity">0.22</sys:Double>
  <sys:Double x:Key="Elevation.Panel.Blur">24</sys:Double>
  <sys:Double x:Key="Elevation.Panel.Opacity">0.10</sys:Double>
</ResourceDictionary>
