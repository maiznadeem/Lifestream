<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Vector artwork shared by the whole app. There are no raster images in the build (SHELL-43). Artwork with colour follows the theme, so it
       lives with the colours: the default avatar is Image.DefaultAvatar in Colors.Light.xaml / Colors.Dark.xaml, and the app mark is the
       controls:LogoMark control (Controls/LogoMark.cs, Controls/Surfaces.xaml). The geometry below is the mark of direction A, in a 32 x 32 grid:
       a blood drop with a white stream wave across its belly (the same shape as the app icon, tools/generate-icons.ps1). -->
  <Geometry x:Key="Geometry.LogoDrop">M16,2.5 C16,2.5 6.2,13.2 6.2,19.6 A9.8,9.8 0 0 0 25.8,19.6 C25.8,13.2 16,2.5 16,2.5 Z</Geometry>
  <Geometry x:Key="Geometry.LogoWave">M10.6,20.4 C12.4,18.8 14.2,18.8 16,20.4 C17.8,22 19.6,22 21.4,20.4</Geometry>
</ResourceDictionary>
