<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Lifestream;component/Theme/Tokens.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- Vector images shared by the whole app. They are frozen and loaded once, so nothing is decoded or copied per use.
       There are no raster images in the build (SHELL-43), so nothing can exceed the 50 KB limit. -->
  <DrawingImage x:Key="Image.DefaultAvatar" po:Freeze="True">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="{StaticResource Brush.SurfacePressed}">
          <GeometryDrawing.Geometry>
            <EllipseGeometry Center="16,16" RadiusX="16" RadiusY="16" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="{StaticResource Brush.TextSecondary}">
          <GeometryDrawing.Geometry>
            <EllipseGeometry Center="16,12.5" RadiusX="5.5" RadiusY="5.5" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="{StaticResource Brush.TextSecondary}" Geometry="M 6,27 C 7,21 11,19 16,19 C 21,19 25,21 26,27 A 16,16 0 0 1 6,27 Z" />
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- The app mark (the same geometry as the app icon, tools/generate-icons.ps1): a gradient blood drop with a heart in its belly. Used on the
       sign-in screen, the sidebar and the caption bar; the wordmark next to it is live text. -->
  <LinearGradientBrush x:Key="Brush.LogoDrop" StartPoint="0.2,0" EndPoint="0.8,1" po:Freeze="True">
    <GradientStop Color="{StaticResource Color.LogoTop}" Offset="0" />
    <GradientStop Color="{StaticResource Color.LogoBottom}" Offset="1" />
  </LinearGradientBrush>
  <DrawingImage x:Key="Image.Logo" po:Freeze="True">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="{StaticResource Brush.LogoDrop}" Geometry="M128,14 C128,14 40,108 40,166 A88,88 0 0 0 216,166 C216,108 128,14 128,14 Z" />
        <GeometryDrawing Brush="{StaticResource Brush.TextOnPrimary}"
                         Geometry="M128,200 C100,180 90,166 90,152 C90,140 99,132 109,132 C117,132 124,136 128,144 C132,136 139,132 147,132 C157,132 166,140 166,152 C166,166 156,180 128,200 Z" />
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- The mark for 20 DIP and smaller (the caption bar): the drop alone, as the small icon frames have it. -->
  <DrawingImage x:Key="Image.LogoSmall" po:Freeze="True">
    <DrawingImage.Drawing>
      <GeometryDrawing Brush="{StaticResource Brush.LogoDrop}" Geometry="M128,14 C128,14 40,108 40,166 A88,88 0 0 0 216,166 C216,108 128,14 128,14 Z" />
    </DrawingImage.Drawing>
  </DrawingImage>
</ResourceDictionary>
