<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!-- One family, Google Sans Flex (SIL Open Font License), bundled in the executable as static TrueType files hinted with ttfautohint
       (Fonts/README.md, tools/fonts/build-google-sans-flex.py) at 400, 500, 600 and 700, all cut at one optical size so a heading and a caption are
       the same design. The ramp of direction A (docs/design-system.md, "Type"):
         Display 32/40 SemiBold   the sign-in heading            Title 28/36 SemiBold    page titles
         Section 20/28 SemiBold   panel titles in side panels    Heading 15/22 SemiBold  panel headings
         Body 14/20               text and data                  Label 13/18 Medium      field labels, secondary lines
         Caption 12/16            hints, counts, axis labels
       How the text is drawn (whole-pixel Display formatting, grayscale, no kerning) is the same for every size and every part of a window; it is
       set once, on each window, by Theme/TextDefaults.cs, and no style or view may set its own. Nothing below 12 DIP. Figures are proportional in
       prose; right-aligned numeric columns opt into tabular figures (Text.Numeric). Colours are DynamicResource: the theme switches at runtime. -->
  <FontFamily x:Key="Font.Family">pack://application:,,,/Lifestream;component/Fonts/#Google Sans Flex</FontFamily>
  <!-- Kept for code written against 2.0: the same family and the same files (there is no separate display cut). -->
  <FontFamily x:Key="Font.Display">pack://application:,,,/Lifestream;component/Fonts/#Google Sans Flex</FontFamily>
  <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <sys:Double x:Key="FontSize.Hero">34</sys:Double>
  <sys:Double x:Key="FontSize.Display">32</sys:Double>
  <sys:Double x:Key="FontSize.Title">28</sys:Double>
  <sys:Double x:Key="FontSize.Section">20</sys:Double>
  <sys:Double x:Key="FontSize.Heading">15</sys:Double>
  <sys:Double x:Key="FontSize.Body">14</sys:Double>
  <sys:Double x:Key="FontSize.Label">13</sys:Double>
  <sys:Double x:Key="FontSize.Caption">12</sys:Double>
  <sys:Double x:Key="FontSize.Kbd">11</sys:Double>
  <sys:Double x:Key="FontSize.Icon">16</sys:Double>

  <sys:Double x:Key="LineHeight.Hero">42</sys:Double>
  <sys:Double x:Key="LineHeight.Display">40</sys:Double>
  <sys:Double x:Key="LineHeight.Title">36</sys:Double>
  <sys:Double x:Key="LineHeight.Section">28</sys:Double>
  <sys:Double x:Key="LineHeight.Heading">22</sys:Double>
  <sys:Double x:Key="LineHeight.Body">20</sys:Double>
  <sys:Double x:Key="LineHeight.Label">18</sys:Double>
  <sys:Double x:Key="LineHeight.Caption">16</sys:Double>

  <Style x:Key="Text.Base" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Typography.NumeralAlignment" Value="Proportional" />
  </Style>
  <Style x:Key="Text.Hero" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Hero}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeight.Hero}" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="Text.Display" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Display}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeight.Display}" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="Text.Title" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Title}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeight.Title}" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="Text.Section" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Section}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeight.Section}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="Text.Heading" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Heading}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeight.Heading}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="Text.Body" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeight.Body}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style x:Key="Text.BodyStrong" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="Text.Secondary" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Label}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeight.Label}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
  </Style>
  <Style x:Key="Text.Label" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Label}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeight.Label}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
  </Style>
  <Style x:Key="Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeight.Caption}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
  </Style>
  <!-- A number in a right-aligned column: tabular figures so the digits line up. -->
  <Style x:Key="Text.Numeric" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>
  <Style x:Key="Text.Icon" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Icons}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Icon}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>
</ResourceDictionary>
