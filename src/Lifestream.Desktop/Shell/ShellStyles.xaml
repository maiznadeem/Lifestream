<ResourceDictionary xmlns:controls="clr-namespace:Lifestream.Desktop.Controls" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:assist="clr-namespace:Lifestream.Desktop.Controls">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Lifestream;component/Theme/Tokens.xaml" />
    <ResourceDictionary Source="/Lifestream;component/Theme/Motion.xaml" />
    <ResourceDictionary Source="/Lifestream;component/Theme/Typography.xaml" />
    <ResourceDictionary Source="/Lifestream;component/Controls/Buttons.xaml" />
    <ResourceDictionary Source="/Lifestream;component/Controls/Inputs.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- Sidebar destination (direction A): 36 DIP tall, radius 6, the icon then the title, a count at the right. Selected: the light layer on Mica,
       SemiBold, the icon's filled variant and a 3 DIP blood bar at the left edge. The bar and padding are always there (transparent when not
       selected), so hover and selection change colour only and nothing shifts (SHELL-27). A RadioButton gives UI Automation a selected state.
       Content is the title; Tag is the IconKind; the count comes from the NavItem (DataContext). -->
  <Style x:Key="NavItem" TargetType="RadioButton">
    <Setter Property="GroupName" Value="Navigation" />
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="Height" Value="{StaticResource Height.NavItem}" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" />
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="MouseOver">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" />
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" />
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Disabled" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="HoverLayer" Opacity="0" CornerRadius="{StaticResource Radius.Control}" Background="{DynamicResource Brush.CaptionPressed}" />
            <assist:CrispBorder x:Name="Selected" Opacity="0" CornerRadius="{StaticResource Radius.Control}" Background="{DynamicResource Brush.NavActive}" BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1" />
            <Border x:Name="Bar" Width="3" HorizontalAlignment="Left" Margin="0,10,0,10" CornerRadius="2" Background="Transparent" />
            <Grid Margin="12,0,12,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <controls:Icon x:Name="Glyph" Kind="{Binding Icon}" Size="18" VerticalAlignment="Center" Margin="0,0,12,0" />
              <ContentPresenter x:Name="Label" Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="False" TextElement.FontWeight="Normal" />
              <TextBlock x:Name="Count" Grid.Column="2" Text="{Binding Badge}" FontSize="{StaticResource FontSize.Caption}" Foreground="{DynamicResource Brush.Ink3}"
                         VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
            </Grid>
            <assist:CrispBorder x:Name="FocusRing" BorderThickness="{StaticResource Thickness.FocusRing}" BorderBrush="{DynamicResource Brush.Focus}" CornerRadius="{StaticResource Radius.Control}" Visibility="Collapsed"
                                IsHitTestVisible="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Selected" Property="Opacity" Value="1" />
              <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Brush.Blood}" />
              <Setter TargetName="Glyph" Property="IsFilled" Value="True" />
              <Setter TargetName="Label" Property="TextElement.FontWeight" Value="SemiBold" />
            </Trigger>
            <DataTrigger Binding="{Binding HasAlert}" Value="True">
              <Setter TargetName="Count" Property="Foreground" Value="{DynamicResource Brush.Critical}" />
              <Setter TargetName="Count" Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
            <Trigger Property="assist:FocusAssist.ShowRing" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The same destination on the 52 DIP icon rail: a 40 x 38 icon button with the title and its Alt shortcut as the tooltip. -->
  <Style x:Key="RailItem" TargetType="RadioButton" BasedOn="{StaticResource NavItem}">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="38" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent">
            <Border x:Name="HoverLayer" Opacity="0" CornerRadius="{StaticResource Radius.Control}" Background="{DynamicResource Brush.CaptionPressed}" />
            <assist:CrispBorder x:Name="Selected" Opacity="0" CornerRadius="{StaticResource Radius.Control}" Background="{DynamicResource Brush.NavActive}" BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1" />
            <Border x:Name="Bar" Width="3" HorizontalAlignment="Left" Margin="0,10,0,10" CornerRadius="2" Background="Transparent" />
            <controls:Icon x:Name="Glyph" Kind="{Binding Icon}" Size="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Ellipse x:Name="Dot" Width="6" Height="6" Fill="{DynamicResource Brush.Critical}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,7,0" Visibility="Collapsed" />
            <assist:CrispBorder x:Name="FocusRing" BorderThickness="{StaticResource Thickness.FocusRing}" BorderBrush="{DynamicResource Brush.Focus}" CornerRadius="{StaticResource Radius.Control}" Visibility="Collapsed"
                                IsHitTestVisible="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="HoverLayer" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Selected" Property="Opacity" Value="1" />
              <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Brush.Blood}" />
              <Setter TargetName="Glyph" Property="IsFilled" Value="True" />
            </Trigger>
            <DataTrigger Binding="{Binding HasAlert}" Value="True">
              <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <Trigger Property="assist:FocusAssist.ShowRing" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A sidebar group heading: 12 DIP Medium in Ink3. Dashboard sits on its own without one. -->
  <Style x:Key="NavGroupHeader" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
    <Setter Property="Margin" Value="12,14,12,4" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
  </Style>

  <!-- The account control at the foot of the sidebar and the avatar in the title bar: a quiet subtle button that opens the account menu. -->
  <Style x:Key="AccountButton" TargetType="Button" BasedOn="{StaticResource Button.Subtle}">
    <Setter Property="Padding" Value="12,10,12,10" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="MinWidth" Value="40" />
    <Setter Property="Height" Value="Auto" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="assist:ButtonAssist.HoverBackground" Value="{DynamicResource Brush.CaptionPressed}" />
    <Setter Property="assist:ButtonAssist.PressedBackground" Value="{DynamicResource Brush.CaptionHover}" />
  </Style>

  <!-- Title-bar icon buttons (notifications, the compact search): 32 DIP, quiet on Mica. -->
  <Style x:Key="TitleBarButton" TargetType="Button" BasedOn="{StaticResource Button.Subtle}">
    <Setter Property="Height" Value="32" />
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="Padding" Value="8,0,8,0" />
    <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
    <Setter Property="assist:ButtonAssist.HoverBackground" Value="{DynamicResource Brush.CaptionHover}" />
    <Setter Property="assist:ButtonAssist.PressedBackground" Value="{DynamicResource Brush.CaptionPressed}" />
  </Style>

  <!-- The title-bar search field (it opens the command palette): 440 x 32, radius 6, the layer at 75 % on Mica, a 1 DIP stroke, the search icon,
       a 13 DIP hint in Ink3 and the Ctrl K keys. A Button underneath, so it is one tab stop that Enter and Space open. -->
  <Style x:Key="TitleSearch" TargetType="Button">
    <Setter Property="Height" Value="32" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Cursor" Value="IBeam" />
    <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <assist:CrispBorder x:Name="Bd" Background="{DynamicResource Brush.LayerOnMica}" BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1" CornerRadius="{StaticResource Radius.Control}"
                                Padding="10,0,6,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <controls:Icon Kind="Search" Size="15" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Text="{TemplateBinding Content}" FontSize="{StaticResource FontSize.Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                  <Border Style="{StaticResource Kbd}" Margin="0,0,4,0">
                    <TextBlock Style="{StaticResource Kbd.Text}" Text="Ctrl" />
                  </Border>
                  <Border Style="{StaticResource Kbd}">
                    <TextBlock Style="{StaticResource Kbd.Text}" Text="K" />
                  </Border>
                </StackPanel>
              </Grid>
            </assist:CrispBorder>
            <assist:CrispBorder x:Name="FocusRing" Margin="{DynamicResource Inset.Neg4}" CornerRadius="{StaticResource Radius.FocusRing}" BorderThickness="{StaticResource Thickness.FocusRing}"
                                BorderBrush="{DynamicResource Brush.Focus}" Visibility="Collapsed" IsHitTestVisible="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Layer}" />
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Stroke2}" />
            </Trigger>
            <Trigger Property="assist:FocusAssist.ShowRing" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- One row of the command palette: 36 DIP, radius 5, the icon, the title, the subtitle and the shortcut keys at the right. -->
  <Style x:Key="PaletteItem" TargetType="ListBoxItem">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="Height" Value="36" />
    <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Bd" CornerRadius="5" Background="Transparent" Padding="10,0,10,0">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Selected}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
