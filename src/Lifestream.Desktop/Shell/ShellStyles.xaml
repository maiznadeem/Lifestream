<ResourceDictionary xmlns:controls="clr-namespace:Lifestream.Desktop.Controls" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:assist="clr-namespace:Lifestream.Desktop.Controls">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Lifestream;component/Theme/Tokens.xaml" />
    <ResourceDictionary Source="/Lifestream;component/Theme/Motion.xaml" />
    <ResourceDictionary Source="/Lifestream;component/Theme/Typography.xaml" />
    <ResourceDictionary Source="/Lifestream;component/Controls/Buttons.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- Sidebar destination. The accent bar and the padding are always there (the bar is transparent when not selected), so
       hover and selection change colour only and nothing shifts (SHELL-27). A RadioButton gives UI Automation a selected state. -->
  <Style x:Key="NavItem" TargetType="RadioButton">
    <Setter Property="GroupName" Value="Navigation" />
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="Height" Value="{StaticResource Height.Row}" />
    <Setter Property="Margin" Value="{DynamicResource Inset.L8R8B2}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" />
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="MouseOver">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" />
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" />
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Disabled" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Rest" CornerRadius="{StaticResource Radius.Control}" Background="Transparent" />
            <Border x:Name="HoverLayer" Opacity="0" CornerRadius="{StaticResource Radius.Control}" Background="{DynamicResource Brush.SurfaceHover}" />
            <Border x:Name="Selected" Opacity="0" CornerRadius="{StaticResource Radius.Control}" Background="{DynamicResource Brush.SurfaceSelected}" />
            <Grid Margin="{DynamicResource Inset.R12}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border x:Name="Bar" Width="4" Height="20" CornerRadius="{DynamicResource Radius.2}" Background="Transparent" VerticalAlignment="Center" />
              <controls:IconText x:Name="Glyph" Grid.Column="1" Style="{StaticResource Text.Icon}" Text="{TemplateBinding Tag}" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="{DynamicResource Brush.TextSecondary}" />
              <ContentPresenter Grid.Column="2" VerticalAlignment="Center" RecognizesAccessKey="False" />
            </Grid>
            <Border x:Name="FocusRing" BorderThickness="{StaticResource Thickness.FocusRing}" BorderBrush="{DynamicResource Brush.FocusRing}" CornerRadius="{DynamicResource Radius.6}" Visibility="Collapsed"
                    IsHitTestVisible="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Selected" Property="Opacity" Value="1" />
              <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Brush.Primary}" />
              <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            </Trigger>
            <Trigger Property="assist:FocusAssist.ShowRing" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="NavGroupHeader" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
    <Setter Property="Margin" Value="{DynamicResource Inset.L20T16R12B4}" />
    <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
  </Style>

  <!-- The account menu uses the themed menu styles (Controls/Menus.xaml). -->

  <!-- The one account control: avatar, name and a chevron, at least 32 x 32 DIP. -->
  <Style x:Key="AccountButton" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
    <Setter Property="Padding" Value="{DynamicResource Inset.L4R8}" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="MinWidth" Value="40" />
  </Style>
</ResourceDictionary>
