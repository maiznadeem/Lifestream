<UserControl x:Class="Lifestream.Desktop.Shell.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Lifestream.Desktop.Controls"
             xmlns:services="clr-namespace:Lifestream.Desktop.Services"
             Focusable="False">
  <UserControl.Resources>
    <services:AvatarConverter x:Key="Avatar" />
    <services:HasTextToVisibilityConverter x:Key="HasText" />
  </UserControl.Resources>
  <UserControl.InputBindings>
    <KeyBinding Key="F" Modifiers="Control" Command="{Binding SearchCommand}" />
    <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewRecordCommand}" />
  </UserControl.InputBindings>
  <Grid Background="{DynamicResource Brush.SurfaceCanvas}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="{DynamicResource Grid.Width.Sidebar}" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Sidebar: the logo is pinned in its own row, outside the scroll region; the groups fit at 640 DIP, so nothing scrolls. -->
    <Grid Background="{DynamicResource Brush.SurfaceRaised}" KeyboardNavigation.TabNavigation="Local" AutomationProperties.Name="Navigation">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <StackPanel x:Name="LogoRow" Orientation="Horizontal" Margin="20,16,20,8" Height="40">
        <Image Source="{DynamicResource Image.Logo}" Width="28" Height="28" />
        <TextBlock Style="{DynamicResource Text.Heading}" Text="Lifestream" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="NoWrap" />
      </StackPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" x:Name="NavScroll">
        <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <TextBlock Style="{DynamicResource NavGroupHeader}" Text="{Binding Title}" TextWrapping="NoWrap" />
                <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <RadioButton Style="{DynamicResource NavItem}" Content="{Binding Title}" Tag="{Binding IconGlyph}"
                                   IsChecked="{Binding IsSelected, Mode=OneWay}"
                                   Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                   AutomationProperties.Name="{Binding Title}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="64" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Header: page title and the account control -->
      <Grid Margin="24,0,16,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Style="{DynamicResource Text.Title}" Text="{Binding PageTitle}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                   AutomationProperties.HeadingLevel="Level1" />
        <Button x:Name="AccountButton" Grid.Column="1" Style="{DynamicResource AccountButton}" VerticalAlignment="Center" Click="OnAccountClick"
                AutomationProperties.Name="Account menu" AutomationProperties.HelpText="{Binding DisplayName}" ToolTip="Account menu">
          <StackPanel Orientation="Horizontal">
            <Border Width="28" Height="28" CornerRadius="14" ClipToBounds="True" Margin="0,0,8,0">
              <Image Source="{Binding Converter={StaticResource Avatar}}" Stretch="UniformToFill" />
            </Border>
            <TextBlock Style="{DynamicResource Text.Body}" Text="{Binding DisplayName}" VerticalAlignment="Center" TextWrapping="NoWrap" MaxWidth="180" TextTrimming="CharacterEllipsis" />
            <controls:IconText Style="{DynamicResource Text.Icon}" Text="&#xE70D;" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
          </StackPanel>
          <Button.ContextMenu>
            <ContextMenu Style="{DynamicResource ContextMenu.Lifestream}" PlacementTarget="{Binding RelativeSource={RelativeSource Self}}" Placement="Bottom">
              <MenuItem Style="{DynamicResource MenuItem.Lifestream}" Header="Profile" AutomationProperties.Name="Profile"
                        Command="{Binding PlacementTarget.DataContext.ProfileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
              <MenuItem Style="{DynamicResource MenuItem.Lifestream}" Header="Change password" AutomationProperties.Name="Change password"
                        Command="{Binding PlacementTarget.DataContext.ChangePasswordCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
              <MenuItem Style="{DynamicResource MenuItem.Lifestream}" Header="Sign out" AutomationProperties.Name="Sign out"
                        Command="{Binding PlacementTarget.DataContext.SignOutCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
      </Grid>

      <!-- Update prompt -->
      <Border Grid.Row="1" Margin="24,0,24,8" Padding="16,8" Background="{DynamicResource Brush.SurfaceRaised}" BorderBrush="{DynamicResource Brush.StatusInfo}" BorderThickness="1"
              CornerRadius="{DynamicResource Radius.Card}" Visibility="{Binding UpdatePrompt, Converter={StaticResource HasText}}" AutomationProperties.LiveSetting="Polite">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal">
            <controls:IconText Style="{DynamicResource Text.Icon}" Text="&#xE895;" Foreground="{DynamicResource Brush.StatusInfo}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBlock Style="{DynamicResource Text.Body}" Text="{Binding UpdatePrompt}" VerticalAlignment="Center" AutomationProperties.Name="Update ready" />
          </StackPanel>
          <Button Grid.Column="1" Style="{DynamicResource Button.Primary}" Content="Restart and update" Command="{Binding ApplyUpdateCommand}"
                  controls:ButtonAssist.IsBusy="{Binding ApplyUpdateCommand.IsRunning}" controls:ButtonAssist.BusyText="Updating..." />
        </Grid>
      </Border>

      <!-- The page: one view per visit, created from the view model by the locator and given that view model as its DataContext. -->
      <Grid Grid.Row="2" Margin="24,0,24,24">
        <ContentControl x:Name="PageHost" Content="{Binding CurrentPage}" ContentTemplateSelector="{x:Static services:ViewLocator.Instance}" IsTabStop="False" Focusable="False"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
      </Grid>
      <controls:ToastHost Grid.Row="2" DataContext="{Binding Toasts}" ItemsSource="{Binding Toasts}" />
    </Grid>
  </Grid>
</UserControl>
