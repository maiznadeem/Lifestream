<UserControl x:Class="Lifestream.Desktop.Shell.NotificationsFlyout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Lifestream.Desktop.Controls"
             xmlns:dashboard="clr-namespace:Lifestream.Client.Features.Dashboard;assembly=Lifestream.Client"
             Visibility="Collapsed" FontFamily="{DynamicResource Font.Family}" FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource Brush.Ink}" Focusable="False">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </UserControl.Resources>
  <!-- The bell's flyout: what needs attention now (the dashboard's "Needs attention" items), each with its one action, an empty state, and a link to the
       dashboard. It is part of the window (like the command palette), not a popup: a transparent layer under the title bar that a click closes, with the
       surface placed under the bell by NotificationsFlyout.Place. -->
  <Grid x:Name="Layer" Background="Transparent" MouseDown="OnLayerMouseDown">
    <Canvas x:Name="Stage">
      <!-- Edged in Stroke2 like the palette: over the dark page the shadow barely shows, and the edge is what sets the flyout apart -->
      <controls:ElevatedSurface x:Name="Surface" Level="Flyout" CornerRadius="{DynamicResource Radius.Panel}" Width="420" Padding="0" BorderBrush="{DynamicResource Brush.Stroke2}"
                                MouseDown="OnSurfaceMouseDown" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle"
                                AutomationProperties.Name="Notifications">
        <DockPanel>
          <!-- Title and count -->
          <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="0,0,0,1" Padding="{DynamicResource Inset.H18V12}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{DynamicResource Text.BodyStrong}" Text="Needs attention" AutomationProperties.HeadingLevel="Level2" />
              <TextBlock x:Name="CountText" Style="{DynamicResource Text.Secondary}" Text="{Binding CountText}" Margin="{DynamicResource Inset.L12}" VerticalAlignment="Center" />
            </StackPanel>
          </Border>

          <!-- The link to the whole picture -->
          <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="0,1,0,0" Padding="{DynamicResource Pad.8}">
            <Button x:Name="ViewAllButton" Style="{DynamicResource Button.Subtle.Small}" Command="{Binding ViewAllCommand}" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding ViewAllText}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding ViewAllText}" VerticalAlignment="Center" />
                <controls:Icon Kind="Chevr" Size="14" VerticalAlignment="Center" Margin="{DynamicResource Inset.L6}" />
              </StackPanel>
            </Button>
          </Border>

          <ScrollViewer x:Name="ItemsScroll" VerticalScrollBarVisibility="Auto" Focusable="False">
            <Grid>
              <!-- The items: a tinted icon tile, the problem in SemiBold, why it matters, and the one action. -->
              <ItemsControl x:Name="ItemsList" ItemsSource="{Binding Items}" Focusable="False" AutomationProperties.Name="Needs attention">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type dashboard:AttentionItem}">
                    <Border x:Name="Divider" BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="0,1,0,0" Padding="{DynamicResource Inset.H18V12}">
                      <Grid AutomationProperties.Name="{Binding AutomationName}">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Tile" Width="34" Height="34" CornerRadius="{DynamicResource Radius.Control}" Background="{DynamicResource Brush.CriticalSoft}" Margin="{DynamicResource Inset.R14}" VerticalAlignment="Top">
                          <controls:Icon x:Name="TileIcon" Kind="{Binding Icon}" Size="18" Foreground="{DynamicResource Brush.Critical}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                          <TextBlock Style="{DynamicResource Text.BodyStrong}" Text="{Binding Title}" TextWrapping="Wrap" />
                          <TextBlock Style="{DynamicResource Text.Secondary}" Text="{Binding Detail}" TextWrapping="Wrap" />
                          <Button Style="{DynamicResource Button.Secondary.Small}" Content="{Binding ActionText}" HorizontalAlignment="Left" Margin="{DynamicResource Inset.T8}"
                                  Command="{Binding DataContext.RunCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                  AutomationProperties.Name="{Binding ActionText}" AutomationProperties.HelpText="{Binding Title}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                        <Setter TargetName="Divider" Property="BorderThickness" Value="0" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Kind}" Value="{x:Static dashboard:AttentionKind.Warning}">
                        <Setter TargetName="Tile" Property="Background" Value="{DynamicResource Brush.WarningSoft}" />
                        <Setter TargetName="TileIcon" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Kind}" Value="{x:Static dashboard:AttentionKind.Info}">
                        <Setter TargetName="Tile" Property="Background" Value="{DynamicResource Brush.InfoSoft}" />
                        <Setter TargetName="TileIcon" Property="Foreground" Value="{DynamicResource Brush.Info}" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Nothing to do -->
              <StackPanel x:Name="EmptyState" Margin="{DynamicResource Inset.H18V12}" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite">
                <StackPanel Orientation="Horizontal">
                  <controls:Icon Kind="Checkc" Size="18" Foreground="{DynamicResource Brush.Success}" VerticalAlignment="Center" Margin="{DynamicResource Inset.R10}" />
                  <TextBlock x:Name="EmptyTitle" Style="{DynamicResource Text.BodyStrong}" Text="{Binding EmptyText}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Style="{DynamicResource Text.Secondary}" Text="{Binding EmptyDetail}" TextWrapping="Wrap" Margin="{DynamicResource Inset.T4}" />
              </StackPanel>

              <!-- Still asking the server (only while there is nothing to show yet) -->
              <StackPanel x:Name="LoadingState" Orientation="Horizontal" Margin="{DynamicResource Inset.H18V12}" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite">
                <controls:Icon Kind="Sync" Size="16" Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center" Margin="{DynamicResource Inset.R10}" />
                <TextBlock x:Name="LoadingText" Style="{DynamicResource Text.Secondary}" Text="Checking what needs attention" VerticalAlignment="Center" />
              </StackPanel>

              <!-- The server did not answer: say so, never "nothing needs attention" -->
              <StackPanel x:Name="ErrorState" Margin="{DynamicResource Inset.H18V12}" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive">
                <StackPanel Orientation="Horizontal">
                  <controls:Icon Kind="Alert" Size="18" Foreground="{DynamicResource Brush.Critical}" VerticalAlignment="Top" Margin="{DynamicResource Inset.R10}" />
                  <TextBlock x:Name="ErrorText" Style="{DynamicResource Text.Body}" Text="{Binding ErrorMessage}" TextWrapping="Wrap" MaxWidth="340" />
                </StackPanel>
                <Button x:Name="RetryButton" Style="{DynamicResource Button.Secondary.Small}" Content="Retry" Command="{Binding RetryCommand}" HorizontalAlignment="Left" Margin="{DynamicResource Inset.T8}"
                        AutomationProperties.Name="Retry" />
              </StackPanel>
            </Grid>
          </ScrollViewer>
        </DockPanel>
      </controls:ElevatedSurface>
    </Canvas>
  </Grid>
</UserControl>
