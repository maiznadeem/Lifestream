<UserControl x:Class="Lifestream.Desktop.Features.Staff.ResetPasswordDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Lifestream.Desktop.Controls"
             xmlns:feat="clr-namespace:Lifestream.Desktop.Features"
             xmlns:dialogs="clr-namespace:Lifestream.Desktop.Features.Dialogs"
             Focusable="False" IsTabStop="False">
  <!-- The admin's "Reset password" dialog: a temporary password typed twice in masked fields. No password is ever shown. The data context is the ResetPasswordDialogViewModel. -->
  <dialogs:DialogFrame>
    <dialogs:DialogFrame.Fields>
      <StackPanel>
        <TextBlock Style="{DynamicResource Text.Secondary}" Text="{Binding Explanation}" TextWrapping="Wrap" feat:Edge.Bottom="{DynamicResource Space.16}" />
        <controls:FormField Label="Temporary password" IsRequired="True" Hint="At least 12 characters" controls:FormFocus.FieldName="TemporaryPassword" Error="{Binding [TemporaryPassword]}">
          <controls:PasswordField Password="{Binding TemporaryPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Temporary password" />
        </controls:FormField>
        <controls:FormField Label="Confirm temporary password" IsRequired="True" controls:FormFocus.FieldName="ConfirmPassword" Error="{Binding [ConfirmPassword]}">
          <controls:PasswordField Password="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Confirm temporary password" />
        </controls:FormField>
      </StackPanel>
    </dialogs:DialogFrame.Fields>
  </dialogs:DialogFrame>
</UserControl>
