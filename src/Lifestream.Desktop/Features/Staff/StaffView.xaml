<UserControl x:Class="Lifestream.Desktop.Features.Staff.StaffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Lifestream.Desktop.Controls"
             xmlns:feat="clr-namespace:Lifestream.Desktop.Features"
             xmlns:lists="clr-namespace:Lifestream.Desktop.Features.ListScreens"
             xmlns:services="clr-namespace:Lifestream.Desktop.Services"
             xmlns:local="clr-namespace:Lifestream.Desktop.Features.Staff"
             xmlns:vm="clr-namespace:Lifestream.Client.Features.Staff;assembly=Lifestream.Client"
             controls:ShellPage.OwnsHeader="True" Focusable="False">
  <!-- Staff (direction A): the page header with Add staff member (secondary while the panel is open, its label folded to the icon in a compact window),
       one line for the read-only demo account, a toolbar (search with Ctrl F and a "+ Salary" chip whose popup takes a range, digits only), the table
       (avatar with initials until a photo arrives, lazily, row by row; job title, shift and a role badge; no password anywhere), and the selected person's
       side panel: who they are, role and access badges, Edit (the one primary), Reset password and a "..." menu with Delete staff member, then what the
       role can do and their details. The add and edit form opens in the same panel. -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <services:HasTextToVisibilityConverter x:Key="HasText" />
    <services:InverseBooleanToVisibilityConverter x:Key="NotVisible" />
    <local:PhotoSourceConverter x:Key="Photo" />
    <feat:NullToCollapsedConverter x:Key="NullToCollapsed" />
    <feat:NullToVisibleConverter x:Key="NullToVisible" />

    <!-- One access line in the panel: a check (allowed) or a dash (view only), the area, and what the person can do there. -->
    <Style x:Key="AccessIcon" TargetType="controls:Icon">
      <Setter Property="Kind" Value="Checkc" />
      <Setter Property="Size" Value="16" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
  </UserControl.Resources>

  <Grid x:Name="Root">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <Grid x:Name="Page" KeyboardNavigation.TabNavigation="Local">
      <Grid.Style>
        <Style TargetType="Grid">
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsPanelOpen}" Value="True">
              <Setter Property="Margin" Value="{DynamicResource Inset.R24}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Grid.Style>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <controls:PageHeader Title="Staff" Count="{Binding Total}">
        <controls:PageHeader.Actions>
          <!-- Button.Primary, or Button.Secondary while the panel is open (one filled button per screen: then the panel's action is the filled one); set in code-behind. -->
          <Button x:Name="AddButton" Style="{DynamicResource Button.Primary}" Command="{Binding AddCommand}" IsEnabled="{Binding CanManageStaff}"
                  AutomationProperties.Name="Add staff member" ToolTip="Add staff member (Ctrl+N)" ToolTipService.ShowOnDisabled="True">
            <StackPanel Orientation="Horizontal">
              <controls:Icon Kind="Userplus" Size="16" VerticalAlignment="Center" />
              <TextBlock x:Name="AddLabel" Text="Add staff member" VerticalAlignment="Center" feat:Edge.Left="{DynamicResource Space.8}" />
            </StackPanel>
          </Button>
        </controls:PageHeader.Actions>
      </controls:PageHeader>

      <!-- The demo account sees the list but changes nothing: one line says so, instead of unexplained disabled buttons. -->
      <controls:CrispBorder Grid.Row="1" Background="{DynamicResource Brush.InfoSoft}" BorderBrush="{DynamicResource Brush.InfoSoft}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Panel}"
                            Padding="{DynamicResource Inset.H12V8}" feat:Edge.Top="{DynamicResource Space.16}" Visibility="{Binding ReadOnlyNotice, Converter={StaticResource HasText}}">
        <StackPanel Orientation="Horizontal">
          <controls:Icon Kind="Lock" Size="16" Foreground="{DynamicResource Brush.Info}" VerticalAlignment="Center" feat:Edge.Right="{DynamicResource Space.12}" />
          <TextBlock Style="{DynamicResource Text.Body}" Text="{Binding ReadOnlyNotice}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.Name="Read-only notice" />
        </StackPanel>
      </controls:CrispBorder>

      <!-- Toolbar: search (Ctrl F, Enter searches at once) and the salary range. -->
      <WrapPanel Grid.Row="2" feat:Edge.Top="{DynamicResource Space.16}" feat:Edge.Bottom="{DynamicResource Space.12}">
        <TextBox x:Name="SearchBox" Style="{DynamicResource TextBox.Search}" Width="300" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"
                 controls:SearchAssist.Shortcut="Ctrl F" controls:InputAssist.Placeholder="Name, username or staff ID" feat:Edge.Right="{DynamicResource Space.8}" AutomationProperties.Name="Search staff">
          <TextBox.InputBindings>
            <KeyBinding Key="Enter" Command="{Binding SearchNowCommand}" />
          </TextBox.InputBindings>
        </TextBox>
        <Grid feat:Edge.Right="{DynamicResource Space.8}">
          <Button x:Name="SalaryChip" Style="{DynamicResource Button.Chip}" Click="OnSalaryChipClick" AutomationProperties.Name="Salary filter" ToolTip="Filter by a salary range">
            <StackPanel Orientation="Horizontal">
              <!-- The one chip pattern (FilterChip's): "+" while no range is set, a chevron once one is -->
              <controls:Icon x:Name="SalaryPlus" Kind="Plus" Size="14" VerticalAlignment="Center" Margin="{DynamicResource Inset.R6}"
                             Visibility="{Binding HasSalaryRange, Converter={StaticResource NotVisible}}" />
              <TextBlock x:Name="SalaryChipText" Text="{Binding SalaryChipText}" VerticalAlignment="Center" />
              <controls:Icon Kind="Alert" Size="14" Foreground="{DynamicResource Brush.Critical}" VerticalAlignment="Center" feat:Edge.Left="{DynamicResource Space.8}"
                             Visibility="{Binding HasSalaryRangeError, Converter={StaticResource BoolToVisibility}}" />
              <controls:Icon Kind="Chevd" Size="14" VerticalAlignment="Center" Margin="{DynamicResource Inset.L6}" Visibility="{Binding HasSalaryRange, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
          </Button>
          <!-- The range: two digit-only boxes. The list follows as you type (after the usual pause); Done closes, Clear empties both. -->
          <Popup x:Name="SalaryPopup" PlacementTarget="{Binding ElementName=SalaryChip}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Focusable="False"
                 Opened="OnSalaryPopupOpened">
            <controls:ElevatedSurface Level="Flyout" CornerRadius="{DynamicResource Radius.Panel}" feat:Edge.Top="{DynamicResource Space.4}">
              <Border Background="{DynamicResource Brush.Layer}" BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Panel}"
                      Padding="{DynamicResource Pad.16}" Width="288" KeyboardNavigation.TabNavigation="Cycle" KeyDown="OnSalaryPopupKeyDown">
                <StackPanel>
                  <TextBlock Style="{DynamicResource Text.Heading}" Text="Salary" feat:Edge.Bottom="{DynamicResource Space.12}" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SalaryFromBox" Text="{Binding SalaryFromText, UpdateSourceTrigger=PropertyChanged}" MaxLength="8" feat:DigitsOnly.IsEnabled="True"
                             controls:InputAssist.Placeholder="From" AutomationProperties.Name="Salary from" />
                    <TextBlock Grid.Column="1" Style="{DynamicResource Text.Secondary}" Text="to" VerticalAlignment="Center" feat:Edge.Left="{DynamicResource Space.8}" feat:Edge.Right="{DynamicResource Space.8}" />
                    <TextBox x:Name="SalaryToBox" Grid.Column="2" Text="{Binding SalaryToText, UpdateSourceTrigger=PropertyChanged}" MaxLength="8" feat:DigitsOnly.IsEnabled="True"
                             controls:InputAssist.Placeholder="To" AutomationProperties.Name="Salary to" />
                  </Grid>
                  <StackPanel Orientation="Horizontal" feat:Edge.Top="{DynamicResource Space.8}" Visibility="{Binding HasSalaryRangeError, Converter={StaticResource BoolToVisibility}}"
                              AutomationProperties.LiveSetting="Polite">
                    <controls:Icon Kind="Alert" Size="14" Foreground="{DynamicResource Brush.Critical}" VerticalAlignment="Center" feat:Edge.Right="{DynamicResource Space.4}" />
                    <TextBlock x:Name="SalaryError" Style="{DynamicResource Text.Caption}" Foreground="{DynamicResource Brush.Critical}" Text="{Binding SalaryRangeError}" VerticalAlignment="Center" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" feat:Edge.Top="{DynamicResource Space.16}">
                    <Button Style="{DynamicResource Button.Subtle.Small}" Content="Clear" Command="{Binding ClearSalaryCommand}" feat:Edge.Right="{DynamicResource Space.8}" AutomationProperties.Name="Clear the salary range" />
                    <Button Style="{DynamicResource Button.Secondary.Small}" Content="Done" Click="OnSalaryDone" AutomationProperties.Name="Close the salary filter" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </controls:ElevatedSurface>
          </Popup>
        </Grid>
        <Button Style="{DynamicResource Button.Subtle}" Content="Clear filters" Command="{Binding ClearFiltersCommand}" Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVisibility}}"
                AutomationProperties.Name="Clear filters" />
      </WrapPanel>

      <lists:ScreenWakingNotice Grid.Row="3" />

      <controls:LoadSurface x:Name="ListSurface" Grid.Row="4" State="{Binding State}" SkeletonKind="List" SkeletonColumns="2*,*,*,*"
                            ErrorMessage="{Binding ErrorMessage}" ErrorDetail="{Binding ErrorDetail}" RetryCommand="{Binding RetryCommand}"
                            EmptyIcon="Staff" EmptyTitle="{Binding EmptyTitle}" EmptyMessage="{Binding EmptyMessage}" EmptyActionText="{Binding EmptyActionText}"
                            EmptyActionCommand="{Binding EmptyActionCommand}">
        <controls:CrispBorder x:Name="TableFrame" Background="{DynamicResource Brush.Layer}" BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Panel}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <controls:LifestreamDataGrid x:Name="Grid" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" SortCommand="{Binding SortCommand}"
                                         SortColumn="{Binding SortColumn, Mode=OneWay}" SortDescending="{Binding SortDescending, Mode=OneWay}"
                                         AutomationProperties.Name="Staff" KeyDown="OnGridKeyDown">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Name" Width="Auto" MinWidth="220" MaxWidth="320" SortMemberPath="name">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type vm:StaffRow}">
                      <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- Initials, or the photo once it arrives. -->
                        <controls:Avatar Size="28" Initials="{Binding Initials}" Source="{Binding Photo, Converter={StaticResource Photo}}" Loaded="OnAvatarShown"
                                         AutomationProperties.Name="Photo" feat:Edge.Right="{DynamicResource Space.12}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Style="{DynamicResource DataGrid.PrimaryLine}" Text="{Binding DisplayName}" />
                          <TextBlock Style="{DynamicResource DataGrid.SecondaryLine}" Foreground="{DynamicResource Brush.Ink3}">
                            <Run Text="{Binding CodeText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Username, Mode=OneWay}" />
                          </TextBlock>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Job title" Width="*" MinWidth="130" CanUserSort="False">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type vm:StaffRow}">
                      <TextBlock Text="{Binding DesignationText}" Style="{DynamicResource DataGrid.TextCell}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn x:Name="ShiftColumn" Header="Shift" Width="*" MinWidth="110" CanUserSort="False">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type vm:StaffRow}">
                      <TextBlock Text="{Binding ShiftText}" Style="{DynamicResource DataGrid.TextCell}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Role" Width="*" MinWidth="140" CanUserSort="False">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type vm:StaffRow}">
                      <controls:Badge x:Name="Role" Text="{Binding RoleText}" Kind="Neutral" Icon="User" HorizontalAlignment="Left" VerticalAlignment="Center" />
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                          <Setter TargetName="Role" Property="Kind" Value="Info" />
                          <Setter TargetName="Role" Property="Icon" Value="Key" />
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </controls:LifestreamDataGrid>
            <lists:ListFooter Grid.Row="1" />
          </Grid>
        </controls:CrispBorder>
      </controls:LoadSurface>
    </Grid>

    <!-- The selected person, or the add / edit form. -->
    <controls:SidePanel x:Name="Panel" Grid.Column="1" IsOpen="{Binding IsPanelOpen}" Overline="{Binding PanelOverline}" CloseCommand="{Binding ClosePanelCommand}" lists:DetailPaneFrame.IsInPanel="True"
                        lists:PanelBleed.IsEnabled="True" AutomationProperties.Name="Staff member details">
      <Grid>
        <Grid Visibility="{Binding Editor, Converter={StaticResource NullToVisible}}">
          <controls:Skeleton Kind="Detail" Visibility="{Binding ShowDetailSkeleton, Converter={StaticResource BoolToVisibility}}" />
          <controls:ErrorState Message="{Binding DetailError}" RetryCommand="{Binding RetryDetailCommand}" Visibility="{Binding HasDetailError, Converter={StaticResource BoolToVisibility}}" />
          <ScrollViewer x:Name="PanelBody" Style="{DynamicResource ScrollViewer.Panel}" VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}">
            <StackPanel feat:Edge.Bottom="{DynamicResource Space.24}">
              <!-- Who: the avatar (photo once loaded), the name, what they do, and their role and account badges. -->
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:Avatar x:Name="PanelAvatar" Size="52" Initials="{Binding DetailInitials}" Source="{Binding SelectedItem.Photo, Converter={StaticResource Photo}}"
                                 VerticalAlignment="Top" feat:Edge.Right="{DynamicResource Space.16}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock x:Name="PanelName" Style="{DynamicResource Text.Section}" Text="{Binding Detail.DisplayName}" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2" />
                  <TextBlock x:Name="PanelSubtitle" Style="{DynamicResource Text.Secondary}" Text="{Binding DetailSubtitle}" TextWrapping="Wrap" feat:Edge.Top="{DynamicResource Space.4}" />
                </StackPanel>
              </Grid>
              <WrapPanel x:Name="Badges" feat:Edge.Top="{DynamicResource Space.12}">
                <controls:Badge x:Name="AdminBadge" Text="Administrator" Kind="Info" Icon="Key" feat:Edge.Right="{DynamicResource Space.8}" feat:Edge.Bottom="{DynamicResource Space.4}"
                                Visibility="{Binding DetailIsAdmin, Converter={StaticResource BoolToVisibility}}" />
                <controls:Badge x:Name="StaffBadge" Text="Staff" Kind="Neutral" Icon="User" feat:Edge.Right="{DynamicResource Space.8}" feat:Edge.Bottom="{DynamicResource Space.4}"
                                Visibility="{Binding DetailIsAdmin, Converter={StaticResource NotVisible}}" />
                <controls:Badge Text="Manages staff" Kind="Success" Icon="Staff" feat:Edge.Right="{DynamicResource Space.8}" feat:Edge.Bottom="{DynamicResource Space.4}"
                                Visibility="{Binding DetailIsAdmin, Converter={StaticResource BoolToVisibility}}" />
                <controls:Badge Text="Protected account" Kind="Neutral" Icon="Lock" feat:Edge.Bottom="{DynamicResource Space.4}"
                                Visibility="{Binding DetailIsProtected, Converter={StaticResource BoolToVisibility}}" ToolTip="The owner account can't be deleted or lose its administrator role." />
              </WrapPanel>

              <!-- Actions, as on every list screen: the one filled primary (Edit, which fills the row), then Reset password, and a "..." menu with Delete staff
                   member (it says why when it can't be used: your own or a protected account, or the demo account; the delete asks first). -->
              <Grid x:Name="ActionsRow" feat:Edge.Top="{DynamicResource Space.16}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="EditButton" Style="{DynamicResource Button.Primary}" Command="{Binding EditCommand}" IsEnabled="{Binding CanManageStaff}" feat:Edge.Right="{DynamicResource Space.8}"
                        AutomationProperties.Name="Edit">
                  <StackPanel Orientation="Horizontal">
                    <controls:Icon Kind="Edit" Size="16" VerticalAlignment="Center" feat:Edge.Right="{DynamicResource Space.8}" />
                    <TextBlock Text="Edit" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button x:Name="ResetButton" Grid.Column="1" Style="{DynamicResource Button.Secondary}" Command="{Binding ResetPasswordCommand}" AutomationProperties.Name="Reset password">
                  <StackPanel Orientation="Horizontal">
                    <controls:Icon Kind="Key" Size="16" VerticalAlignment="Center" feat:Edge.Right="{DynamicResource Space.8}" />
                    <TextBlock Text="Reset password" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <lists:MenuButton x:Name="MoreButton" Grid.Column="2" Style="{DynamicResource Button.Icon}" feat:Edge.Left="{DynamicResource Space.8}" AutomationProperties.Name="More actions" ToolTip="More actions">
                  <controls:Icon Kind="More" Size="18" />
                  <lists:MenuButton.ContextMenu>
                    <ContextMenu>
                      <MenuItem x:Name="DeleteItem" Header="Delete staff member" Command="{Binding DeleteCommand}" Foreground="{DynamicResource Brush.Critical}"
                                ToolTip="{Binding DeleteDisabledReason}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Delete staff member">
                        <MenuItem.Icon>
                          <controls:Icon Kind="Trash" Size="16" />
                        </MenuItem.Icon>
                      </MenuItem>
                    </ContextMenu>
                  </lists:MenuButton.ContextMenu>
                </lists:MenuButton>
              </Grid>

              <!-- Access: what the role can do in the app. -->
              <TextBlock Style="{DynamicResource Text.Heading}" Text="Access" feat:Edge.Top="{DynamicResource Space.16}" feat:Edge.Bottom="{DynamicResource Space.8}" AutomationProperties.HeadingLevel="Level3" />
              <Grid x:Name="Access">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <controls:Icon Style="{StaticResource AccessIcon}" feat:Edge.Right="{DynamicResource Space.12}" feat:Edge.Bottom="{DynamicResource Space.8}" />
                <TextBlock Grid.Column="1" Style="{DynamicResource Text.Body}" Text="Donors, patients, appointments and requests" TextWrapping="Wrap" feat:Edge.Bottom="{DynamicResource Space.8}" />
                <controls:Icon Grid.Row="1" Style="{StaticResource AccessIcon}" feat:Edge.Right="{DynamicResource Space.12}" feat:Edge.Bottom="{DynamicResource Space.8}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Style="{DynamicResource Text.Body}" Text="Stock and receipts" TextWrapping="Wrap" feat:Edge.Bottom="{DynamicResource Space.8}" />
                <controls:Icon x:Name="StaffAccessIcon" Grid.Row="2" feat:Edge.Right="{DynamicResource Space.12}">
                  <controls:Icon.Style>
                    <Style TargetType="controls:Icon" BasedOn="{StaticResource AccessIcon}">
                      <Setter Property="Kind" Value="Eye" />
                      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding DetailIsAdmin}" Value="True">
                          <Setter Property="Kind" Value="Checkc" />
                          <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </controls:Icon.Style>
                </controls:Icon>
                <TextBlock x:Name="StaffAccessText" Grid.Row="2" Grid.Column="1" Style="{DynamicResource Text.Body}" Text="{Binding DetailStaffAccessText}" TextWrapping="Wrap" />
              </Grid>

              <!-- Details: label and value, as in every A panel. -->
              <TextBlock Style="{DynamicResource Text.Heading}" Text="Details" feat:Edge.Top="{DynamicResource Space.16}" feat:Edge.Bottom="{DynamicResource Space.8}" AutomationProperties.HeadingLevel="Level3" />
              <ItemsControl x:Name="Facts" ItemsSource="{Binding DetailFacts}" Focusable="False" AutomationProperties.Name="Record details">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid feat:Edge.Bottom="{DynamicResource Space.8}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Style="{DynamicResource Text.Secondary}" Text="{Binding Label}" TextWrapping="Wrap" />
                      <TextBlock Grid.Column="1" Style="{DynamicResource Text.Body}" Text="{Binding Value}" TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Grid>
        <ContentControl x:Name="EditorHost" Content="{Binding Editor}" ContentTemplateSelector="{x:Static services:ViewLocator.Instance}" IsTabStop="False" Focusable="False"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="{Binding Editor, Converter={StaticResource NullToCollapsed}}" />
      </Grid>
    </controls:SidePanel>
  </Grid>
</UserControl>
