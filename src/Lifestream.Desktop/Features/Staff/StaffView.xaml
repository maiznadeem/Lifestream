<UserControl x:Class="Lifestream.Desktop.Features.Staff.StaffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Lifestream.Desktop.Controls"
             xmlns:feat="clr-namespace:Lifestream.Desktop.Features"
             xmlns:lists="clr-namespace:Lifestream.Desktop.Features.ListScreens"
             xmlns:services="clr-namespace:Lifestream.Desktop.Services"
             Focusable="False">
  <!-- Staff: search and a salary range (digits only) on top, the list with lazily loaded thumbnails (the shared default avatar until a photo arrives; no password anywhere), and on the right the person's actions and facts or the staff form. -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <services:HasTextToVisibilityConverter x:Key="HasText" />
    <services:AvatarConverter x:Key="Avatar" />
    <feat:NullToCollapsedConverter x:Key="NullToCollapsed" />
    <feat:NullToVisibleConverter x:Key="NullToVisible" />
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <DockPanel KeyboardNavigation.TabNavigation="Local">
      <Button x:Name="AddButton" DockPanel.Dock="Right" Style="{DynamicResource Button.Primary}" Command="{Binding AddCommand}" IsEnabled="{Binding CanManageStaff}" VerticalAlignment="Bottom"
              feat:Edge.Bottom="{DynamicResource Space.16}" AutomationProperties.Name="Add staff member" ToolTip="Ctrl+N" ToolTipService.ShowOnDisabled="True">
        <StackPanel Orientation="Horizontal">
          <controls:IconText Style="{DynamicResource Text.Icon}" Text="&#xE710;" feat:Edge.Right="{DynamicResource Space.8}" VerticalAlignment="Center" />
          <TextBlock Text="Add staff member" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <WrapPanel>
        <controls:FormField Label="Search" feat:Edge.Right="{DynamicResource Space.16}" MinWidth="220">
          <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="Search staff">
            <TextBox.InputBindings>
              <KeyBinding Key="Enter" Command="{Binding SearchNowCommand}" />
            </TextBox.InputBindings>
          </TextBox>
        </controls:FormField>
        <controls:FormField Label="Salary from" feat:Edge.Right="{DynamicResource Space.16}" MinWidth="120">
          <TextBox x:Name="SalaryFromBox" Text="{Binding SalaryFromText, UpdateSourceTrigger=PropertyChanged}" MaxLength="8" feat:DigitsOnly.IsEnabled="True" AutomationProperties.Name="Salary from" />
        </controls:FormField>
        <controls:FormField Label="Salary to" feat:Edge.Right="{DynamicResource Space.16}" MinWidth="120" Error="{Binding SalaryRangeError}">
          <TextBox x:Name="SalaryToBox" Text="{Binding SalaryToText, UpdateSourceTrigger=PropertyChanged}" MaxLength="8" feat:DigitsOnly.IsEnabled="True" AutomationProperties.Name="Salary to" />
        </controls:FormField>
        <Button Style="{DynamicResource Button.Ghost}" Content="Clear filters" Command="{Binding ClearFiltersCommand}" VerticalAlignment="Bottom" feat:Edge.Bottom="{DynamicResource Space.16}"
                Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Clear filters" />
      </WrapPanel>
    </DockPanel>

    <TextBlock Grid.Row="1" Style="{DynamicResource Text.Body}" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding ReadOnlyNotice}" TextWrapping="Wrap" feat:Edge.Bottom="{DynamicResource Space.12}"
               Visibility="{Binding ReadOnlyNotice, Converter={StaticResource HasText}}" AutomationProperties.Name="Read-only notice" />

    <lists:ScreenWakingNotice Grid.Row="2" />
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="360" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="400" />
      </Grid.ColumnDefinitions>
      <controls:LoadSurface x:Name="ListSurface" State="{Binding State}" SkeletonKind="List" SkeletonColumns="2*,116,100,90,100,130"
                            ErrorMessage="{Binding ErrorMessage}" ErrorDetail="{Binding ErrorDetail}" RetryCommand="{Binding RetryCommand}"
                            EmptyGlyph="&#xE716;" EmptyTitle="{Binding EmptyTitle}" EmptyMessage="{Binding EmptyMessage}" EmptyActionText="{Binding EmptyActionText}"
                            EmptyActionCommand="{Binding EmptyActionCommand}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <controls:LifestreamDataGrid x:Name="Grid" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" SortCommand="{Binding SortCommand}"
                                       SortColumn="{Binding SortColumn, Mode=OneWay}" SortDescending="{Binding SortDescending, Mode=OneWay}"
                                       AutomationProperties.Name="Staff">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="Name" Width="2*" MinWidth="190" SortMemberPath="name">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Grid VerticalAlignment="Center" feat:Edge.Left="{DynamicResource Space.12}" feat:Edge.Right="{DynamicResource Space.12}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Ellipse Width="28" Height="28" feat:Edge.Right="{DynamicResource Space.12}" Loaded="OnAvatarShown" DataContextChanged="OnAvatarContextChanged" AutomationProperties.Name="Photo">
                        <Ellipse.Fill>
                          <ImageBrush ImageSource="{Binding Photo, Converter={StaticResource Avatar}}" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                      </Ellipse>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{DynamicResource DataGrid.PrimaryLine}" Text="{Binding DisplayName}" />
                        <TextBlock Style="{DynamicResource DataGrid.SecondaryLine}" Foreground="{DynamicResource Brush.TextMuted}" Text="{Binding Username}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Designation" Width="116" CanUserSort="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding DesignationText}" Style="{DynamicResource DataGrid.TextCell}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Shift" Width="100" CanUserSort="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding ShiftText}" Style="{DynamicResource DataGrid.TextCell}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Role" Width="90" CanUserSort="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding RoleText}" Style="{DynamicResource DataGrid.TextCell}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </controls:LifestreamDataGrid>
          <lists:ListFooter Grid.Row="1" />
        </Grid>
      </controls:LoadSurface>

      <Grid Grid.Column="2">
        <lists:ActionDetailPane Visibility="{Binding Editor, Converter={StaticResource NullToVisible}}">
          <lists:ActionDetailPane.Actions>
            <WrapPanel>
              <Button Style="{DynamicResource Button.Secondary}" Command="{Binding EditCommand}" IsEnabled="{Binding CanManageStaff}" feat:Edge.Right="{DynamicResource Space.8}" feat:Edge.Bottom="{DynamicResource Space.8}"
                      AutomationProperties.Name="Edit">
                <StackPanel Orientation="Horizontal">
                  <controls:IconText Style="{DynamicResource Text.Icon}" Text="&#xE70F;" feat:Edge.Right="{DynamicResource Space.8}" VerticalAlignment="Center" />
                  <TextBlock Text="Edit" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Style="{DynamicResource Button.Secondary}" Command="{Binding ResetPasswordCommand}" feat:Edge.Right="{DynamicResource Space.8}" feat:Edge.Bottom="{DynamicResource Space.8}"
                      AutomationProperties.Name="Reset password">
                <StackPanel Orientation="Horizontal">
                  <controls:IconText Style="{DynamicResource Text.Icon}" Text="&#xE192;" feat:Edge.Right="{DynamicResource Space.8}" VerticalAlignment="Center" />
                  <TextBlock Text="Reset password" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Style="{DynamicResource Button.Danger}" Command="{Binding DeleteCommand}" feat:Edge.Bottom="{DynamicResource Space.8}" AutomationProperties.Name="Delete"
                      ToolTip="{Binding DeleteDisabledReason}" ToolTipService.ShowOnDisabled="True" controls:ButtonAssist.IsBusy="{Binding DeleteCommand.IsRunning}" controls:ButtonAssist.BusyText="Deleting...">
                <StackPanel Orientation="Horizontal">
                  <controls:IconText Style="{DynamicResource Text.Icon}" Text="&#xE74D;" feat:Edge.Right="{DynamicResource Space.8}" VerticalAlignment="Center" />
                  <TextBlock Text="Delete" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </WrapPanel>
          </lists:ActionDetailPane.Actions>
        </lists:ActionDetailPane>
        <ContentControl Content="{Binding Editor}" ContentTemplateSelector="{x:Static services:ViewLocator.Instance}" IsTabStop="False" Focusable="False"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="{Binding Editor, Converter={StaticResource NullToCollapsed}}" />
      </Grid>
    </Grid>
  </Grid>
</UserControl>
