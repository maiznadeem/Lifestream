<UserControl x:Class="Lifestream.Desktop.Features.Donors.DonorEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Lifestream.Desktop.Controls"
             xmlns:lists="clr-namespace:Lifestream.Desktop.Features.ListScreens"
             Focusable="False" IsTabStop="False">
  <!-- The donor form: the shared person fields plus how often the donor gives blood. The data context is the DonorEditorViewModel. -->
  <lists:RecordEditorChrome>
    <lists:RecordEditorChrome.Fields>
      <lists:PersonFormFields>
        <lists:PersonFormFields.Extra>
          <controls:FormField Label="Donates (required)" IsRequired="True" controls:FormFocus.FieldName="Frequency" Error="{Binding [Frequency]}">
            <ComboBox ItemsSource="{Binding FrequencyChoices}" DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding Frequency, Mode=TwoWay}"
                      AutomationProperties.Name="How often the donor donates" />
          </controls:FormField>
        </lists:PersonFormFields.Extra>
      </lists:PersonFormFields>
    </lists:RecordEditorChrome.Fields>
  </lists:RecordEditorChrome>
</UserControl>
