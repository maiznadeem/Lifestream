<UserControl x:Class="Lifestream.Desktop.Features.Donors.DonorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Lifestream.Desktop.Controls"
             xmlns:feat="clr-namespace:Lifestream.Desktop.Features"
             xmlns:lists="clr-namespace:Lifestream.Desktop.Features.ListScreens"
             xmlns:services="clr-namespace:Lifestream.Desktop.Services"
             Focusable="False">
  <!-- Donors: search and filters on top, the list with its page count, and on the right the detail of the selected donor or the editor. -->
  <UserControl.Resources>
    <feat:DateTextConverter x:Key="DateText" />
    <feat:BloodTypeTextConverter x:Key="BloodTypeText" />
    <feat:NullToCollapsedConverter x:Key="NullToCollapsed" />
    <feat:NullToVisibleConverter x:Key="NullToVisible" />
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <lists:ListToolbar />
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="360" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="400" />
      </Grid.ColumnDefinitions>
      <controls:LoadSurface x:Name="ListSurface" State="{Binding State}" SkeletonKind="List" SkeletonColumns="2*,100,90,*,130"
                            ErrorMessage="{Binding ErrorMessage}" ErrorDetail="{Binding ErrorDetail}" RetryCommand="{Binding RetryCommand}"
                            EmptyGlyph="&#xE716;" EmptyTitle="{Binding EmptyTitle}" EmptyMessage="{Binding EmptyMessage}" EmptyActionText="{Binding EmptyActionText}"
                            EmptyActionCommand="{Binding EmptyActionCommand}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <controls:LifestreamDataGrid x:Name="Grid" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" SortCommand="{Binding SortCommand}"
                                       SortColumn="{Binding SortColumn, Mode=OneWay}" SortDescending="{Binding SortDescending, Mode=OneWay}"
                                       AutomationProperties.Name="Donors">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" SortMemberPath="name" Width="2*" />
              <DataGridTextColumn Header="Blood type" Binding="{Binding BloodType, Converter={StaticResource BloodTypeText}}" CanUserSort="False" Width="100" />
              <DataGridTemplateColumn Header="Gender" Width="90">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Gender}" Style="{DynamicResource DataGrid.TextCell}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Phone" Width="*" MinWidth="130">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Phone}" Style="{DynamicResource DataGrid.TextCell}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Last donated" Binding="{Binding LastDonated, Converter={StaticResource DateText}, ConverterParameter=Never}" SortMemberPath="lastDonated" Width="130" />
            </DataGrid.Columns>
          </controls:LifestreamDataGrid>
          <lists:ListFooter Grid.Row="1" />
        </Grid>
      </controls:LoadSurface>
      <Grid Grid.Column="2">
        <lists:RecordDetailPane Visibility="{Binding Editor, Converter={StaticResource NullToVisible}}">
          <lists:RecordDetailPane.RelatedActions>
            <Button Style="{DynamicResource Button.Secondary}" Command="{Binding BookAppointmentCommand}" AutomationProperties.Name="Book appointment">
              <StackPanel Orientation="Horizontal">
                <controls:IconText Style="{DynamicResource Text.Icon}" Text="&#xE787;" feat:Edge.Right="{DynamicResource Space.8}" VerticalAlignment="Center" />
                <TextBlock Text="Book appointment" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </lists:RecordDetailPane.RelatedActions>
        </lists:RecordDetailPane>
        <ContentControl Content="{Binding Editor}" ContentTemplateSelector="{x:Static services:ViewLocator.Instance}" IsTabStop="False" Focusable="False"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="{Binding Editor, Converter={StaticResource NullToCollapsed}}" />
      </Grid>
    </Grid>
  </Grid>
</UserControl>
