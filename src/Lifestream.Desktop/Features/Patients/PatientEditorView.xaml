<UserControl x:Class="Lifestream.Desktop.Features.Patients.PatientEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lists="clr-namespace:Lifestream.Desktop.Features.ListScreens"
             Focusable="False" IsTabStop="False">
  <!-- The patient form: the shared person fields. The data context is the PatientEditorViewModel. -->
  <lists:RecordEditorChrome>
    <lists:RecordEditorChrome.Fields>
      <lists:PersonFormFields />
    </lists:RecordEditorChrome.Fields>
  </lists:RecordEditorChrome>
</UserControl>
