<UserControl x:Class="Lifestream.Desktop.Features.Patients.PatientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Lifestream.Desktop.Controls"
             xmlns:feat="clr-namespace:Lifestream.Desktop.Features"
             xmlns:lists="clr-namespace:Lifestream.Desktop.Features.ListScreens"
             xmlns:reqs="clr-namespace:Lifestream.Desktop.Features.Requests"
             xmlns:services="clr-namespace:Lifestream.Desktop.Services"
             controls:ShellPage.OwnsHeader="True"
             Focusable="False">
  <!-- Patients (direction A), the same layout as Donors: the page header with the count and "Add patient" (secondary while a patient is open), the search and chips, the
       table (Name capped at 320; Date of birth and Gender as the room allows), the paging footer, and the selected patient (or the form) in the side panel: who they are,
       "New request", Edit and "...", each request waiting for blood with how urgent it is, whether today's stock covers it and "Fulfil", and the details with the groups
       they can receive. -->
  <UserControl.Resources>
    <feat:DateTextConverter x:Key="DateText" />
    <feat:NullToCollapsedConverter x:Key="NullToCollapsed" />
    <feat:NullToVisibleConverter x:Key="NullToVisible" />
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <lists:TypographicBloodTypeConverter x:Key="BloodGroup" />
    <lists:InitialsConverter x:Key="Initials" />
    <lists:RecordCodeConverter x:Key="Code" />
    <lists:IsCompactConverter x:Key="IsCompact" />
    <lists:HasContentToVisibleConverter x:Key="HasContent" />
    <lists:EqualsToVisibleConverter x:Key="EqualsToVisible" />
    <reqs:UrgencyBadgeKindConverter x:Key="UrgencyKind" />
    <reqs:UrgencyIconConverter x:Key="UrgencyIcon" />
    <reqs:CoverPartConverter x:Key="Cover" />
    <Thickness x:Key="Patients.ToolbarGap">0,20,0,16</Thickness>
    <Thickness x:Key="Patients.NameGap">10,0,0,0</Thickness>
    <Thickness x:Key="Patients.HeaderGap">14,0,12,0</Thickness>
    <Thickness x:Key="Patients.CardPad">14,12,12,12</Thickness>
    <Thickness x:Key="Patients.CardGap">0,0,0,8</Thickness>
    <Thickness x:Key="Patients.SectionGap">0,0,0,24</Thickness>
    <Thickness x:Key="Patients.PillGap">0,6,6,0</Thickness>
  </UserControl.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="360" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <!-- The list -->
    <Grid x:Name="ListColumn">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <controls:PageHeader x:Name="Header" Title="{Binding PageTitle}" Count="{Binding HeaderCount}">
        <controls:PageHeader.Actions>
          <Button x:Name="AddButton" Style="{DynamicResource Button.Primary}" lists:HeaderAction.IsDemoted="{Binding IsDetailOpen}" Command="{Binding AddCommand}"
                  AutomationProperties.Name="{Binding NewActionLabel}" ToolTip="Add patient (Ctrl+N)">
            <StackPanel Orientation="Horizontal">
              <controls:Icon Kind="Userplus" Size="16" VerticalAlignment="Center" />
              <TextBlock x:Name="AddLabel" Text="{Binding NewActionLabel}" VerticalAlignment="Center" Margin="{DynamicResource Inset.L8}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding (controls:Responsive.Breakpoint), RelativeSource={RelativeSource Self}}" Value="{x:Static controls:Breakpoint.Compact}">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </Button>
        </controls:PageHeader.Actions>
      </controls:PageHeader>
      <lists:ListToolbar x:Name="Toolbar" Grid.Row="1" Margin="{StaticResource Patients.ToolbarGap}" SearchPlaceholder="Search patients" />
      <lists:ScreenWakingNotice Grid.Row="2" />
      <Border x:Name="TablePanel" Grid.Row="3" Background="{DynamicResource Brush.Layer}" BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1"
              CornerRadius="{DynamicResource Radius.Panel}" SnapsToDevicePixels="True">
        <controls:LoadSurface x:Name="ListSurface" State="{Binding State}" SkeletonKind="List" SkeletonColumns="2*,80,*,*,*"
                              ErrorMessage="{Binding ErrorMessage}" ErrorDetail="{Binding ErrorDetail}" RetryCommand="{Binding RetryCommand}"
                              EmptyGlyph="&#xE77B;" EmptyTitle="{Binding EmptyTitle}" EmptyMessage="{Binding EmptyMessage}" EmptyActionText="{Binding EmptyActionText}"
                              EmptyActionCommand="{Binding EmptyActionCommand}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <controls:LifestreamDataGrid x:Name="Grid" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" SortCommand="{Binding SortCommand}"
                                         SortColumn="{Binding SortColumn, Mode=OneWay}" SortDescending="{Binding SortDescending, Mode=OneWay}"
                                         lists:ListColumns.IsResponsive="True" lists:ListKeys.Panel="{Binding ElementName=Panel}"
                                         AutomationProperties.Name="Patients">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Name" SortMemberPath="name" Width="Auto" MinWidth="200" MaxWidth="320">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:Avatar Initials="{Binding Name, Converter={StaticResource Initials}}" Size="28" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="{StaticResource Patients.NameGap}" VerticalAlignment="Center">
                          <TextBlock Style="{DynamicResource DataGrid.PrimaryLine}" FontWeight="Medium" Text="{Binding Name}" />
                          <TextBlock Style="{DynamicResource Text.Caption}" Text="{Binding Id, Converter={StaticResource Code}, ConverterParameter=P}" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Group" Width="80" CanUserSort="False">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <controls:BloodGroupTag Text="{Binding BloodType, Converter={StaticResource BloodGroup}}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Requests" Width="*" MinWidth="120" CanUserSort="False">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Grid VerticalAlignment="Center">
                        <controls:Badge x:Name="Waiting" Kind="Warning" ShowDot="True" HorizontalAlignment="Left" Text="{Binding PendingRequests, StringFormat={}{0} waiting}" />
                        <TextBlock x:Name="None" Style="{DynamicResource DataGrid.TextCell}" Foreground="{DynamicResource Brush.Ink3}" Text="None" Visibility="Collapsed" />
                      </Grid>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding PendingRequests}" Value="0">
                          <Setter TargetName="Waiting" Property="Visibility" Value="Collapsed" />
                          <Setter TargetName="None" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Phone" Width="*" MinWidth="130" CanUserSort="False" lists:ListColumns.HideBelow="620">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Style="{DynamicResource DataGrid.TextCell}" Text="{Binding Phone}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Date of birth" Width="*" MinWidth="120" CanUserSort="False" lists:ListColumns.HideBelow="760">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Style="{DynamicResource DataGrid.TextCell}" Text="{Binding DateOfBirth, Converter={StaticResource DateText}}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Gender" Width="*" MinWidth="90" CanUserSort="False" lists:ListColumns.HideBelow="900">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Style="{DynamicResource DataGrid.TextCell}" Text="{Binding Gender}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </controls:LifestreamDataGrid>
            <lists:ListFooter Grid.Row="1" />
          </Grid>
        </controls:LoadSurface>
      </Border>
    </Grid>

    <!-- The gap before the side panel, only while it is open -->
    <Border Grid.Column="1" Width="{DynamicResource Space.24}" Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVisibility}}" />

    <!-- The selected patient, or the patient form -->
    <controls:SidePanel x:Name="Panel" Grid.Column="2" IsOpen="{Binding IsDetailOpen, Mode=OneWay}" CloseCommand="{Binding CloseDetailCommand}" Overline="{Binding DetailCode}"
                        lists:PanelBleed.IsEnabled="True" lists:DetailPaneFrame.IsInPanel="True">
      <Grid>
        <lists:RecordDetailPane x:Name="DetailPane" FactsSource="{Binding PanelFacts}" DeleteText="Delete patient"
                                IsCompact="{Binding (controls:Responsive.Breakpoint), RelativeSource={RelativeSource Self}, Converter={StaticResource IsCompact}}" Visibility="{Binding Editor, Converter={StaticResource NullToVisible}}">
          <lists:RecordDetailPane.Header>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <controls:Avatar Initials="{Binding DetailInitials}" Size="52" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Margin="{StaticResource Patients.HeaderGap}" VerticalAlignment="Center">
                <TextBlock Style="{DynamicResource Text.Section}" Text="{Binding DetailTitle}" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2" />
                <TextBlock Style="{DynamicResource Text.Secondary}" Text="{Binding DetailSubtitle}" TextWrapping="Wrap" />
              </StackPanel>
              <controls:BloodGroupTag Grid.Column="2" Text="{Binding DetailBloodGroup}" IsLarge="True" VerticalAlignment="Top" />
            </Grid>
          </lists:RecordDetailPane.Header>
          <lists:RecordDetailPane.RelatedActions>
            <Button Style="{DynamicResource Button.Primary}" Command="{Binding NewRequestCommand}" HorizontalAlignment="Stretch" AutomationProperties.Name="New request">
              <StackPanel Orientation="Horizontal">
                <controls:Icon Kind="Request" Size="16" VerticalAlignment="Center" />
                <TextBlock Text="New request" VerticalAlignment="Center" Margin="{DynamicResource Inset.L8}" />
              </StackPanel>
            </Button>
          </lists:RecordDetailPane.RelatedActions>
          <lists:RecordDetailPane.Body>
            <!-- Each request waiting for blood (audit P1): what is needed and by when, how urgent, whether today's stock covers it, and Fulfil -->
            <StackPanel AutomationProperties.AutomationId="WaitingRequests" Margin="{StaticResource Patients.SectionGap}" Visibility="{Binding OpenRequestsText, Converter={StaticResource NullToCollapsed}}"
                        AutomationProperties.Name="{Binding OpenRequestsText}">
              <TextBlock Style="{DynamicResource Text.Heading}" Text="{Binding OpenRequestsText}" Margin="{DynamicResource Inset.B12}" AutomationProperties.HeadingLevel="Level3" />
              <ItemsControl AutomationProperties.AutomationId="WaitingList" ItemsSource="{Binding WaitingRequests}" Focusable="False" AutomationProperties.Name="Waiting requests">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource Brush.Layer2}" BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Panel}"
                            Padding="{StaticResource Patients.CardPad}" Margin="{StaticResource Patients.CardGap}" SnapsToDevicePixels="True">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- None of the group in stock: Fulfil is disabled and this line says why (the request stays open) -->
                        <TextBlock AutomationProperties.AutomationId="HoldReason" Grid.Row="1" Grid.ColumnSpan="2" Style="{DynamicResource Text.Caption}" Foreground="{DynamicResource Brush.Ink2}"
                                   Text="{Binding HoldReason}" TextWrapping="Wrap" Margin="{DynamicResource Inset.T8}" Visibility="{Binding HoldReason, Converter={StaticResource NullToCollapsed}}" />
                        <StackPanel>
                          <TextBlock Style="{DynamicResource Text.BodyStrong}" TextWrapping="Wrap"><Run Text="{Binding Title, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Code, Mode=OneWay}" Foreground="{DynamicResource Brush.Ink3}" FontWeight="Normal" /></TextBlock>
                          <TextBlock Style="{DynamicResource Text.Secondary}" Text="{Binding NeededText}" TextWrapping="Wrap" />
                          <WrapPanel Orientation="Horizontal">
                            <controls:Badge Text="{Binding Urgency.Text}" Kind="{Binding Urgency.Kind, Converter={StaticResource UrgencyKind}}" Icon="{Binding Urgency.Kind, Converter={StaticResource UrgencyIcon}}"
                                            Margin="{StaticResource Patients.PillGap}" Visibility="{Binding Urgency.Kind, Converter={StaticResource EqualsToVisible}, ConverterParameter=Critical|Soon|Normal}" />
                            <controls:Badge Text="{Binding Cover, Converter={StaticResource Cover}, ConverterParameter=Text}" Kind="{Binding Cover, Converter={StaticResource Cover}, ConverterParameter=Kind}"
                                            Icon="{Binding Cover, Converter={StaticResource Cover}, ConverterParameter=Icon}" Margin="{StaticResource Patients.PillGap}"
                                            Visibility="{Binding Cover, Converter={StaticResource Cover}, ConverterParameter=Visibility}" />
                          </WrapPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{DynamicResource Button.Secondary.Small}" VerticalAlignment="Center" Margin="{DynamicResource Inset.L12}" Content="Fulfil"
                                Command="{Binding DataContext.FulfilRequestCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                controls:ButtonAssist.BusyText="" AutomationProperties.Name="Fulfil this request" ToolTip="Open the request and fulfil it" IsEnabled="{Binding CanFulfil}"
                                AutomationProperties.HelpText="{Binding HoldReason}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock AutomationProperties.AutomationId="WaitingNote" Style="{DynamicResource Text.Caption}" Text="{Binding WaitingNote}" TextWrapping="Wrap"
                         Visibility="{Binding WaitingNote, Converter={StaticResource HasContent}}" />
            </StackPanel>
          </lists:RecordDetailPane.Body>
        </lists:RecordDetailPane>
        <ContentControl x:Name="EditorHost" Content="{Binding Editor}" ContentTemplateSelector="{x:Static services:ViewLocator.Instance}" IsTabStop="False" Focusable="False"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="{Binding Editor, Converter={StaticResource NullToCollapsed}}" />
      </Grid>
    </controls:SidePanel>
  </Grid>
</UserControl>
