<UserControl x:Class="Lifestream.Desktop.Features.Dialogs.DialogFrame"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:feat="clr-namespace:Lifestream.Desktop.Features"
             xmlns:controls="clr-namespace:Lifestream.Desktop.Controls"
             Focusable="False" IsTabStop="False">
  <!-- The shell of every form dialog: title, a message for what went wrong, the fields, and the actions bottom-right. Cancel is always enabled. The data context is a DialogViewModel. -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </UserControl.Resources>
  <Border Padding="{DynamicResource Pad.24}" AutomationProperties.Name="Dialog">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Style="{DynamicResource Text.Heading}" Text="{Binding Title}" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1" />
      <StackPanel Grid.Row="1">
      <controls:WakingNotice x:Name="Waking" IsActive="{Binding IsOperationWaking}" CancelCommand="{Binding CancelOperationCommand}" feat:Edge.Top="{DynamicResource Space.12}" />
      <controls:CrispBorder feat:Edge.PadX="{DynamicResource Space.12}" feat:Edge.PadY="{DynamicResource Space.8}" feat:Edge.Top="{DynamicResource Space.12}" Background="{DynamicResource Brush.SurfacePressed}"
              BorderBrush="{DynamicResource Brush.StatusDanger}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Control}" Visibility="{Binding HasFormError, Converter={StaticResource BoolToVisibility}}"
              AutomationProperties.LiveSetting="Assertive">
        <StackPanel Orientation="Horizontal">
          <controls:IconText Style="{DynamicResource Text.Icon}" Text="&#xE783;" Foreground="{DynamicResource Brush.StatusDanger}" VerticalAlignment="Top" feat:Edge.Top="{DynamicResource Space.4}" feat:Edge.Right="{DynamicResource Space.12}" />
          <TextBlock Style="{DynamicResource Text.Body}" Text="{Binding FormError}" TextWrapping="Wrap" MaxWidth="440" />
        </StackPanel>
      </controls:CrispBorder>
      </StackPanel>
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False" feat:Edge.Top="{DynamicResource Space.16}">
        <ContentControl Focusable="False" IsTabStop="False" Content="{Binding Fields, RelativeSource={RelativeSource AncestorType=UserControl}}" />
      </ScrollViewer>
      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" feat:Edge.Top="{DynamicResource Space.16}">
        <Button x:Name="CancelButton" Style="{DynamicResource Button.Secondary}" Content="{Binding CancelText}" Command="{Binding CancelCommand}" IsCancel="True"
                AutomationProperties.Name="{Binding CancelText}" />
        <Button x:Name="PrimaryButton" Style="{DynamicResource Button.Primary}" Content="{Binding PrimaryText}" Command="{Binding PrimaryCommand}" IsDefault="True" feat:Edge.Left="{DynamicResource Space.8}"
                Visibility="{Binding HasPrimary, Converter={StaticResource BoolToVisibility}}" controls:ButtonAssist.IsBusy="{Binding PrimaryCommand.IsRunning}"
                controls:ButtonAssist.BusyText="{Binding PrimaryBusyText}" AutomationProperties.Name="{Binding PrimaryText}" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
