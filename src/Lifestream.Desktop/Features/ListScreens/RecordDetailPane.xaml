<UserControl x:Class="Lifestream.Desktop.Features.ListScreens.RecordDetailPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Lifestream.Desktop.Controls"
             xmlns:feat="clr-namespace:Lifestream.Desktop.Features"
             Focusable="False" IsTabStop="False">
  <!-- The detail pane of the selected record: its facts, and the Edit and Delete actions that act on it (FEAT-04). The data context is the list view model. -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <feat:NullToVisibleConverter x:Key="NullToVisible" />
  </UserControl.Resources>
  <Border Background="{DynamicResource Brush.SurfaceRaised}" CornerRadius="{DynamicResource Radius.Card}" Padding="16" AutomationProperties.Name="Details">
    <Grid>
      <!-- Nothing selected -->
      <TextBlock x:Name="NoSelection" Style="{DynamicResource Text.Body}" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding NoSelectionText}" TextWrapping="Wrap"
                 VerticalAlignment="Top" Visibility="{Binding SelectedItem, Converter={StaticResource NullToVisible}}" />
      <controls:Skeleton Kind="Detail" Visibility="{Binding ShowDetailSkeleton, Converter={StaticResource BoolToVisibility}}" />
      <controls:ErrorState Message="{Binding DetailError}" RetryCommand="{Binding RetryDetailCommand}" Visibility="{Binding HasDetailError, Converter={StaticResource BoolToVisibility}}" />
      <Grid x:Name="DetailBody" Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Style="{DynamicResource Text.Heading}" Text="{Binding DetailTitle}" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,16">
          <Button x:Name="EditButton" Style="{DynamicResource Button.Secondary}" Command="{Binding EditCommand}" Margin="0,0,8,0" AutomationProperties.Name="Edit">
            <StackPanel Orientation="Horizontal">
              <controls:IconText Style="{DynamicResource Text.Icon}" Text="&#xE70F;" Margin="0,0,8,0" VerticalAlignment="Center" />
              <TextBlock Text="Edit" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="DeleteButton" Style="{DynamicResource Button.Danger}" Command="{Binding DeleteCommand}" AutomationProperties.Name="Delete"
                  controls:ButtonAssist.IsBusy="{Binding DeleteCommand.IsRunning}" controls:ButtonAssist.BusyText="Deleting...">
            <StackPanel Orientation="Horizontal">
              <controls:IconText Style="{DynamicResource Text.Icon}" Text="&#xE74D;" Margin="0,0,8,0" VerticalAlignment="Center" />
              <TextBlock Text="Delete" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False">
          <ItemsControl ItemsSource="{Binding DetailFacts}" Focusable="False" AutomationProperties.Name="Record details">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,0,12">
                  <TextBlock Style="{DynamicResource Text.Caption}" Text="{Binding Label}" Foreground="{DynamicResource Brush.TextMuted}" />
                  <TextBlock Style="{DynamicResource Text.Body}" Text="{Binding Value}" TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Border>
</UserControl>
