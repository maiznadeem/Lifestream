<UserControl x:Class="Lifestream.Desktop.Features.ListScreens.RecordDetailPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Lifestream.Desktop.Controls"
             xmlns:feat="clr-namespace:Lifestream.Desktop.Features"
             xmlns:lists="clr-namespace:Lifestream.Desktop.Features.ListScreens"
             Focusable="False" IsTabStop="False">
  <!-- The selected record in a side panel (direction A): the header (the screen's Header, or the record's name), one row of actions (the screen's primary RelatedActions,
       Edit, and a "..." menu with Delete), then the screen's Body (an eligibility card), the record's facts as a label/value grid under "Details", and the screen's Extra.
       ShowFrame draws the pane as its own panel; inside a SidePanel it is off. The data context is the list view model. -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <feat:NullToVisibleConverter x:Key="NullToVisible" />
    <feat:NullToCollapsedConverter x:Key="NullToCollapsed" />
    <Thickness x:Key="Pane.ActionsGap">0,16,0,20</Thickness>
  </UserControl.Resources>
  <Border x:Name="Frame" SnapsToDevicePixels="True" AutomationProperties.Name="Details">
    <Grid>
      <!-- Nothing selected -->
      <TextBlock x:Name="NoSelection" Style="{DynamicResource Text.Secondary}" Text="{Binding NoSelectionText}" TextWrapping="Wrap"
                 VerticalAlignment="Top" Visibility="{Binding SelectedItem, Converter={StaticResource NullToVisible}}" />
      <controls:Skeleton Kind="Detail" Visibility="{Binding ShowDetailSkeleton, Converter={StaticResource BoolToVisibility}}" />
      <controls:ErrorState Message="{Binding DetailError}" RetryCommand="{Binding RetryDetailCommand}" Visibility="{Binding HasDetailError, Converter={StaticResource BoolToVisibility}}" />
      <Grid x:Name="DetailBody" Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
          <TextBlock x:Name="TitleText" Style="{DynamicResource Text.Section}" Text="{Binding DetailTitle}" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2"
                     Visibility="{Binding Header, RelativeSource={RelativeSource AncestorType=lists:RecordDetailPane}, Converter={StaticResource NullToVisible}}" />
          <ContentControl Focusable="False" IsTabStop="False" Content="{Binding Header, RelativeSource={RelativeSource AncestorType=lists:RecordDetailPane}}"
                          Visibility="{Binding Header, RelativeSource={RelativeSource AncestorType=lists:RecordDetailPane}, Converter={StaticResource NullToCollapsed}}" />
        </Grid>
        <Grid x:Name="ActionsRow" Grid.Row="1" Margin="{StaticResource Pane.ActionsGap}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ContentControl x:Name="RelatedHost" Focusable="False" IsTabStop="False" HorizontalContentAlignment="Stretch" Margin="{DynamicResource Inset.R8}"
                          Content="{Binding RelatedActions, RelativeSource={RelativeSource AncestorType=lists:RecordDetailPane}}" />
          <Button x:Name="EditButton" Grid.Column="1" Style="{DynamicResource Button.Secondary}" Command="{Binding EditCommand}" controls:ButtonAssist.BusyText="" AutomationProperties.Name="Edit" ToolTip="Edit">
            <StackPanel Orientation="Horizontal">
              <controls:Icon Kind="Edit" Size="16" VerticalAlignment="Center" />
              <TextBlock x:Name="EditText" Text="Edit" VerticalAlignment="Center" Margin="{DynamicResource Inset.L8}" />
            </StackPanel>
          </Button>
          <lists:MenuButton x:Name="MoreButton" Grid.Column="2" Style="{DynamicResource Button.Icon}" Margin="{DynamicResource Inset.L8}" AutomationProperties.Name="More actions" ToolTip="More actions">
            <controls:Icon Kind="More" Size="18" />
            <lists:MenuButton.ContextMenu>
              <ContextMenu>
                <MenuItem x:Name="DeleteItem" Command="{Binding DeleteCommand}" Foreground="{DynamicResource Brush.Critical}"
                          Header="{Binding DeleteText, RelativeSource={RelativeSource AncestorType=lists:RecordDetailPane}}">
                  <MenuItem.Icon>
                    <controls:Icon Kind="Trash" Size="16" />
                  </MenuItem.Icon>
                </MenuItem>
              </ContextMenu>
            </lists:MenuButton.ContextMenu>
          </lists:MenuButton>
        </Grid>
        <ScrollViewer x:Name="BodyScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <StackPanel>
            <ContentControl Focusable="False" IsTabStop="False" Content="{Binding Body, RelativeSource={RelativeSource AncestorType=lists:RecordDetailPane}}" />
            <lists:FactGrid x:Name="Facts" />
            <ContentControl Focusable="False" IsTabStop="False" Content="{Binding Extra, RelativeSource={RelativeSource AncestorType=lists:RecordDetailPane}}" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Border>
</UserControl>
