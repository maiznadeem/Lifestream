<UserControl x:Class="Lifestream.Desktop.Features.ListScreens.FactGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lists="clr-namespace:Lifestream.Desktop.Features.ListScreens"
             Focusable="False" IsTabStop="False">
  <!-- A record's facts as a label/value grid under a heading ("Details"): the labels in a column as wide as the longest (at least 110), the values beside them, wrapping. -->
  <UserControl.Resources>
    <Thickness x:Key="Fact.Row">0,0,0,10</Thickness>
    <Thickness x:Key="Fact.LabelGap">0,0,16,0</Thickness>
  </UserControl.Resources>
  <StackPanel x:Name="Root" Grid.IsSharedSizeScope="True">
    <TextBlock x:Name="HeadingText" Style="{DynamicResource Text.Heading}" Text="{Binding Heading, RelativeSource={RelativeSource AncestorType=lists:FactGrid}}" Margin="{DynamicResource Inset.B12}"
               AutomationProperties.HeadingLevel="Level3" />
    <ItemsControl x:Name="List" Focusable="False" AutomationProperties.Name="Record details">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Grid Margin="{StaticResource Fact.Row}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" MinWidth="110" SharedSizeGroup="FactLabel" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{DynamicResource Text.Secondary}" Text="{Binding Label}" Margin="{StaticResource Fact.LabelGap}" TextWrapping="NoWrap" />
            <TextBlock Grid.Column="1" Style="{DynamicResource Text.Body}" Text="{Binding Value}" TextWrapping="Wrap" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
