<UserControl x:Class="Lifestream.Desktop.Features.ListScreens.ListFooter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Lifestream.Desktop.Controls"
             Focusable="False" IsTabStop="False">
  <!-- "Showing 1-50 of 1,230" and the page buttons (FEAT-01). The data context is the list view model. -->
  <Grid Margin="0,8,0,0">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <TextBlock x:Name="RangeText" Style="{DynamicResource Text.Body}" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding RangeText}" VerticalAlignment="Center"
               AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Rows shown" />
    <StackPanel Grid.Column="1" Orientation="Horizontal">
      <TextBlock Style="{DynamicResource Text.Caption}" Text="{Binding PageCountText}" VerticalAlignment="Center" Margin="0,0,12,0" />
      <Button Style="{DynamicResource Button.Secondary}" Command="{Binding PreviousPageCommand}" MinHeight="32" Margin="0,0,8,0" AutomationProperties.Name="Previous page">
        <StackPanel Orientation="Horizontal">
          <controls:IconText Style="{DynamicResource Text.Icon}" Text="&#xE76B;" Margin="0,0,8,0" VerticalAlignment="Center" />
          <TextBlock Text="Previous" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Style="{DynamicResource Button.Secondary}" Command="{Binding NextPageCommand}" MinHeight="32" AutomationProperties.Name="Next page">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Next" VerticalAlignment="Center" />
          <controls:IconText Style="{DynamicResource Text.Icon}" Text="&#xE76C;" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </StackPanel>
  </Grid>
</UserControl>
