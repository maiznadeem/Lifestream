<UserControl x:Class="Lifestream.Desktop.Features.ListScreens.ListFooter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Lifestream.Desktop.Controls"
             Focusable="False" IsTabStop="False">
  <!-- The foot of a list's panel (direction A): "Showing 1–50 of 1,230" on the left, "< Page 1 of 3 >" on the right (whenever the list has rows, also on its only page),
       under a 1 px line with a soft 20 px fade above it while more rows lie below the view, so a row the list scrolls under reads as scrolled, not cut (design-qa-2
       N19: 8 px still read as a cut). The data context is the list view model. -->
  <UserControl.Resources>
    <Thickness x:Key="Footer.Pad">16,8,10,8</Thickness>
    <Thickness x:Key="Footer.PageGap">6,0,6,0</Thickness>
    <Thickness x:Key="Footer.FadeLift">0,-20,0,0</Thickness>
  </UserControl.Resources>
  <Grid>
  <!-- The fade: the panel's own colour, from clear to solid, over the last 20 px of the rows; shown by the code-behind while rows continue below. No clicks. -->
  <Rectangle x:Name="Fade" Height="20" VerticalAlignment="Top" Margin="{StaticResource Footer.FadeLift}" Fill="{DynamicResource Brush.Layer}" IsHitTestVisible="False">
    <Rectangle.OpacityMask>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="Transparent" Offset="0" />
        <GradientStop Color="Black" Offset="1" />
      </LinearGradientBrush>
    </Rectangle.OpacityMask>
  </Rectangle>
  <Border BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="0,1,0,0" Padding="{StaticResource Footer.Pad}" SnapsToDevicePixels="True" MinHeight="{DynamicResource Height.Row}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="RangeText" Style="{DynamicResource Text.Secondary}" Text="{Binding RangeText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                 AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Rows shown" />
      <!-- The pager only when there is more than one page. -->
      <StackPanel x:Name="Pager" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Style.Triggers>
              <DataTrigger Binding="{Binding PageCountText}" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>
        <Button Style="{DynamicResource Button.Icon.Small}" Command="{Binding PreviousPageCommand}" AutomationProperties.Name="Previous page" ToolTip="Previous page">
          <controls:Icon Kind="Chevl" Size="16" />
        </Button>
        <TextBlock x:Name="PageText" Style="{DynamicResource Text.Secondary}" Foreground="{DynamicResource Brush.Ink}" Text="{Binding PageCountText}" VerticalAlignment="Center"
                   Margin="{StaticResource Footer.PageGap}" />
        <Button Style="{DynamicResource Button.Icon.Small}" Command="{Binding NextPageCommand}" AutomationProperties.Name="Next page" ToolTip="Next page">
          <controls:Icon Kind="Chevr" Size="16" />
        </Button>
      </StackPanel>
    </Grid>
  </Border>
  </Grid>
</UserControl>
