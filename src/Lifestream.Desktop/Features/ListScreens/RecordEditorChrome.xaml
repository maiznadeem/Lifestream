<UserControl x:Class="Lifestream.Desktop.Features.ListScreens.RecordEditorChrome"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Lifestream.Desktop.Controls"
             Focusable="False" IsTabStop="False">
  <!-- The frame of every record form (direction A): the title, the form-wide messages, the fields in a scroll area, and a footer under a 1 px line with Cancel (always
       enabled) and the primary Save on the right (FEAT-08). ShowFrame (on by default) draws it as its own panel; inside a SidePanel set it off. -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <Thickness x:Key="Editor.Messages">0,12,0,4</Thickness>
    <Thickness x:Key="Editor.Notice">12,10,12,10</Thickness>
    <Thickness x:Key="Editor.Footer">0,16,0,0</Thickness>
    <Thickness x:Key="Editor.FieldsPad">0,4,0,16</Thickness>
  </UserControl.Resources>
  <UserControl.InputBindings>
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
  </UserControl.InputBindings>
  <Border x:Name="Frame" SnapsToDevicePixels="True" AutomationProperties.Name="Record form">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock x:Name="TitleText" Style="{DynamicResource Text.Section}" Text="{Binding Title}" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1" />
      <StackPanel Grid.Row="1" Margin="{StaticResource Editor.Messages}">
        <!-- A save or a reload is waiting on a waking server: say so, and let the user cancel the request (SHELL-07). -->
        <controls:WakingNotice x:Name="Waking" IsActive="{Binding IsOperationWaking}" CancelCommand="{Binding CancelOperationCommand}" Margin="{DynamicResource Inset.B12}" />
        <!-- Someone else changed the record (409): reload, never overwrite. -->
        <controls:CrispBorder Padding="{StaticResource Editor.Notice}" Margin="{DynamicResource Inset.B12}" Background="{DynamicResource Brush.WarningSoft}"
                              CornerRadius="{DynamicResource Radius.Control}" Visibility="{Binding HasConflict, Converter={StaticResource BoolToVisibility}}" AutomationProperties.LiveSetting="Assertive">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:Icon Kind="Alert" Size="16" Foreground="{DynamicResource Brush.Warning}" VerticalAlignment="Top" Margin="{DynamicResource Inset.R8}" />
            <StackPanel Grid.Column="1">
              <TextBlock Style="{DynamicResource Text.Body}" Text="{Binding ConflictMessage}" TextWrapping="Wrap" />
              <Button Style="{DynamicResource Button.Secondary.Small}" Content="Reload" Command="{Binding ReloadCommand}" HorizontalAlignment="Left" Margin="{DynamicResource Inset.T8}"
                      AutomationProperties.Name="Reload the latest version" />
            </StackPanel>
          </Grid>
        </controls:CrispBorder>
        <controls:CrispBorder Padding="{StaticResource Editor.Notice}" Margin="{DynamicResource Inset.B12}" Background="{DynamicResource Brush.CriticalSoft}"
                              CornerRadius="{DynamicResource Radius.Control}" Visibility="{Binding HasFormError, Converter={StaticResource BoolToVisibility}}" AutomationProperties.LiveSetting="Assertive">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:Icon Kind="Alert" Size="16" Foreground="{DynamicResource Brush.Critical}" VerticalAlignment="Top" Margin="{DynamicResource Inset.R8}" />
            <TextBlock Grid.Column="1" Style="{DynamicResource Text.Body}" Text="{Binding FormError}" TextWrapping="Wrap" />
          </Grid>
        </controls:CrispBorder>
        <TextBlock Style="{DynamicResource Text.Caption}" Foreground="{DynamicResource Brush.Critical}" Text="{Binding ErrorSummary}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
      </StackPanel>
      <ScrollViewer x:Name="FieldsScroll" Grid.Row="2" Style="{DynamicResource ScrollViewer.Panel}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <ContentControl Focusable="False" IsTabStop="False" Margin="{StaticResource Editor.FieldsPad}" Content="{Binding Fields, RelativeSource={RelativeSource AncestorType=UserControl}}" />
      </ScrollViewer>
      <Border Grid.Row="3" BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="0,1,0,0" Padding="{StaticResource Editor.Footer}" SnapsToDevicePixels="True">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="CancelButton" Style="{DynamicResource Button.Secondary}" Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" Margin="{DynamicResource Inset.R8}"
                  AutomationProperties.Name="Cancel" ToolTip="Cancel (Esc)" />
          <Button x:Name="SaveButton" Style="{DynamicResource Button.Primary}" Content="{Binding SaveText}" Command="{Binding SaveCommand}" IsDefault="True" ToolTip="Ctrl+S"
                  controls:ButtonAssist.IsBusy="{Binding SaveCommand.IsRunning}" controls:ButtonAssist.BusyText="{Binding SaveBusyText}" AutomationProperties.Name="{Binding SaveText}" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</UserControl>
