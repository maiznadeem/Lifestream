<UserControl x:Class="Lifestream.Desktop.Features.ListScreens.ListToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Lifestream.Desktop.Controls"
             Focusable="False" IsTabStop="False">
  <!-- The search box, the blood type filter, "Clear filters" and the primary "Add" action. The data context is the list view model. -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </UserControl.Resources>
  <Grid KeyboardNavigation.TabNavigation="Local">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" MinWidth="220" MaxWidth="360" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <controls:FormField Label="Search" Margin="0,0,16,0" MinWidth="220">
      <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="Search">
        <TextBox.InputBindings>
          <KeyBinding Key="Enter" Command="{Binding SearchNowCommand}" />
        </TextBox.InputBindings>
      </TextBox>
    </controls:FormField>
    <controls:FormField Grid.Column="1" Label="Blood type" Margin="0,0,16,0">
      <ComboBox x:Name="BloodTypeBox" ItemsSource="{Binding BloodTypeOptions}" SelectedItem="{Binding BloodTypeFilter, Mode=TwoWay}" DisplayMemberPath="Display"
                MinWidth="160" AutomationProperties.Name="Blood type" />
    </controls:FormField>
    <Button Grid.Column="2" Style="{DynamicResource Button.Ghost}" Content="Clear filters" Command="{Binding ClearFiltersCommand}" VerticalAlignment="Bottom" Margin="0,0,0,16"
            Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Clear filters" />
    <Button x:Name="AddButton" Grid.Column="4" Style="{DynamicResource Button.Primary}" Command="{Binding AddCommand}" VerticalAlignment="Bottom" Margin="0,0,0,16"
            AutomationProperties.Name="{Binding NewActionLabel}" ToolTip="Ctrl+N">
      <StackPanel Orientation="Horizontal">
        <controls:IconText Style="{DynamicResource Text.Icon}" Text="&#xE710;" Margin="0,0,8,0" VerticalAlignment="Center" />
        <TextBlock Text="{Binding NewActionLabel}" VerticalAlignment="Center" />
      </StackPanel>
    </Button>
  </Grid>
</UserControl>
