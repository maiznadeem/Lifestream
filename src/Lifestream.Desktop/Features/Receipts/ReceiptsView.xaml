<UserControl x:Class="Lifestream.Desktop.Features.Receipts.ReceiptsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Lifestream.Desktop.Controls"
             xmlns:feat="clr-namespace:Lifestream.Desktop.Features"
             xmlns:lists="clr-namespace:Lifestream.Desktop.Features.ListScreens"
             Focusable="False">
  <!-- Receipts: text search, kind and blood type filters, the list (names with ids as secondary text; a row opens the printable receipt) and on the right the receipt's facts. Receipts are issued from appointments and requests, so there is no add button. -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <Style x:Key="RecordLink" TargetType="Hyperlink">
      <Setter Property="Foreground" Value="{DynamicResource Brush.StatusInfo}" />
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <WrapPanel KeyboardNavigation.TabNavigation="Local">
      <controls:FormField Label="Search" feat:Edge.Right="{DynamicResource Space.16}" MinWidth="240" Hint="Receipt number, donor or patient name">
        <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="Search receipts">
          <TextBox.InputBindings>
            <KeyBinding Key="Enter" Command="{Binding SearchNowCommand}" />
          </TextBox.InputBindings>
        </TextBox>
      </controls:FormField>
      <controls:FormField Label="Receipts" feat:Edge.Right="{DynamicResource Space.16}">
        <ComboBox x:Name="KindBox" ItemsSource="{Binding KindOptions}" SelectedItem="{Binding KindFilter, Mode=TwoWay}" DisplayMemberPath="Display" MinWidth="150" AutomationProperties.Name="Kind of receipt" />
      </controls:FormField>
      <controls:FormField Label="Blood type" feat:Edge.Right="{DynamicResource Space.16}">
        <ComboBox x:Name="BloodTypeBox" ItemsSource="{Binding BloodTypeOptions}" SelectedItem="{Binding BloodTypeFilter, Mode=TwoWay}" DisplayMemberPath="Display" MinWidth="150" AutomationProperties.Name="Blood type" />
      </controls:FormField>
      <Button Style="{DynamicResource Button.Ghost}" Content="Clear filters" Command="{Binding ClearFiltersCommand}" VerticalAlignment="Bottom" feat:Edge.Bottom="{DynamicResource Space.16}"
              Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Clear filters" />
    </WrapPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="360" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="360" />
      </Grid.ColumnDefinitions>
      <controls:LoadSurface x:Name="ListSurface" State="{Binding State}" SkeletonKind="List" SkeletonColumns="130,90,2*,80,60,*"
                            ErrorMessage="{Binding ErrorMessage}" ErrorDetail="{Binding ErrorDetail}" RetryCommand="{Binding RetryCommand}"
                            EmptyGlyph="&#xE8A5;" EmptyTitle="{Binding EmptyTitle}" EmptyMessage="{Binding EmptyMessage}" EmptyActionText="{Binding EmptyActionText}"
                            EmptyActionCommand="{Binding EmptyActionCommand}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <controls:LifestreamDataGrid x:Name="Grid" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" SortCommand="{Binding SortCommand}"
                                       SortColumn="{Binding SortColumn, Mode=OneWay}" SortDescending="{Binding SortDescending, Mode=OneWay}"
                                       AutomationProperties.Name="Receipts" MouseDoubleClick="OnRowDoubleClick" KeyDown="OnGridKeyDown">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="Date" Width="130" SortMemberPath="date">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding WhenText}" Style="{DynamicResource DataGrid.TextCell}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Receipt" Width="90" CanUserSort="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding KindText}" Style="{DynamicResource DataGrid.TextCell}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Donor or patient" Width="2*" MinWidth="170" CanUserSort="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel VerticalAlignment="Center" feat:Edge.Left="{DynamicResource Space.12}" feat:Edge.Right="{DynamicResource Space.12}">
                      <TextBlock TextTrimming="CharacterEllipsis">
                        <Hyperlink Style="{StaticResource RecordLink}" Command="{Binding DataContext.OpenPartyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"
                                   AutomationProperties.Name="Open record">
                          <Run Text="{Binding PartyName, Mode=OneWay}" />
                        </Hyperlink>
                      </TextBlock>
                      <TextBlock Style="{DynamicResource Text.Caption}" Foreground="{DynamicResource Brush.TextMuted}">
                        <Run Text="{Binding SourceKindText, Mode=OneWay}" /> <Run Text="{Binding SourceIdText, Mode=OneWay}" />
                      </TextBlock>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Blood" Width="80" CanUserSort="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding BloodTypeText}" Style="{DynamicResource DataGrid.TextCell}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Units" Width="60" CanUserSort="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding UnitsText}" Style="{DynamicResource DataGrid.TextCell}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Issued by" Width="*" MinWidth="130" CanUserSort="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel VerticalAlignment="Center" feat:Edge.Left="{DynamicResource Space.12}" feat:Edge.Right="{DynamicResource Space.12}">
                      <TextBlock Style="{DynamicResource Text.Body}" Text="{Binding StaffName}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Style="{DynamicResource Text.Caption}" Foreground="{DynamicResource Brush.TextMuted}" Text="{Binding StaffIdText}" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </controls:LifestreamDataGrid>
          <lists:ListFooter Grid.Row="1" />
        </Grid>
      </controls:LoadSurface>

      <lists:ActionDetailPane Grid.Column="2">
        <lists:ActionDetailPane.Actions>
          <WrapPanel>
            <Button Style="{DynamicResource Button.Primary}" Command="{Binding OpenReceiptCommand}" feat:Edge.Right="{DynamicResource Space.8}" feat:Edge.Bottom="{DynamicResource Space.8}"
                    AutomationProperties.Name="Open receipt to print">
              <StackPanel Orientation="Horizontal">
                <controls:IconText Style="{DynamicResource Text.Icon}" Text="&#xE749;" feat:Edge.Right="{DynamicResource Space.8}" VerticalAlignment="Center" />
                <TextBlock Text="Open and print" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </WrapPanel>
        </lists:ActionDetailPane.Actions>
      </lists:ActionDetailPane>
    </Grid>
  </Grid>
</UserControl>
