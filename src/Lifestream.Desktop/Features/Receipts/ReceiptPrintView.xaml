<UserControl x:Class="Lifestream.Desktop.Features.Receipts.ReceiptPrintView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" IsTabStop="False">
  <!-- The printable receipt: the same FlowDocument that is sent to the printer, shown as a white page. -->
  <FlowDocumentScrollViewer x:Name="Viewer" ContextMenu="{DynamicResource ContextMenu.Document}" IsToolBarVisible="False" VerticalScrollBarVisibility="Auto" Focusable="True" AutomationProperties.Name="Receipt" />
</UserControl>
