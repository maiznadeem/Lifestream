<UserControl x:Class="Lifestream.Desktop.Features.Receipts.ReceiptViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Lifestream.Desktop.Controls"
             xmlns:feat="clr-namespace:Lifestream.Desktop.Features"
             xmlns:dialogs="clr-namespace:Lifestream.Desktop.Features.Dialogs"
             xmlns:receipts="clr-namespace:Lifestream.Desktop.Features.Receipts"
             Focusable="False" IsTabStop="False">
  <!-- The receipt dialog (direction A DialogSurface): Print and Save as PDF above the printable page. They can be used again and again, so a duplicate receipt can always be produced. The data context is the ReceiptViewerViewModel. -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </UserControl.Resources>
  <dialogs:DialogFrame>
    <dialogs:DialogFrame.Fields>
      <Grid MinHeight="360">
        <controls:Skeleton Kind="Detail" Visibility="{Binding ShowSkeleton, Converter={StaticResource BoolToVisibility}}" />
        <controls:ErrorState Message="{Binding ErrorMessage}" Detail="{Binding ErrorDetail}" RetryCommand="{Binding RetryCommand}" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
        <Grid Visibility="{Binding IsReady, Converter={StaticResource BoolToVisibility}}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" feat:Edge.Bottom="{DynamicResource Space.12}">
            <Button Style="{DynamicResource Button.Primary}" Command="{Binding PrintCommand}" feat:Edge.Right="{DynamicResource Space.8}" AutomationProperties.Name="Print"
                    controls:ButtonAssist.IsBusy="{Binding PrintCommand.IsRunning}" controls:ButtonAssist.BusyText="Printing">
              <StackPanel Orientation="Horizontal">
                <controls:Icon Kind="Print" Size="16" feat:Edge.Right="{DynamicResource Space.8}" VerticalAlignment="Center" />
                <TextBlock Text="Print" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Style="{DynamicResource Button.Secondary}" Command="{Binding SavePdfCommand}" AutomationProperties.Name="Save as PDF"
                    controls:ButtonAssist.IsBusy="{Binding SavePdfCommand.IsRunning}" controls:ButtonAssist.BusyText="Saving">
              <StackPanel Orientation="Horizontal">
                <controls:Icon Kind="Receipt" Size="16" feat:Edge.Right="{DynamicResource Space.8}" VerticalAlignment="Center" />
                <TextBlock Text="Save as PDF" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <TextBlock Style="{DynamicResource Text.Body}" Foreground="{DynamicResource Brush.Success}" Text="{Binding Notice}" VerticalAlignment="Center" feat:Edge.Left="{DynamicResource Space.12}"
                       Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" MaxWidth="260" />
          </StackPanel>
          <!-- The page as it prints: white paper with dark text in either theme. -->
          <controls:CrispBorder Grid.Row="1" BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Small}" ClipToBounds="True">
            <receipts:ReceiptPrintView Receipt="{Binding Document}" />
          </controls:CrispBorder>
        </Grid>
      </Grid>
    </dialogs:DialogFrame.Fields>
  </dialogs:DialogFrame>
</UserControl>
