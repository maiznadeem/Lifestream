<UserControl x:Class="Lifestream.Desktop.Features.Profile.ChangePasswordDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Lifestream.Desktop.Controls"
             xmlns:feat="clr-namespace:Lifestream.Desktop.Features"
             xmlns:dialogs="clr-namespace:Lifestream.Desktop.Features.Dialogs"
             Focusable="False" IsTabStop="False">
  <!-- The change-password dialog: current, new and confirm passwords, all masked. It never touches the photo. The data context is the ChangePasswordDialogViewModel. -->
  <dialogs:DialogFrame>
    <dialogs:DialogFrame.Fields>
      <StackPanel>
        <TextBlock Style="{DynamicResource Text.Body}" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding Explanation}" TextWrapping="Wrap" feat:Edge.Bottom="{DynamicResource Space.16}" />
        <controls:FormField Label="Current password (required)" IsRequired="True" controls:FormFocus.FieldName="CurrentPassword" Error="{Binding [CurrentPassword]}">
          <controls:PasswordField Password="{Binding CurrentPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Current password" />
        </controls:FormField>
        <controls:FormField Label="New password (required)" IsRequired="True" Hint="At least 12 characters" controls:FormFocus.FieldName="NewPassword" Error="{Binding [NewPassword]}">
          <controls:PasswordField Password="{Binding NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="New password" />
        </controls:FormField>
        <controls:FormField Label="Confirm new password (required)" IsRequired="True" controls:FormFocus.FieldName="ConfirmPassword" Error="{Binding [ConfirmPassword]}">
          <controls:PasswordField Password="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ShowToggle="False" AutomationProperties.Name="Confirm new password" />
        </controls:FormField>
      </StackPanel>
    </dialogs:DialogFrame.Fields>
  </dialogs:DialogFrame>
</UserControl>
