<UserControl x:Class="Lifestream.Desktop.Features.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Lifestream.Desktop.Controls"
             xmlns:shell="clr-namespace:Lifestream.Desktop.Shell"
             xmlns:services="clr-namespace:Lifestream.Desktop.Services"
             xmlns:dashboard="clr-namespace:Lifestream.Client.Features.Dashboard;assembly=Lifestream.Client"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             controls:ShellPage.OwnsHeader="True" Focusable="False">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <services:ZeroToVisibleConverter x:Key="ZeroToVisible" />

    <!-- One "Needs attention" row: a tinted icon tile, the problem in SemiBold, why it matters, and the one action. -->
    <DataTemplate x:Key="AttentionRow" DataType="{x:Type dashboard:AttentionItem}">
      <Grid x:Name="Row" Margin="0,0,0,0" AutomationProperties.Name="{Binding AutomationName}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border x:Name="Tile" Width="34" Height="34" CornerRadius="{DynamicResource Radius.Control}" Background="{DynamicResource Brush.CriticalSoft}" Margin="0,0,14,0" VerticalAlignment="Center">
          <controls:Icon x:Name="TileIcon" Kind="{Binding Icon}" Size="18" Foreground="{DynamicResource Brush.Critical}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Style="{DynamicResource Text.BodyStrong}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
          <TextBlock Style="{DynamicResource Text.Secondary}" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Detail}" />
        </StackPanel>
        <Button Grid.Column="2" Style="{DynamicResource Button.Secondary.Small}" Content="{Binding ActionText}" Margin="14,0,0,0" VerticalAlignment="Center"
                Command="{Binding DataContext.RunAttentionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                AutomationProperties.Name="{Binding ActionText}" AutomationProperties.HelpText="{Binding Title}" />
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Kind}" Value="{x:Static dashboard:AttentionKind.Warning}">
          <Setter TargetName="Tile" Property="Background" Value="{DynamicResource Brush.WarningSoft}" />
          <Setter TargetName="TileIcon" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="{x:Static dashboard:AttentionKind.Info}">
          <Setter TargetName="Tile" Property="Background" Value="{DynamicResource Brush.InfoSoft}" />
          <Setter TargetName="TileIcon" Property="Foreground" Value="{DynamicResource Brush.Info}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- One row of today's appointments: time, a done tick or an open ring, the name, badges and the blood group. The next one is highlighted. -->
    <DataTemplate x:Key="TodayRow" DataType="{x:Type dashboard:TodayAppointment}">
      <Border x:Name="Row" Height="34" Margin="-10,0,-10,0" Padding="10,0,10,0" CornerRadius="{DynamicResource Radius.Control}" Background="Transparent"
              AutomationProperties.Name="{Binding AutomationName}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="Time" Text="{Binding Time}" FontSize="{DynamicResource FontSize.Label}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Ink}" />
          <Grid Grid.Column="1" Width="16" Height="16" Margin="12,0,12,0" VerticalAlignment="Center">
            <Ellipse x:Name="Ring" Stroke="{DynamicResource Brush.Stroke2}" StrokeThickness="1.5" />
            <controls:Icon x:Name="Tick" Kind="Checkc" Size="16" Foreground="{DynamicResource Brush.Success}" Visibility="Collapsed" />
          </Grid>
          <TextBlock x:Name="Name" Grid.Column="2" Text="{Binding DonorName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Foreground="{DynamicResource Brush.Ink}" />
          <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
            <controls:Badge x:Name="FirstTime" Text="First-time" Kind="Info" Margin="8,0,0,0" Visibility="{Binding IsFirstTime, Converter={StaticResource BoolToVisibility}}" />
            <controls:Badge x:Name="Next" Text="Next" Kind="Neutral" Margin="8,0,0,0" Visibility="{Binding IsNext, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
          <controls:BloodGroupTag Grid.Column="4" Text="{Binding Group}" Margin="12,0,0,0" VerticalAlignment="Center" />
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsDone}" Value="True">
          <Setter TargetName="Time" Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
          <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
          <Setter TargetName="Ring" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsNext}" Value="True">
          <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.Selected}" />
          <Setter TargetName="Time" Property="FontWeight" Value="SemiBold" />
          <Setter TargetName="Name" Property="FontWeight" Value="SemiBold" />
          <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Brush.Ink}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- One stock meter: the group tag, the meter (fill, hatched expiring share, minimum tick) and the count. -->
    <DataTemplate x:Key="MeterRow" DataType="{x:Type dashboard:StockMeter}">
      <Grid Height="33" AutomationProperties.Name="{Binding AutomationName}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="72" />
        </Grid.ColumnDefinitions>
        <controls:BloodGroupTag Text="{Binding Group}" VerticalAlignment="Center" Margin="0,0,14,0" />
        <controls:MeterBar x:Name="Bar" Grid.Column="1" VerticalAlignment="Center" Value="{Binding FillFraction}" Hatched="{Binding ExpiringFraction}" Minimum="{Binding MinimumFraction}"
                           Track="{DynamicResource Brush.Layer2}" TrackStroke="{DynamicResource Brush.Stroke}" Fill="{DynamicResource Brush.Ink2}" Hatch="{DynamicResource Brush.WarningHatch}"
                           Tick="{DynamicResource Brush.Ink3}" />
        <TextBlock x:Name="Count" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular">
          <Run x:Name="Number" Text="{Binding CountText, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" " /><Run Text="{Binding UnitText, Mode=OneWay}" Foreground="{DynamicResource Brush.Ink3}" />
        </TextBlock>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsLow}" Value="True">
          <Setter TargetName="Bar" Property="Fill" Value="{DynamicResource Brush.Critical}" />
          <Setter TargetName="Count" Property="Foreground" Value="{DynamicResource Brush.Critical}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>

  <!-- Direction A dashboard: the date and greeting with the two primary actions, then "Needs attention" beside "Today's appointments", then stock by
       blood group beside donations and issues. The rows share the height (it fits 1280 x 800 without scrolling); a compact window stacks the panels. -->
  <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <controls:LoadSurface x:Name="Surface" State="{Binding State}" SkeletonKind="Dashboard" ErrorMessage="{Binding ErrorMessage}" ErrorDetail="{Binding ErrorDetail}"
                          RetryCommand="{Binding RetryCommand}" MaxWidth="{DynamicResource MaxWidth.Dashboard}" HorizontalAlignment="Stretch">
      <Grid x:Name="Layout" MinHeight="600">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition x:Name="TopRow" Height="330*" />
          <RowDefinition x:Name="StackRow" Height="0" />
          <RowDefinition x:Name="BottomRow" Height="374*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="LeftTop" Width="*" />
          <ColumnDefinition Width="0" />
          <ColumnDefinition x:Name="RightTop" Width="372" />
        </Grid.ColumnDefinitions>

        <controls:PageHeader Grid.ColumnSpan="3" Overline="{Binding DateLine}" Title="{Binding Greeting}" Margin="0,0,0,20">
          <controls:PageHeader.Actions>
            <StackPanel Orientation="Horizontal">
              <Button Style="{DynamicResource Button.Secondary}" Margin="0,0,8,0" AutomationProperties.Name="Book appointment"
                      Command="{Binding DataContext.BookAppointmentCommand, RelativeSource={RelativeSource AncestorType=shell:ShellView}}">
                <StackPanel Orientation="Horizontal">
                  <controls:Icon Kind="Calplus" Size="16" Margin="0,0,8,0" />
                  <TextBlock Text="Book appointment" />
                </StackPanel>
              </Button>
              <Button Style="{DynamicResource Button.Primary}" AutomationProperties.Name="Record donation" AutomationProperties.AcceleratorKey="Ctrl+D" ToolTip="Record donation (Ctrl+D)"
                      Command="{Binding DataContext.RecordDonationCommand, RelativeSource={RelativeSource AncestorType=shell:ShellView}}">
                <StackPanel Orientation="Horizontal">
                  <controls:Icon Kind="Drop" Size="16" Margin="0,0,8,0" />
                  <TextBlock Text="Record donation" />
                </StackPanel>
              </Button>
            </StackPanel>
          </controls:PageHeader.Actions>
        </controls:PageHeader>

        <!-- Needs attention -->
        <controls:Section x:Name="AttentionPanel" Grid.Row="1" Header="Needs attention" Subtitle="{Binding AttentionCountText}" Padding="0,0,0,8" Margin="0,0,20,20">
          <Grid>
            <ItemsControl x:Name="AttentionList" ItemsSource="{Binding Attention}" Focusable="False" AutomationProperties.Name="Needs attention">
              <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                  <Setter Property="Margin" Value="0" />
                </Style>
              </ItemsControl.ItemContainerStyle>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border x:Name="Divider" BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="0,1,0,0" Padding="18,12,18,12">
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource AttentionRow}" />
                  </Border>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                      <Setter TargetName="Divider" Property="BorderThickness" Value="0" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{DynamicResource Text.Secondary}" Margin="18,4,18,12" Text="Nothing needs attention right now: stock covers every open request and nothing expires this week."
                       Visibility="{Binding Attention.Count, Converter={StaticResource ZeroToVisible}}" />
          </Grid>
        </controls:Section>

        <!-- Today's appointments -->
        <controls:Section x:Name="TodayPanel" Grid.Row="1" Grid.Column="2" Header="Today&#x2019;s appointments" Padding="18,0,18,0" Margin="0,0,0,20">
          <controls:Section.HeaderActions>
            <TextBlock Text="{Binding TodaySeenText}" FontSize="{DynamicResource FontSize.Label}" Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center" />
          </controls:Section.HeaderActions>
          <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
              <ItemsControl x:Name="TodayList" ItemsSource="{Binding Today}" ItemTemplate="{StaticResource TodayRow}" Focusable="False" AutomationProperties.Name="Today's appointments" />
            </ScrollViewer>
            <StackPanel Visibility="{Binding Today.Count, Converter={StaticResource ZeroToVisible}}" Margin="0,4,0,0">
              <TextBlock Style="{DynamicResource Text.Secondary}" Text="Nobody is booked for today." />
            </StackPanel>
          </Grid>
        </controls:Section>

        <!-- Stock by blood group, and donations and issues: two equal panels. -->
        <Grid x:Name="BottomGrid" Grid.Row="3" Grid.ColumnSpan="3">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition x:Name="StockRow" Height="*" />
            <RowDefinition x:Name="ChartGap" Height="0" />
            <RowDefinition x:Name="ChartRow" Height="0" />
          </Grid.RowDefinitions>

          <controls:Section x:Name="StockPanel" Header="Stock by blood group" Subtitle="{Binding StockTotalText}" Padding="18,6,18,14">
            <controls:Section.HeaderActions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" TextElement.FontSize="{DynamicResource FontSize.Caption}" TextElement.Foreground="{DynamicResource Brush.Ink3}">
                <Border Width="12" Height="8" CornerRadius="2" Background="{DynamicResource Brush.WarningHatch}" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="Expiring in 7 days" VerticalAlignment="Center" />
                <Rectangle Width="1.5" Height="12" Fill="{DynamicResource Brush.Ink3}" Margin="10,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding MinimumText}" VerticalAlignment="Center" />
              </StackPanel>
            </controls:Section.HeaderActions>
            <ItemsControl x:Name="StockList" ItemsSource="{Binding StockMeters}" ItemTemplate="{StaticResource MeterRow}" Focusable="False" AutomationProperties.Name="Stock by blood group" />
          </controls:Section>

          <controls:ChartFrame x:Name="DonationsFrame" Grid.Column="2" Title="Donations and issues" Table="{Binding DonationsTable}" Padding="6,4,10,6">
            <controls:ChartFrame.Legend>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" TextElement.FontSize="{DynamicResource FontSize.Caption}" TextElement.Foreground="{DynamicResource Brush.Ink2}">
                <Rectangle Width="14" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource Brush.Chart1}" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="Donated" VerticalAlignment="Center" Margin="0,0,14,0" />
                <Rectangle Width="14" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource Brush.Chart2}" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="Issued" VerticalAlignment="Center" />
              </StackPanel>
            </controls:ChartFrame.Legend>
            <lvc:CartesianChart x:Name="DonationsChart" Background="{DynamicResource Brush.Layer}" TooltipPosition="Hidden" LegendPosition="Hidden" ZoomMode="None" MinHeight="200"
                                AutomationProperties.Name="Donations and issues by month, last 12 months" />
          </controls:ChartFrame>
        </Grid>
      </Grid>
    </controls:LoadSurface>
  </ScrollViewer>
</UserControl>
