<UserControl x:Class="Lifestream.Desktop.Features.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Lifestream.Desktop.Controls"
             xmlns:shell="clr-namespace:Lifestream.Desktop.Shell"
             xmlns:services="clr-namespace:Lifestream.Desktop.Services"
             xmlns:dashboard="clr-namespace:Lifestream.Client.Features.Dashboard;assembly=Lifestream.Client"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             controls:ShellPage.OwnsHeader="True" FontFamily="{DynamicResource Font.Family}" FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource Brush.Ink}" Focusable="False">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <services:ZeroToVisibleConverter x:Key="ZeroToVisible" />
    <controls:KeepGroupsTogetherConverter x:Key="KeepGroups" />

    <!-- One "Needs attention" row: a tinted icon tile, the problem in SemiBold, why it matters, and the one action. -->
    <DataTemplate x:Key="AttentionRow" DataType="{x:Type dashboard:AttentionItem}">
      <Grid x:Name="Row" Margin="0,0,0,0" AutomationProperties.Name="{Binding AutomationName}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border x:Name="Tile" Width="34" Height="34" CornerRadius="{DynamicResource Radius.Control}" Background="{DynamicResource Brush.CriticalSoft}" Margin="{DynamicResource Inset.R14}" VerticalAlignment="Center">
          <controls:Icon x:Name="TileIcon" Kind="{Binding Icon}" Size="18" Foreground="{DynamicResource Brush.Critical}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock x:Name="Title" Style="{DynamicResource Text.BodyStrong}" Text="{Binding Title}" TextWrapping="Wrap" />
          <!-- Why it matters: up to two lines (2 x 18); a longer one ends in an ellipsis and the tooltip has it whole. -->
          <TextBlock x:Name="Detail" Style="{DynamicResource Text.Secondary}" Text="{Binding Detail, Converter={StaticResource KeepGroups}}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36" ToolTip="{Binding Detail}" />
        </StackPanel>
        <Button Grid.Column="2" Style="{DynamicResource Button.Secondary.Small}" Content="{Binding ActionText}" Margin="{DynamicResource Inset.L14}" VerticalAlignment="Center"
                Command="{Binding DataContext.RunAttentionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                AutomationProperties.Name="{Binding ActionText}" AutomationProperties.HelpText="{Binding Title}" />
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Kind}" Value="{x:Static dashboard:AttentionKind.Warning}">
          <Setter TargetName="Tile" Property="Background" Value="{DynamicResource Brush.WarningSoft}" />
          <Setter TargetName="TileIcon" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="{x:Static dashboard:AttentionKind.Info}">
          <Setter TargetName="Tile" Property="Background" Value="{DynamicResource Brush.InfoSoft}" />
          <Setter TargetName="TileIcon" Property="Foreground" Value="{DynamicResource Brush.Info}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- One row of today's appointments: time, a done tick or an open ring, the name, badges and the blood group. The next one is highlighted. -->
    <DataTemplate x:Key="TodayRow" DataType="{x:Type dashboard:TodayAppointment}">
      <Border x:Name="Row" Height="34" Margin="{DynamicResource Inset.HN10}" Padding="{DynamicResource Inset.H10}" CornerRadius="{DynamicResource Radius.Control}" Background="Transparent"
              AutomationProperties.Name="{Binding AutomationName}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="Time" Text="{Binding Time}" FontSize="{DynamicResource FontSize.Label}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Ink}" />
          <Grid Grid.Column="1" Width="16" Height="16" Margin="{DynamicResource Inset.H12}" VerticalAlignment="Center">
            <Ellipse x:Name="Ring" Stroke="{DynamicResource Brush.Stroke2}" StrokeThickness="1.5" />
            <controls:Icon x:Name="Tick" Kind="Checkc" Size="16" Foreground="{DynamicResource Brush.Success}" Visibility="Collapsed" />
          </Grid>
          <TextBlock x:Name="Name" Grid.Column="2" Text="{Binding DonorName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Foreground="{DynamicResource Brush.Ink}" />
          <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
            <controls:Badge x:Name="FirstTime" Text="First-time" Kind="Info" Margin="{DynamicResource Inset.L8}" Visibility="{Binding IsFirstTime, Converter={StaticResource BoolToVisibility}}" />
            <controls:Badge x:Name="Next" Text="Next" Kind="Neutral" Margin="{DynamicResource Inset.L8}" Visibility="{Binding IsNext, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
          <controls:BloodGroupTag Grid.Column="4" Text="{Binding Group}" Margin="{DynamicResource Inset.L12}" VerticalAlignment="Center" />
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsDone}" Value="True">
          <Setter TargetName="Time" Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
          <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
          <Setter TargetName="Ring" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsNext}" Value="True">
          <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.Selected}" />
          <Setter TargetName="Time" Property="FontWeight" Value="SemiBold" />
          <Setter TargetName="Name" Property="FontWeight" Value="SemiBold" />
          <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Brush.Ink}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- One stock meter: the group tag, the meter (fill, hatched expiring share, minimum tick) and the count. -->
    <DataTemplate x:Key="MeterRow" DataType="{x:Type dashboard:StockMeter}">
      <Grid MinHeight="30" AutomationProperties.Name="{Binding AutomationName}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" SharedSizeGroup="MeterTag" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="72" />
        </Grid.ColumnDefinitions>
        <controls:BloodGroupTag Text="{Binding Group}" VerticalAlignment="Center" Margin="{DynamicResource Inset.R14}" />
        <controls:MeterBar x:Name="Bar" Grid.Column="1" VerticalAlignment="Center" Value="{Binding FillFraction}" Hatched="{Binding ExpiringFraction}" Minimum="{Binding MinimumFraction}"
                           Track="{DynamicResource Brush.Layer2}" TrackStroke="{DynamicResource Brush.Stroke}" Fill="{DynamicResource Brush.Ink2}" Hatch="{DynamicResource Brush.WarningHatch}"
                           Tick="{DynamicResource Brush.Ink3}" />
        <!-- Proportional figures: Onest's tabular 1 is as wide as an 8, which reads as a gap in "17 units". The counts still line up on their right edge. -->
        <TextBlock x:Name="Count" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Run x:Name="Number" Text="{Binding CountText, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" " /><Run Text="{Binding UnitText, Mode=OneWay}" Foreground="{DynamicResource Brush.Ink3}" />
        </TextBlock>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsLow}" Value="True">
          <Setter TargetName="Bar" Property="Fill" Value="{DynamicResource Brush.Critical}" />
          <Setter TargetName="Count" Property="Foreground" Value="{DynamicResource Brush.Critical}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>

  <!-- Direction A dashboard: the date and greeting with the two primary actions, then "Needs attention" beside "Today's appointments", then stock by
       blood group beside donations and issues. The top row is as tall as its content and the bottom row takes the rest of the page (it fits 1280 x 800
       without scrolling); a compact window stacks the panels at their own heights and only the page scrolls. The page's scroll bar sits in the page's
       right padding (Inset.RN14 and Inset.R14), beside the panels. -->
  <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Margin="{DynamicResource Inset.RN14}">
    <controls:LoadSurface x:Name="Surface" State="{Binding State}" SkeletonKind="Dashboard" ErrorMessage="{Binding ErrorMessage}" ErrorDetail="{Binding ErrorDetail}"
                          RetryCommand="{Binding RetryCommand}" MaxWidth="{DynamicResource MaxWidth.Dashboard}" HorizontalAlignment="Stretch" Margin="{DynamicResource Inset.R14}">
      <Grid x:Name="Layout">
        <Grid.RowDefinitions>
          <RowDefinition x:Name="HeaderRow" Height="Auto" />
          <RowDefinition x:Name="TopRow" Height="Auto" />
          <RowDefinition x:Name="StackRow" Height="0" />
          <RowDefinition x:Name="BottomRow" Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="LeftTop" Width="*" />
          <ColumnDefinition Width="0" />
          <ColumnDefinition x:Name="RightTop" Width="372" />
        </Grid.ColumnDefinitions>

        <controls:PageHeader Grid.ColumnSpan="3" Overline="{Binding DateLine}" Title="{Binding Greeting}" Margin="{DynamicResource Inset.B20}">
          <controls:PageHeader.Actions>
            <StackPanel Orientation="Horizontal">
              <Button Style="{DynamicResource Button.Secondary}" Margin="{DynamicResource Inset.R8}" AutomationProperties.Name="Book appointment"
                      Command="{Binding DataContext.BookAppointmentCommand, RelativeSource={RelativeSource AncestorType=shell:ShellView}}">
                <StackPanel Orientation="Horizontal">
                  <controls:Icon Kind="Calplus" Size="16" Margin="{DynamicResource Inset.R8}" />
                  <TextBlock Text="Book appointment" />
                </StackPanel>
              </Button>
              <Button Style="{DynamicResource Button.Primary}" AutomationProperties.Name="Record donation" AutomationProperties.AcceleratorKey="Ctrl+D" ToolTip="Record donation (Ctrl+D)"
                      Command="{Binding DataContext.RecordDonationCommand, RelativeSource={RelativeSource AncestorType=shell:ShellView}}">
                <StackPanel Orientation="Horizontal">
                  <controls:Icon Kind="Drop" Size="16" Margin="{DynamicResource Inset.R8}" />
                  <TextBlock Text="Record donation" />
                </StackPanel>
              </Button>
            </StackPanel>
          </controls:PageHeader.Actions>
        </controls:PageHeader>

        <!-- Needs attention -->
        <controls:Section x:Name="AttentionPanel" Grid.Row="1" Header="Needs attention" Subtitle="{Binding AttentionCountText}" Padding="{DynamicResource Inset.B8}" Margin="{DynamicResource Inset.R20B20}">
          <!-- When the window has no room for every row, the list shows the most urgent ones, the count says "4 of 5", and this shows the rest (the page then scrolls). -->
          <controls:Section.HeaderActions>
            <Button x:Name="AttentionToggle" Style="{DynamicResource Button.Subtle.Small}" Content="{Binding AttentionToggleText}" Command="{Binding ToggleAttentionCommand}"
                    Visibility="{Binding CanToggleAttention, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{Binding AttentionToggleText}"
                    AutomationProperties.HelpText="Needs attention" />
          </controls:Section.HeaderActions>
          <Grid>
            <ItemsControl x:Name="AttentionList" ItemsSource="{Binding VisibleAttention}" Focusable="False" AutomationProperties.Name="Needs attention">
              <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                  <Setter Property="Margin" Value="0" />
                </Style>
              </ItemsControl.ItemContainerStyle>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border x:Name="Divider" BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="0,1,0,0" Padding="{DynamicResource Inset.H18V12}">
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource AttentionRow}" />
                  </Border>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                      <Setter TargetName="Divider" Property="BorderThickness" Value="0" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{DynamicResource Text.Secondary}" Margin="{DynamicResource Inset.L18T4R18B12}" Text="Nothing needs attention right now: stock covers every open request and nothing expires this week."
                       Visibility="{Binding Attention.Count, Converter={StaticResource ZeroToVisible}}" />
          </Grid>
        </controls:Section>

        <!-- Today's appointments -->
        <controls:Section x:Name="TodayPanel" Grid.Row="1" Grid.Column="2" Header="Today&#x2019;s appointments" Padding="0" Margin="{DynamicResource Inset.B20}">
          <controls:Section.HeaderActions>
            <TextBlock Text="{Binding TodaySeenText}" FontSize="{DynamicResource FontSize.Label}" Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center" />
          </controls:Section.HeaderActions>
          <Grid>
            <!-- Beside "Needs attention" the list asks for eight rows at most (8 x 34) and scrolls inside the panel when the day has more; stacked in a
                 compact window it is as tall as its rows (the cap is lifted in code) and only the page scrolls. The list keeps 18 at both sides inside
                 the scroll viewer: the highlighted row reaches 10 past the text, and the scroll bar's strip lies in the right 18, beside the tags. -->
            <controls:CappedHeightBox x:Name="TodayBox" Cap="272">
              <ScrollViewer x:Name="TodayScroll" VerticalScrollBarVisibility="Auto" Focusable="False">
                <ItemsControl x:Name="TodayList" ItemsSource="{Binding Today}" ItemTemplate="{StaticResource TodayRow}" Focusable="False" Margin="{DynamicResource Inset.H18}"
                              AutomationProperties.Name="Today's appointments" />
              </ScrollViewer>
            </controls:CappedHeightBox>
            <StackPanel Visibility="{Binding Today.Count, Converter={StaticResource ZeroToVisible}}" Margin="{DynamicResource Inset.L18T4R18B12}">
              <TextBlock Style="{DynamicResource Text.Secondary}" Text="Nobody is booked for today." />
            </StackPanel>
          </Grid>
        </controls:Section>

        <!-- Stock by blood group, and donations and issues: two equal panels. -->
        <Grid x:Name="BottomGrid" Grid.Row="3" Grid.ColumnSpan="3">
          <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="StockColumn" Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition x:Name="ChartColumn" Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition x:Name="StockRow" Height="*" />
            <RowDefinition x:Name="ChartGap" Height="0" />
            <RowDefinition x:Name="ChartRow" Height="0" />
          </Grid.RowDefinitions>

          <controls:Section x:Name="StockPanel" Header="Stock by blood group" Subtitle="{Binding StockTotalText}" Padding="{DynamicResource Inset.L18T6R18B14}">
            <controls:Section.HeaderActions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" TextElement.FontSize="{DynamicResource FontSize.Caption}" TextElement.Foreground="{DynamicResource Brush.Ink3}">
                <Border Width="12" Height="8" CornerRadius="{DynamicResource Radius.2}" Background="{DynamicResource Brush.WarningHatch}" Margin="{DynamicResource Inset.R6}" VerticalAlignment="Center" />
                <TextBlock Text="Expiring in 7 days" VerticalAlignment="Center" />
                <Rectangle Width="1.5" Height="12" Fill="{DynamicResource Brush.Ink3}" Margin="{DynamicResource Inset.L10R6}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding MinimumText}" VerticalAlignment="Center" />
              </StackPanel>
            </controls:Section.HeaderActions>
            <!-- The eight meters share the panel's height (no empty band under them) and one tag column (every bar starts at the same x). -->
            <ItemsControl x:Name="StockList" ItemsSource="{Binding StockMeters}" ItemTemplate="{StaticResource MeterRow}" Focusable="False" Grid.IsSharedSizeScope="True"
                          AutomationProperties.Name="Stock by blood group">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="1" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </controls:Section>

          <controls:ChartFrame x:Name="DonationsFrame" Grid.Column="2" Title="Donations and issues" Table="{Binding DonationsTable}" Padding="{DynamicResource Inset.L6T4R10B6}">
            <controls:ChartFrame.Legend>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" TextElement.FontSize="{DynamicResource FontSize.Caption}" TextElement.Foreground="{DynamicResource Brush.Ink2}">
                <Rectangle Width="14" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource Brush.Chart1}" Margin="{DynamicResource Inset.R6}" VerticalAlignment="Center" />
                <TextBlock Text="Donated" VerticalAlignment="Center" Margin="{DynamicResource Inset.R14}" />
                <Rectangle Width="14" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource Brush.Chart2}" Margin="{DynamicResource Inset.R6}" VerticalAlignment="Center" />
                <TextBlock Text="Issued" VerticalAlignment="Center" />
              </StackPanel>
            </controls:ChartFrame.Legend>
            <!-- The chart asks for 200 of height and takes what the row gives it. Left to itself it asks for about 300 when the page is measured, which
                 made the bottom row too tall for a short window and the page scroll for nothing. -->
            <controls:CappedHeightBox Cap="200">
              <lvc:CartesianChart x:Name="DonationsChart" Background="{DynamicResource Brush.Layer}" TooltipPosition="Hidden" LegendPosition="Hidden" ZoomMode="None" MinHeight="200"
                                  AutomationProperties.Name="Donations and issues by month, last 12 months" />
            </controls:CappedHeightBox>
          </controls:ChartFrame>
        </Grid>
      </Grid>
    </controls:LoadSurface>
  </ScrollViewer>
</UserControl>
