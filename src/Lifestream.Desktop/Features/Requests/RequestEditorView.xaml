<UserControl x:Class="Lifestream.Desktop.Features.Requests.RequestEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Lifestream.Desktop.Controls"
             xmlns:feat="clr-namespace:Lifestream.Desktop.Features"
             xmlns:lists="clr-namespace:Lifestream.Desktop.Features.ListScreens"
             xmlns:services="clr-namespace:Lifestream.Desktop.Services"
             Focusable="False" IsTabStop="False">
  <!-- The request form: the patient from a record picker (or their name when editing), the units (digits only) and the date the blood is needed by. The data context is the RequestEditorViewModel. -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <services:InverseBooleanToVisibilityConverter x:Key="InverseBool" />
    <feat:FirstNonEmptyConverter x:Key="FirstNonEmpty" />
  </UserControl.Resources>
  <lists:RecordEditorChrome>
    <lists:RecordEditorChrome.Fields>
      <StackPanel>
        <controls:FormField Label="Patient (required)" IsRequired="True" controls:FormFocus.FieldName="PatientId" Error="{Binding [PatientId]}" Visibility="{Binding ShowPatientPicker, Converter={StaticResource BoolToVisibility}}">
          <controls:RecordPicker Kind="Patient" Label="Patient" SelectedOption="{Binding PatientOption, Mode=TwoWay}" />
        </controls:FormField>
        <StackPanel Visibility="{Binding ShowPatientPicker, Converter={StaticResource InverseBool}}" feat:Edge.Bottom="{DynamicResource Space.16}">
          <TextBlock Style="{DynamicResource Text.Caption}" Foreground="{DynamicResource Brush.TextMuted}" Text="Patient" />
          <TextBlock Style="{DynamicResource Text.Body}" Text="{Binding PatientName}" TextWrapping="Wrap" />
        </StackPanel>
        <controls:FormField Label="Units (required)" IsRequired="True" Hint="A whole number, 1 to 10" controls:FormFocus.FieldName="UnitsText" Error="{Binding [UnitsText]}">
          <TextBox Text="{Binding UnitsText, UpdateSourceTrigger=PropertyChanged}" MaxLength="2" feat:DigitsOnly.IsEnabled="True" AutomationProperties.Name="Units needed" />
        </controls:FormField>
        <controls:FormField Label="Needed by (required)" IsRequired="True" Hint="Format: 05 Mar 2022. Today or later, within a year." controls:FormFocus.FieldName="RequiredBy">
          <controls:FormField.Error>
            <MultiBinding Converter="{StaticResource FirstNonEmpty}">
              <Binding Path="[RequiredBy]" />
              <Binding Path="Content.ParseError" RelativeSource="{RelativeSource Self}" />
            </MultiBinding>
          </controls:FormField.Error>
          <controls:DateField SelectedDate="{Binding RequiredBy, Mode=TwoWay}" MinDate="{Binding EarliestRequiredBy}" MaxDate="{Binding LatestRequiredBy}" AutomationProperties.Name="Date needed by" />
        </controls:FormField>
      </StackPanel>
    </lists:RecordEditorChrome.Fields>
  </lists:RecordEditorChrome>
</UserControl>
