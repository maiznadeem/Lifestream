<UserControl x:Class="Lifestream.Desktop.Features.Requests.RequestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Lifestream.Desktop.Controls"
             xmlns:feat="clr-namespace:Lifestream.Desktop.Features"
             xmlns:lists="clr-namespace:Lifestream.Desktop.Features.ListScreens"
             xmlns:services="clr-namespace:Lifestream.Desktop.Services"
             Focusable="False">
  <!-- Requests: one search box for the patient's name, status and blood type filters, the list (patient name with the id as secondary text, units, needed-by date, status chip) and on the right the request's actions and facts or its form. -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <feat:BloodTypeTextConverter x:Key="BloodTypeText" />
    <feat:DateTextConverter x:Key="DateText" />
    <feat:NullToCollapsedConverter x:Key="NullToCollapsed" />
    <feat:NullToVisibleConverter x:Key="NullToVisible" />
    <feat:RequestStatusKindConverter x:Key="StatusKind" />
    <feat:RequestStatusTextConverter x:Key="StatusText" />
    <feat:LocalWhenConverter x:Key="LocalWhen" />
    <feat:IdTextConverter x:Key="IdText" />
    <Style x:Key="RecordLink" TargetType="Hyperlink">
      <Setter Property="Foreground" Value="{DynamicResource Brush.StatusInfo}" />
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <DockPanel KeyboardNavigation.TabNavigation="Local">
      <Button x:Name="AddButton" DockPanel.Dock="Right" Style="{DynamicResource Button.Primary}" Command="{Binding AddCommand}" VerticalAlignment="Bottom" feat:Edge.Bottom="{DynamicResource Space.16}"
              AutomationProperties.Name="New request" ToolTip="Ctrl+N">
        <StackPanel Orientation="Horizontal">
          <controls:IconText Style="{DynamicResource Text.Icon}" Text="&#xE710;" feat:Edge.Right="{DynamicResource Space.8}" VerticalAlignment="Center" />
          <TextBlock Text="New request" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <WrapPanel>
        <controls:FormField Label="Patient name" feat:Edge.Right="{DynamicResource Space.16}" MinWidth="220">
          <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="Search requests by patient name">
            <TextBox.InputBindings>
              <KeyBinding Key="Enter" Command="{Binding SearchNowCommand}" />
            </TextBox.InputBindings>
          </TextBox>
        </controls:FormField>
        <controls:FormField Label="Status" feat:Edge.Right="{DynamicResource Space.16}">
          <ComboBox x:Name="StatusBox" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding StatusFilter, Mode=TwoWay}" DisplayMemberPath="Display" MinWidth="150" AutomationProperties.Name="Status" />
        </controls:FormField>
        <controls:FormField Label="Blood type" feat:Edge.Right="{DynamicResource Space.16}">
          <ComboBox x:Name="BloodTypeBox" ItemsSource="{Binding BloodTypeOptions}" SelectedItem="{Binding BloodTypeFilter, Mode=TwoWay}" DisplayMemberPath="Display" MinWidth="150" AutomationProperties.Name="Blood type" />
        </controls:FormField>
        <Button Style="{DynamicResource Button.Ghost}" Content="Clear filters" Command="{Binding ClearFiltersCommand}" VerticalAlignment="Bottom" feat:Edge.Bottom="{DynamicResource Space.16}"
                Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Clear filters" />
      </WrapPanel>
    </DockPanel>

    <lists:ScreenWakingNotice Grid.Row="1" />
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="360" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="400" />
      </Grid.ColumnDefinitions>
      <controls:LoadSurface x:Name="ListSurface" State="{Binding State}" SkeletonKind="List" SkeletonColumns="2*,100,70,110,130"
                            ErrorMessage="{Binding ErrorMessage}" ErrorDetail="{Binding ErrorDetail}" RetryCommand="{Binding RetryCommand}"
                            EmptyGlyph="&#xE8F4;" EmptyTitle="{Binding EmptyTitle}" EmptyMessage="{Binding EmptyMessage}" EmptyActionText="{Binding EmptyActionText}"
                            EmptyActionCommand="{Binding EmptyActionCommand}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <controls:LifestreamDataGrid x:Name="Grid" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" SortCommand="{Binding SortCommand}"
                                       SortColumn="{Binding SortColumn, Mode=OneWay}" SortDescending="{Binding SortDescending, Mode=OneWay}"
                                       AutomationProperties.Name="Requests">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="Patient" Width="2*" MinWidth="170" CanUserSort="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel VerticalAlignment="Center" feat:Edge.Left="{DynamicResource Space.12}" feat:Edge.Right="{DynamicResource Space.12}">
                      <TextBlock TextTrimming="CharacterEllipsis">
                        <Hyperlink Style="{StaticResource RecordLink}" Command="{Binding DataContext.OpenPatientCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"
                                   AutomationProperties.Name="Open patient">
                          <Run Text="{Binding PatientName, Mode=OneWay}" />
                        </Hyperlink>
                      </TextBlock>
                      <TextBlock Style="{DynamicResource Text.Caption}" Foreground="{DynamicResource Brush.TextMuted}" Text="{Binding PatientId, Converter={StaticResource IdText}}" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Blood type" Width="100" CanUserSort="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding BloodType, Converter={StaticResource BloodTypeText}}" Style="{DynamicResource DataGrid.TextCell}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Units" Width="70" CanUserSort="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Units}" Style="{DynamicResource DataGrid.TextCell}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Needed by" Width="Auto" MinWidth="110" SortMemberPath="requiredBy">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding RequiredBy, Converter={StaticResource DateText}}" Style="{DynamicResource DataGrid.TextCell}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Status" Width="130" CanUserSort="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <controls:StatusChip Status="{Binding Status, Converter={StaticResource StatusKind}}" Label="{Binding Status, Converter={StaticResource StatusText}}" feat:Edge.Left="{DynamicResource Space.12}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </controls:LifestreamDataGrid>
          <lists:ListFooter Grid.Row="1" />
        </Grid>
      </controls:LoadSurface>

      <Grid Grid.Column="2">
        <lists:ActionDetailPane Visibility="{Binding Editor, Converter={StaticResource NullToVisible}}">
          <lists:ActionDetailPane.Actions>
            <WrapPanel>
              <Button Style="{DynamicResource Button.Primary}" Command="{Binding FulfilCommand}" feat:Edge.Right="{DynamicResource Space.8}" feat:Edge.Bottom="{DynamicResource Space.8}"
                      AutomationProperties.Name="Fulfil request" controls:ButtonAssist.IsBusy="{Binding FulfilCommand.IsRunning}" controls:ButtonAssist.BusyText="Fulfilling...">
                <StackPanel Orientation="Horizontal">
                  <controls:IconText Style="{DynamicResource Text.Icon}" Text="&#xE73E;" feat:Edge.Right="{DynamicResource Space.8}" VerticalAlignment="Center" />
                  <TextBlock Text="Fulfil request" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Style="{DynamicResource Button.Secondary}" Command="{Binding EditRequestCommand}" feat:Edge.Right="{DynamicResource Space.8}" feat:Edge.Bottom="{DynamicResource Space.8}"
                      AutomationProperties.Name="Edit request">
                <StackPanel Orientation="Horizontal">
                  <controls:IconText Style="{DynamicResource Text.Icon}" Text="&#xE70F;" feat:Edge.Right="{DynamicResource Space.8}" VerticalAlignment="Center" />
                  <TextBlock Text="Edit" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Style="{DynamicResource Button.Danger}" Command="{Binding CancelRequestCommand}" feat:Edge.Right="{DynamicResource Space.8}" feat:Edge.Bottom="{DynamicResource Space.8}"
                      AutomationProperties.Name="Cancel request" controls:ButtonAssist.IsBusy="{Binding CancelRequestCommand.IsRunning}" controls:ButtonAssist.BusyText="Cancelling...">
                <StackPanel Orientation="Horizontal">
                  <controls:IconText Style="{DynamicResource Text.Icon}" Text="&#xE711;" feat:Edge.Right="{DynamicResource Space.8}" VerticalAlignment="Center" />
                  <TextBlock Text="Cancel request" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Style="{DynamicResource Button.Secondary}" Command="{Binding ViewReceiptCommand}" feat:Edge.Right="{DynamicResource Space.8}" feat:Edge.Bottom="{DynamicResource Space.8}"
                      AutomationProperties.Name="View receipt">
                <StackPanel Orientation="Horizontal">
                  <controls:IconText Style="{DynamicResource Text.Icon}" Text="&#xE8A5;" feat:Edge.Right="{DynamicResource Space.8}" VerticalAlignment="Center" />
                  <TextBlock Text="View receipt" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </WrapPanel>
          </lists:ActionDetailPane.Actions>
        </lists:ActionDetailPane>
        <ContentControl Content="{Binding Editor}" ContentTemplateSelector="{x:Static services:ViewLocator.Instance}" IsTabStop="False" Focusable="False"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="{Binding Editor, Converter={StaticResource NullToCollapsed}}" />
      </Grid>
    </Grid>
  </Grid>
</UserControl>
