<UserControl x:Class="Lifestream.Desktop.Features.Requests.FulfilRequestDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Lifestream.Desktop.Controls"
             xmlns:lists="clr-namespace:Lifestream.Desktop.Features.ListScreens"
             Focusable="False" IsTabStop="False">
  <!-- The fulfil step of a request, in the Requests side panel (direction A, audit R3): what will be issued, the bags that will go (oldest first: order, bag, where it
       came from, use-by date), how much of that blood is in stock (amber when it is short), the server's message when it refuses, and "Fulfil request" with "Not now",
       which keeps the request as it is. Esc is "Not now" (it leaves the step, not the panel). The data context is the FulfilRequestDialogViewModel. -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <lists:HasContentToVisibleConverter x:Key="HasContent" />
    <lists:FalseToVisibleConverter x:Key="NotVisible" />
    <Thickness x:Key="Fulfil.Pad">16</Thickness>
    <Thickness x:Key="Fulfil.CardPad">12,10,12,10</Thickness>
    <Thickness x:Key="Fulfil.Gap">0,0,0,12</Thickness>
    <Thickness x:Key="Fulfil.IconGap">0,0,8,0</Thickness>
    <Thickness x:Key="Fulfil.BagRow">0,0,0,8</Thickness>
    <Thickness x:Key="Fulfil.OrderGap">0,0,10,0</Thickness>
  </UserControl.Resources>
  <UserControl.InputBindings>
    <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
  </UserControl.InputBindings>
  <Border x:Name="Frame" Background="{DynamicResource Brush.Layer2}" BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Panel}"
          Padding="{StaticResource Fulfil.Pad}" SnapsToDevicePixels="True" AutomationProperties.Name="Fulfil request">
    <StackPanel>
      <TextBlock Style="{DynamicResource Text.Heading}" Text="Fulfil this request" Margin="{StaticResource Fulfil.Gap}" AutomationProperties.HeadingLevel="Level3" />
      <!-- A server that is waking up (the stock check or the fulfil call waits on it): say so, with Cancel -->
      <controls:WakingNotice IsActive="{Binding IsOperationWaking}" CancelCommand="{Binding CancelOperationCommand}" Margin="{StaticResource Fulfil.Gap}" />
      <TextBlock Style="{DynamicResource Text.Body}" TextWrapping="Wrap" Margin="{StaticResource Fulfil.Gap}">
        <Run Text="Issue" /> <Run Text="{Binding UnitsText, Mode=OneWay}" FontWeight="SemiBold" /> <Run Text="of" /> <Run Text="{Binding BloodTypeText, Mode=OneWay}" FontWeight="SemiBold" />
        <Run Text="to" /> <Run Text="{Binding PatientName, Mode=OneWay}" /><Run Text=", needed by" /> <Run Text="{Binding RequiredByText, Mode=OneWay}" /><Run Text="." />
      </TextBlock>
      <!-- The stock of that blood: a plain line with an icon (amber when short), not a box -->
      <StackPanel x:Name="Stock" Orientation="Horizontal" Margin="{StaticResource Fulfil.Gap}" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Stock">
        <controls:Icon x:Name="StockIcon" Size="16" VerticalAlignment="Center" Margin="{StaticResource Fulfil.IconGap}">
          <controls:Icon.Style>
            <Style TargetType="controls:Icon">
              <Setter Property="Kind" Value="Stock" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding StockIsShort}" Value="True">
                  <Setter Property="Kind" Value="Alert" />
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </controls:Icon.Style>
        </controls:Icon>
        <Grid>
          <TextBlock x:Name="StockLine" Style="{DynamicResource Text.Secondary}" Text="{Binding StockText}" TextWrapping="Wrap" VerticalAlignment="Center"
                     Visibility="{Binding StockIsShort, Converter={StaticResource NotVisible}}" />
          <TextBlock x:Name="StockShortLine" Style="{DynamicResource Text.Secondary}" Foreground="{DynamicResource Brush.Warning}" Text="{Binding StockText}" TextWrapping="Wrap"
                     VerticalAlignment="Center" Visibility="{Binding StockIsShort, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
      </StackPanel>
      <!-- The bags that will be issued, in the order the server takes them -->
      <TextBlock x:Name="BagsNote" Style="{DynamicResource Text.Label}" Text="{Binding BagsNote}" TextWrapping="Wrap" Margin="{DynamicResource Inset.B8}"
                 Visibility="{Binding BagsNote, Converter={StaticResource HasContent}}" />
      <ItemsControl x:Name="BagList" ItemsSource="{Binding Bags}" Focusable="False" Margin="{StaticResource Fulfil.Gap}" AutomationProperties.Name="Bags to issue"
                    Visibility="{Binding Bags, Converter={StaticResource HasContent}}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{DynamicResource Brush.Layer}" BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Control}"
                    Padding="{StaticResource Fulfil.CardPad}" Margin="{StaticResource Fulfil.BagRow}" SnapsToDevicePixels="True">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{DynamicResource Text.Caption}" Text="{Binding Order}" VerticalAlignment="Top" Margin="{StaticResource Fulfil.OrderGap}" Typography.NumeralAlignment="Tabular" />
                <StackPanel Grid.Column="1">
                  <TextBlock Style="{DynamicResource Text.BodyStrong}" Text="{Binding Code}" Typography.NumeralAlignment="Tabular" />
                  <TextBlock Style="{DynamicResource Text.Caption}" Text="{Binding Origin}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Column="2" Style="{DynamicResource Text.Secondary}" Text="{Binding UseBy}" VerticalAlignment="Top" Margin="{DynamicResource Inset.L12}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <!-- The server's refusal -->
      <Border Background="{DynamicResource Brush.CriticalSoft}" BorderBrush="{DynamicResource Brush.CriticalStroke}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Control}"
              Padding="{StaticResource Fulfil.CardPad}" Margin="{StaticResource Fulfil.Gap}" Visibility="{Binding HasFormError, Converter={StaticResource BoolToVisibility}}"
              AutomationProperties.LiveSetting="Assertive">
        <TextBlock x:Name="FormErrorText" Style="{DynamicResource Text.Body}" Foreground="{DynamicResource Brush.Critical}" Text="{Binding FormError}" TextWrapping="Wrap" />
      </Border>
      <UniformGrid Columns="2">
        <Button x:Name="PrimaryButton" Style="{DynamicResource Button.Primary}" Command="{Binding PrimaryCommand}" Content="{Binding PrimaryText}" Margin="{DynamicResource Inset.R8}"
                controls:ButtonAssist.IsBusy="{Binding IsBusy}" controls:ButtonAssist.BusyText="Issuing" AutomationProperties.Name="{Binding PrimaryText}" />
        <Button x:Name="CancelButton" Style="{DynamicResource Button.Secondary}" Command="{Binding CancelCommand}" Content="{Binding CancelText}" AutomationProperties.Name="{Binding CancelText}"
                ToolTip="Keep the request as it is (Esc)" />
      </UniformGrid>
    </StackPanel>
  </Border>
</UserControl>
