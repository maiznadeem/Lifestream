<UserControl x:Class="Lifestream.Desktop.Features.Requests.FulfilRequestDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Lifestream.Desktop.Controls"
             Focusable="False" IsTabStop="False">
  <!-- The fulfil step of a request, in the Requests side panel (direction A): what will be issued, how much of that blood is in stock (amber when it is short), the
       server's message when it refuses, and "Fulfil request" with Cancel. Esc cancels the step (not the panel). The data context is the FulfilRequestDialogViewModel. -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <Thickness x:Key="Fulfil.Pad">16</Thickness>
    <Thickness x:Key="Fulfil.CardPad">12,10,12,10</Thickness>
    <Thickness x:Key="Fulfil.Gap">0,0,0,12</Thickness>
    <Thickness x:Key="Fulfil.IconGap">0,0,8,0</Thickness>
  </UserControl.Resources>
  <UserControl.InputBindings>
    <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
  </UserControl.InputBindings>
  <Border x:Name="Frame" Background="{DynamicResource Brush.Layer2}" BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Panel}"
          Padding="{StaticResource Fulfil.Pad}" SnapsToDevicePixels="True" AutomationProperties.Name="Fulfil request">
    <StackPanel>
      <TextBlock Style="{DynamicResource Text.Heading}" Text="Fulfil this request" Margin="{StaticResource Fulfil.Gap}" AutomationProperties.HeadingLevel="Level3" />
      <!-- A server that is waking up (the stock check or the fulfil call waits on it): say so, with Cancel -->
      <controls:WakingNotice IsActive="{Binding IsOperationWaking}" CancelCommand="{Binding CancelOperationCommand}" Margin="{StaticResource Fulfil.Gap}" />
      <TextBlock Style="{DynamicResource Text.Body}" TextWrapping="Wrap" Margin="{StaticResource Fulfil.Gap}">
        <Run Text="Issue" /> <Run Text="{Binding UnitsText, Mode=OneWay}" FontWeight="SemiBold" /> <Run Text="of" /> <Run Text="{Binding BloodTypeText, Mode=OneWay}" FontWeight="SemiBold" />
        <Run Text="to" /> <Run Text="{Binding PatientName, Mode=OneWay}" /><Run Text=", needed by" /> <Run Text="{Binding RequiredByText, Mode=OneWay}" /><Run Text="." />
      </TextBlock>
      <TextBlock Style="{DynamicResource Text.Secondary}" TextWrapping="Wrap" Margin="{StaticResource Fulfil.Gap}"
                 Text="The oldest bags that have not expired are issued and a receipt is made. If there isn't enough stock, nothing changes." />
      <!-- The stock of that blood -->
      <Border x:Name="Stock" BorderThickness="1" CornerRadius="{DynamicResource Radius.Control}" Padding="{StaticResource Fulfil.CardPad}" Margin="{StaticResource Fulfil.Gap}"
              AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Stock">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Layer}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding StockIsShort}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.WarningSoft}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel Orientation="Horizontal">
          <controls:Icon x:Name="StockIcon" Size="16" VerticalAlignment="Center" Margin="{StaticResource Fulfil.IconGap}">
            <controls:Icon.Style>
              <Style TargetType="controls:Icon">
                <Setter Property="Kind" Value="Stock" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding StockIsShort}" Value="True">
                    <Setter Property="Kind" Value="Alert" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </controls:Icon.Style>
          </controls:Icon>
          <TextBlock Style="{DynamicResource Text.Body}" Text="{Binding StockText}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
      <!-- The server's refusal -->
      <Border Background="{DynamicResource Brush.CriticalSoft}" BorderBrush="{DynamicResource Brush.CriticalStroke}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Control}"
              Padding="{StaticResource Fulfil.CardPad}" Margin="{StaticResource Fulfil.Gap}" Visibility="{Binding HasFormError, Converter={StaticResource BoolToVisibility}}"
              AutomationProperties.LiveSetting="Assertive">
        <TextBlock x:Name="FormErrorText" Style="{DynamicResource Text.Body}" Foreground="{DynamicResource Brush.Critical}" Text="{Binding FormError}" TextWrapping="Wrap" />
      </Border>
      <UniformGrid Columns="2">
        <Button x:Name="PrimaryButton" Style="{DynamicResource Button.Primary}" Command="{Binding PrimaryCommand}" Content="{Binding PrimaryText}" Margin="{DynamicResource Inset.R8}"
                controls:ButtonAssist.IsBusy="{Binding IsBusy}" controls:ButtonAssist.BusyText="Issuing" AutomationProperties.Name="{Binding PrimaryText}" />
        <Button x:Name="CancelButton" Style="{DynamicResource Button.Secondary}" Command="{Binding CancelCommand}" Content="{Binding CancelText}" AutomationProperties.Name="{Binding CancelText}" />
      </UniformGrid>
    </StackPanel>
  </Border>
</UserControl>
