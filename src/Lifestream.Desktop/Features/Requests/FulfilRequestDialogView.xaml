<UserControl x:Class="Lifestream.Desktop.Features.Requests.FulfilRequestDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Lifestream.Desktop.Controls"
             xmlns:feat="clr-namespace:Lifestream.Desktop.Features"
             xmlns:dialogs="clr-namespace:Lifestream.Desktop.Features.Dialogs"
             Focusable="False" IsTabStop="False">
  <!-- The "Fulfil request" dialog: what will be issued, and how much of that blood is in stock (a warning when it is short). The data context is the FulfilRequestDialogViewModel. -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </UserControl.Resources>
  <dialogs:DialogFrame>
    <dialogs:DialogFrame.Fields>
      <StackPanel>
        <TextBlock Style="{DynamicResource Text.Body}" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" feat:Edge.Bottom="{DynamicResource Space.16}"
                   Text="The oldest unexpired bags of this blood type are issued, and a receipt is made. If there isn't enough stock, nothing is changed." />
        <Grid feat:Edge.Bottom="{DynamicResource Space.16}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Style="{DynamicResource Text.Caption}" Foreground="{DynamicResource Brush.TextMuted}" Text="Patient" />
            <TextBlock Style="{DynamicResource Text.Body}" Text="{Binding PatientName}" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="1" feat:Edge.Left="{DynamicResource Space.24}">
            <TextBlock Style="{DynamicResource Text.Caption}" Foreground="{DynamicResource Brush.TextMuted}" Text="Blood type" />
            <TextBlock Style="{DynamicResource Text.Body}" Text="{Binding BloodTypeText}" />
          </StackPanel>
          <StackPanel Grid.Column="2" feat:Edge.Left="{DynamicResource Space.24}">
            <TextBlock Style="{DynamicResource Text.Caption}" Foreground="{DynamicResource Brush.TextMuted}" Text="Units" />
            <TextBlock Style="{DynamicResource Text.Body}" Text="{Binding UnitsText}" />
          </StackPanel>
          <StackPanel Grid.Column="3" feat:Edge.Left="{DynamicResource Space.24}">
            <TextBlock Style="{DynamicResource Text.Caption}" Foreground="{DynamicResource Brush.TextMuted}" Text="Needed by" />
            <TextBlock Style="{DynamicResource Text.Body}" Text="{Binding RequiredByText}" />
          </StackPanel>
        </Grid>
        <controls:CrispBorder feat:Edge.PadX="{DynamicResource Space.12}" feat:Edge.PadY="{DynamicResource Space.8}" Background="{DynamicResource Brush.SurfacePressed}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Control}"
                AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Stock">
          <controls:CrispBorder.Style>
            <Style TargetType="controls:CrispBorder">
              <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding StockIsShort}" Value="True">
                  <Setter Property="BorderBrush" Value="{DynamicResource Brush.StatusWarning}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </controls:CrispBorder.Style>
          <StackPanel Orientation="Horizontal">
            <controls:IconText Style="{DynamicResource Text.Icon}" Text="&#xE7BA;" Foreground="{DynamicResource Brush.StatusWarning}" VerticalAlignment="Center" feat:Edge.Right="{DynamicResource Space.8}"
                               Visibility="{Binding StockIsShort, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Style="{DynamicResource Text.Body}" Text="{Binding StockText}" TextWrapping="Wrap" VerticalAlignment="Center" />
          </StackPanel>
        </controls:CrispBorder>
      </StackPanel>
    </dialogs:DialogFrame.Fields>
  </dialogs:DialogFrame>
</UserControl>
