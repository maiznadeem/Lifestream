<UserControl x:Class="Lifestream.Desktop.Features.Stock.StockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Lifestream.Desktop.Controls"
             xmlns:feat="clr-namespace:Lifestream.Desktop.Features"
             xmlns:lists="clr-namespace:Lifestream.Desktop.Features.ListScreens"
             xmlns:local="clr-namespace:Lifestream.Desktop.Features.Stock"
             xmlns:stock="clr-namespace:Lifestream.Client.Features.Stock;assembly=Lifestream.Client"
             controls:ShellPage.OwnsHeader="True" Focusable="False">
  <!-- Stock (direction A, with direction B's stock-by-age matrix): the page header with All / Low / Expiring tabs, one table of the eight groups (how many
       bags sit in each of the six age bands, the last band being the ones that expire within 7 days, then the units against the minimum and a status that is
       an icon and words), and the selected group's panel: its bags in use-first order with their numbers and dates, the shelf-life split and what the group
       can be given to and receive. Every number comes from the API. -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <local:GroupOptionTextConverter x:Key="GroupOptionText" />

    <!-- The status badge of a group: out of stock and low are Critical, expiring is Warning, otherwise Success. Icon plus words, never colour alone. -->
    <DataTemplate x:Key="StatusCell" DataType="{x:Type stock:StockTile}">
      <controls:Badge x:Name="Status" Text="{Binding BadgeText}" Kind="Success" Icon="Checkc" HorizontalAlignment="Left" VerticalAlignment="Center" />
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding HasExpiring}" Value="True">
          <Setter TargetName="Status" Property="Kind" Value="Warning" />
          <Setter TargetName="Status" Property="Icon" Value="Clock" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsLow}" Value="True">
          <Setter TargetName="Status" Property="Kind" Value="Critical" />
          <Setter TargetName="Status" Property="Icon" Value="Alert" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- One cell of the age matrix: the count on a tint whose strength follows the count (Info for most bands, Warning for the band that expires
         within 7 days). The tint is a separate layer, so the number keeps full contrast. -->
    <DataTemplate x:Key="AgeCell" DataType="{x:Type stock:StockAgeCell}">
      <Grid Height="{DynamicResource Height.Compact}" AutomationProperties.Name="{Binding AutomationName}">
        <Border x:Name="Tint" CornerRadius="{DynamicResource Radius.Small}" Background="{DynamicResource Brush.InfoSoft}" Opacity="0" />
        <TextBlock x:Name="Number" Text="{Binding Text}" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{DynamicResource Text.Body}"
                   Foreground="{DynamicResource Brush.Ink}" FontWeight="SemiBold" />
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsExpiringBand}" Value="True">
          <Setter TargetName="Tint" Property="Background" Value="{DynamicResource Brush.WarningSoft}" />
          <Setter TargetName="Number" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Level}" Value="1">
          <Setter TargetName="Tint" Property="Opacity" Value="0.45" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Level}" Value="2">
          <Setter TargetName="Tint" Property="Opacity" Value="0.65" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Level}" Value="3">
          <Setter TargetName="Tint" Property="Opacity" Value="0.85" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Level}" Value="4">
          <Setter TargetName="Tint" Property="Opacity" Value="1" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Level}" Value="0">
          <Setter TargetName="Number" Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
          <Setter TargetName="Number" Property="FontWeight" Value="Normal" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

  </UserControl.Resources>

  <Grid x:Name="Root">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <Grid x:Name="Page" KeyboardNavigation.TabNavigation="Local">
      <Grid.Style>
        <Style TargetType="Grid">
          <Setter Property="Margin" Value="{DynamicResource Pad.PageA}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding (controls:Responsive.Breakpoint), RelativeSource={RelativeSource Self}}" Value="Compact">
              <Setter Property="Margin" Value="{DynamicResource Pad.PageCompact}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Grid.Style>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <controls:PageHeader Title="Stock" Count="{Binding UnitsCountText}">
        <controls:PageHeader.Actions>
          <Button x:Name="RefreshButton" Style="{DynamicResource Button.Secondary}" Command="{Binding RetryCommand}" controls:ButtonAssist.BusyText="" AutomationProperties.Name="Refresh stock" ToolTip="Fetch the latest stock">
            <StackPanel Orientation="Horizontal">
              <controls:Icon Kind="Sync" Size="16" VerticalAlignment="Center" />
              <TextBlock x:Name="RefreshLabel" Text="Refresh" VerticalAlignment="Center" feat:Edge.Left="{DynamicResource Space.8}" />
            </StackPanel>
          </Button>
        </controls:PageHeader.Actions>
        <controls:PageHeader.Tabs>
          <Border Style="{DynamicResource Tabs.Strip}" Visibility="{Binding HasStock, Converter={StaticResource BoolToVisibility}}">
            <StackPanel x:Name="Tabs" Orientation="Horizontal" feat:Edge.Bottom="-1">
              <RadioButton x:Name="AllTab" Style="{DynamicResource Tab.Option}" GroupName="StockView" IsChecked="{Binding IsAllView, Mode=TwoWay}" AutomationProperties.Name="All blood groups">
                <TextBlock><Run Text="All" /><Run Text=" " /><Run Text="{Binding GroupCount, Mode=OneWay}" Foreground="{DynamicResource Brush.Ink3}" /></TextBlock>
              </RadioButton>
              <RadioButton x:Name="LowTab" Style="{DynamicResource Tab.Option}" GroupName="StockView" IsChecked="{Binding IsLowView, Mode=TwoWay}" AutomationProperties.Name="Low stock">
                <TextBlock><Run Text="Low" /><Run Text=" " /><Run Text="{Binding LowCount, Mode=OneWay}" Foreground="{DynamicResource Brush.Ink3}" /></TextBlock>
              </RadioButton>
              <RadioButton x:Name="ExpiringTab" Style="{DynamicResource Tab.Option}" GroupName="StockView" IsChecked="{Binding IsExpiringView, Mode=TwoWay}" AutomationProperties.Name="Expiring soon">
                <TextBlock><Run Text="Expiring" /><Run Text=" " /><Run Text="{Binding ExpiringCount, Mode=OneWay}" Foreground="{DynamicResource Brush.Ink3}" /></TextBlock>
              </RadioButton>
            </StackPanel>
          </Border>
        </controls:PageHeader.Tabs>
      </controls:PageHeader>

      <!-- The one shortage line: how many groups are below the minimum and which are out. -->
      <controls:CrispBorder x:Name="ShortageBar" Grid.Row="1" Background="{DynamicResource Brush.CriticalSoft}" BorderBrush="{DynamicResource Brush.CriticalSoft}" BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Panel}" Padding="{DynamicResource Inset.H12V8}" feat:Edge.Top="{DynamicResource Space.16}"
                            Visibility="{Binding HasShortage, Converter={StaticResource BoolToVisibility}}" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Stock shortage">
        <StackPanel Orientation="Horizontal">
          <controls:Icon Kind="Alert" Size="18" Foreground="{DynamicResource Brush.Critical}" VerticalAlignment="Center" feat:Edge.Right="{DynamicResource Space.12}" />
          <TextBlock x:Name="ShortageText" Style="{DynamicResource Text.BodyStrong}" Text="{Binding ShortageText}" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
      </controls:CrispBorder>

      <!-- Toolbar: a blood group filter shows only when another screen opened Stock for one group (eight rows need no filter), then the legend of the
           matrix on the right. Both only once there is stock. -->
      <Grid x:Name="Toolbar" Grid.Row="2" feat:Edge.Top="{DynamicResource Space.16}" feat:Edge.Bottom="{DynamicResource Space.12}" MinHeight="{DynamicResource Height.Control}"
            Visibility="{Binding HasStock, Converter={StaticResource BoolToVisibility}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button x:Name="BloodTypeChip" Style="{DynamicResource Button.Chip}" Click="OnBloodTypeChipClick" AutomationProperties.Name="Blood group filter"
                Visibility="{Binding HasBloodTypeFilter, Converter={StaticResource BoolToVisibility}}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding BloodTypeChipText}" VerticalAlignment="Center" />
            <controls:Icon Kind="Chevd" Size="14" VerticalAlignment="Center" feat:Edge.Left="{DynamicResource Space.8}" Foreground="{DynamicResource Brush.Ink3}" />
          </StackPanel>
          <Button.ContextMenu>
            <ContextMenu x:Name="BloodTypeMenu" ItemsSource="{Binding BloodTypeOptions}" MenuItem.Click="OnBloodTypeChosen">
              <ContextMenu.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={StaticResource GroupOptionText}}" />
                </DataTemplate>
              </ContextMenu.ItemTemplate>
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
        <Button Grid.Column="1" Style="{DynamicResource Button.Subtle}" Content="Clear filters" Command="{Binding ClearFiltersCommand}" feat:Edge.Left="{DynamicResource Space.8}"
                Visibility="{Binding HasFilters, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Clear filters" />
        <WrapPanel x:Name="Legend" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" AutomationProperties.Name="Legend">
          <TextBlock Style="{DynamicResource Text.Caption}" Text="Bags by days since collection" VerticalAlignment="Center" feat:Edge.Right="{DynamicResource Space.16}" />
          <StackPanel Orientation="Horizontal" feat:Edge.Right="{DynamicResource Space.16}">
            <Border Width="12" Height="12" CornerRadius="{DynamicResource Radius.2}" Background="{DynamicResource Brush.WarningSoft}" BorderBrush="{DynamicResource Brush.Warning}" BorderThickness="1"
                    VerticalAlignment="Center" feat:Edge.Right="{DynamicResource Space.8}" />
            <TextBlock x:Name="ExpiringLegend" Style="{DynamicResource Text.Caption}" Text="Expires within 7 days" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <Border Width="2" Height="12" Background="{DynamicResource Brush.Ink3}" VerticalAlignment="Center" feat:Edge.Right="{DynamicResource Space.8}" />
            <TextBlock x:Name="MinimumText" Style="{DynamicResource Text.Caption}" Text="{Binding MinimumText}" VerticalAlignment="Center" />
          </StackPanel>
        </WrapPanel>
      </Grid>

      <controls:LoadSurface x:Name="Surface" Grid.Row="3" State="{Binding State}" SkeletonKind="List" SkeletonColumns="72,56,56,56,56,56,56,180,150" ErrorMessage="{Binding ErrorMessage}"
                            ErrorDetail="{Binding ErrorDetail}" RetryCommand="{Binding RetryCommand}" EmptyIcon="Stock" EmptyTitle="No blood in stock"
                            EmptyMessage="Stock appears here once a donation is recorded. Donations are recorded from an appointment."
                            EmptyActionText="Open appointments" EmptyActionCommand="{Binding RecordDonationCommand}" VerticalAlignment="Top">
        <Grid>
          <controls:CrispBorder x:Name="TableFrame" Background="{DynamicResource Brush.Layer}" BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Panel}"
                                VerticalAlignment="Top">
            <controls:LifestreamDataGrid x:Name="Grid" ItemsSource="{Binding Tiles}" SelectedItem="{Binding SelectedTile, Mode=TwoWay}" AutomationProperties.Name="Stock by blood group and age"
                                         HeadersVisibility="Column" VerticalScrollBarVisibility="Disabled" KeyDown="OnGridKeyDown" lists:ListColumns.IsResponsive="True">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Group" Width="72" CanUserSort="False">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type stock:StockTile}">
                      <controls:BloodGroupTag Text="{Binding GroupText}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- The six age bands: headers come from the API's band definitions (StockAges.Bands), set in code-behind. -->
                <DataGridTemplateColumn x:Name="Band0" Width="*" MinWidth="48" MaxWidth="96" CanUserSort="False">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type stock:StockTile}">
                      <ContentControl Content="{Binding AgeCells[0]}" ContentTemplate="{StaticResource AgeCell}" Focusable="False" IsTabStop="False" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn x:Name="Band1" Width="*" MinWidth="48" MaxWidth="96" CanUserSort="False">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type stock:StockTile}">
                      <ContentControl Content="{Binding AgeCells[1]}" ContentTemplate="{StaticResource AgeCell}" Focusable="False" IsTabStop="False" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn x:Name="Band2" Width="*" MinWidth="48" MaxWidth="96" CanUserSort="False">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type stock:StockTile}">
                      <ContentControl Content="{Binding AgeCells[2]}" ContentTemplate="{StaticResource AgeCell}" Focusable="False" IsTabStop="False" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn x:Name="Band3" Width="*" MinWidth="48" MaxWidth="96" CanUserSort="False">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type stock:StockTile}">
                      <ContentControl Content="{Binding AgeCells[3]}" ContentTemplate="{StaticResource AgeCell}" Focusable="False" IsTabStop="False" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn x:Name="Band4" Width="*" MinWidth="48" MaxWidth="96" CanUserSort="False">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type stock:StockTile}">
                      <ContentControl Content="{Binding AgeCells[4]}" ContentTemplate="{StaticResource AgeCell}" Focusable="False" IsTabStop="False" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn x:Name="Band5" Width="*" MinWidth="48" MaxWidth="96" CanUserSort="False">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type stock:StockTile}">
                      <ContentControl Content="{Binding AgeCells[5]}" ContentTemplate="{StaticResource AgeCell}" Focusable="False" IsTabStop="False" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- Units against the minimum: the count (one size: "17 units"), then a meter of a fixed width on one scale for every row (three times the
                     minimum), with the minimum as a tick, so the bars compare and "low" reads at a glance. -->
                <DataGridTemplateColumn x:Name="UnitsColumn" Header="Units in stock" Width="200" CanUserSort="False">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type stock:StockTile}">
                      <Grid VerticalAlignment="Center" AutomationProperties.Name="{Binding AutomationName}">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="72" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="Count" Text="{Binding UnitsText}" Style="{DynamicResource Text.Body}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <controls:MeterBar x:Name="Bar" Grid.Column="1" Width="96" VerticalAlignment="Center" Value="{Binding FillFraction}" Hatched="{Binding ExpiringFraction}" Minimum="{Binding MinimumFraction}"
                                           Track="{DynamicResource Brush.Layer2}" TrackStroke="{DynamicResource Brush.Stroke}" Fill="{DynamicResource Brush.Ink2}"
                                           Hatch="{DynamicResource Brush.WarningHatch}" Tick="{DynamicResource Brush.Ink3}" />
                      </Grid>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLow}" Value="True">
                          <Setter TargetName="Bar" Property="Fill" Value="{DynamicResource Brush.Critical}" />
                          <Setter TargetName="Count" Property="Foreground" Value="{DynamicResource Brush.Critical}" />
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- A compact window has the count only (the panel says how far below the minimum a group is); the code-behind swaps the two columns. -->
                <DataGridTemplateColumn x:Name="UnitsCompactColumn" Header="Units" Width="96" CanUserSort="False" Visibility="Collapsed">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type stock:StockTile}">
                      <TextBlock x:Name="Count" Text="{Binding UnitsText}" Style="{DynamicResource Text.Body}" FontWeight="SemiBold" VerticalAlignment="Center"
                                 AutomationProperties.Name="{Binding AutomationName}" />
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLow}" Value="True">
                          <Setter TargetName="Count" Property="Foreground" Value="{DynamicResource Brush.Critical}" />
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn x:Name="StatusColumn" Header="Status" Width="150" CanUserSort="False" CellTemplate="{StaticResource StatusCell}" lists:ListColumns.HideBelow="740" />
              </DataGrid.Columns>
            </controls:LifestreamDataGrid>
          </controls:CrispBorder>
          <controls:EmptyState Icon="Filter" Title="No blood groups match" Message="Change the filters to see stock again." ActionText="Clear filters"
                               ActionCommand="{Binding ClearFiltersCommand}" Visibility="{Binding NothingMatches, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
      </controls:LoadSurface>
    </Grid>

    <!-- The selected group's panel. -->
    <controls:SidePanel x:Name="Panel" Grid.Column="1" IsOpen="{Binding IsPanelOpen}" Overline="{Binding PanelOverline}" CloseCommand="{Binding ClosePanelCommand}"
                        AutomationProperties.Name="Blood group details">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <!-- The right gutter keeps the overlay scroll bar off the content (the tag, the bag list). -->
        <StackPanel x:Name="PanelBody" feat:Edge.Bottom="{DynamicResource Space.24}" feat:Edge.Right="{DynamicResource Space.12}">
          <Grid DataContext="{Binding SelectedTile}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock x:Name="PanelUnits" Style="{DynamicResource Text.Section}" AutomationProperties.HeadingLevel="Level2" TextWrapping="Wrap">
                <Run Text="{Binding UnitsText, Mode=OneWay}" /><Run Text=" in stock" />
              </TextBlock>
              <TextBlock x:Name="PanelMinimum" Style="{DynamicResource Text.Secondary}" Text="{Binding MinimumSentence}" TextWrapping="Wrap" feat:Edge.Top="{DynamicResource Space.4}" />
            </StackPanel>
            <controls:BloodGroupTag Grid.Column="1" Text="{Binding GroupText}" IsLarge="True" VerticalAlignment="Top" feat:Edge.Left="{DynamicResource Space.12}" />
          </Grid>

          <!-- Actions: one primary (the page header's Refresh is secondary), then the group's requests. -->
          <WrapPanel feat:Edge.Top="{DynamicResource Space.16}" Visibility="{Binding CanNavigate, Converter={StaticResource BoolToVisibility}}">
            <Button x:Name="FindDonorsButton" Style="{DynamicResource Button.Primary}" Command="{Binding FindDonorsCommand}" feat:Edge.Right="{DynamicResource Space.8}" feat:Edge.Bottom="{DynamicResource Space.8}"
                    AutomationProperties.Name="Find donors of this group">
              <StackPanel Orientation="Horizontal">
                <controls:Icon Kind="Donor" Size="16" VerticalAlignment="Center" feat:Edge.Right="{DynamicResource Space.8}" />
                <TextBlock VerticalAlignment="Center"><Run Text="Find " /><Run Text="{Binding SelectedTile.GroupText, Mode=OneWay}" /><Run Text=" donors" /></TextBlock>
              </StackPanel>
            </Button>
            <Button Style="{DynamicResource Button.Secondary}" Command="{Binding OpenRequestsCommand}" feat:Edge.Bottom="{DynamicResource Space.8}" AutomationProperties.Name="Open requests for this group">
              <StackPanel Orientation="Horizontal">
                <controls:Icon Kind="Request" Size="16" VerticalAlignment="Center" feat:Edge.Right="{DynamicResource Space.8}" />
                <TextBlock Text="Requests" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </WrapPanel>

          <!-- Shelf life and compatibility: label and value, as in every A panel. -->
          <TextBlock Style="{DynamicResource Text.Heading}" Text="Details" feat:Edge.Top="{DynamicResource Space.16}" feat:Edge.Bottom="{DynamicResource Space.8}" AutomationProperties.HeadingLevel="Level3" />
          <Grid x:Name="Facts" DataContext="{Binding SelectedTile}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="148" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Style="{DynamicResource Text.Secondary}" TextWrapping="Wrap" Text="More than 7 days left" feat:Edge.Bottom="{DynamicResource Space.8}" />
            <TextBlock x:Name="PanelFresh" Grid.Column="1" Style="{DynamicResource Text.Body}" Text="{Binding FreshText}" feat:Edge.Bottom="{DynamicResource Space.8}" />
            <TextBlock Grid.Row="1" Style="{DynamicResource Text.Secondary}" TextWrapping="Wrap" Text="Expires within 7 days" feat:Edge.Bottom="{DynamicResource Space.8}" />
            <TextBlock x:Name="PanelExpiring" Grid.Row="1" Grid.Column="1" Style="{DynamicResource Text.Body}" Text="{Binding ExpiringNumber}" feat:Edge.Bottom="{DynamicResource Space.8}" />
            <TextBlock Grid.Row="2" Style="{DynamicResource Text.Secondary}" TextWrapping="Wrap" Text="Can be given to" feat:Edge.Bottom="{DynamicResource Space.8}" />
            <TextBlock x:Name="GivesTo" Grid.Row="2" Grid.Column="1" Style="{DynamicResource Text.Body}" Text="{Binding GivesToText}" TextWrapping="Wrap" feat:Edge.Bottom="{DynamicResource Space.8}" />
            <TextBlock Grid.Row="3" Style="{DynamicResource Text.Secondary}" TextWrapping="Wrap" Text="Can receive" />
            <TextBlock x:Name="ReceivesFrom" Grid.Row="3" Grid.Column="1" Style="{DynamicResource Text.Body}" Text="{Binding ReceivesFromText}" TextWrapping="Wrap" />
          </Grid>

          <!-- The bags, in the order to use them: oldest collection first (the order a fulfil issues them in). -->
          <Grid feat:Edge.Top="{DynamicResource Space.24}" feat:Edge.Bottom="{DynamicResource Space.8}">
            <TextBlock Style="{DynamicResource Text.Heading}" Text="Bags" AutomationProperties.HeadingLevel="Level3" />
            <TextBlock Style="{DynamicResource Text.Caption}" Text="Use from the top" HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>
          <controls:Skeleton Kind="Detail" Visibility="{Binding ShowBagsSkeleton, Converter={StaticResource BoolToVisibility}}" />
          <StackPanel Visibility="{Binding HasBagsError, Converter={StaticResource BoolToVisibility}}" AutomationProperties.LiveSetting="Assertive">
            <TextBlock Style="{DynamicResource Text.Body}" Text="{Binding BagsErrorText}" TextWrapping="Wrap" />
            <Button Style="{DynamicResource Button.Secondary.Small}" Content="Retry" Command="{Binding RetryBagsCommand}" HorizontalAlignment="Left" feat:Edge.Top="{DynamicResource Space.8}"
                    AutomationProperties.Name="Retry loading the bags" />
          </StackPanel>
          <TextBlock Style="{DynamicResource Text.Secondary}" Text="No bags of this group are in stock." TextWrapping="Wrap" Visibility="{Binding HasNoBags, Converter={StaticResource BoolToVisibility}}" />
          <controls:CrispBorder x:Name="BagList" BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Panel}"
                                Visibility="{Binding HasBags, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl ItemsSource="{Binding Bags}" Focusable="False" AutomationProperties.Name="Bags in use-first order">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type stock:StockBagRow}">
                  <Border x:Name="Row" BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="0,0,0,1" Padding="{DynamicResource Inset.H12V8}" AutomationProperties.Name="{Binding AutomationName}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{DynamicResource Text.Body}" FontWeight="Medium" Text="{Binding Code}" VerticalAlignment="Center" />
                        <controls:Badge x:Name="First" Text="Use first" Kind="Info" Icon="Arrowright" feat:Edge.Left="{DynamicResource Space.8}" VerticalAlignment="Center" Visibility="Collapsed" />
                      </StackPanel>
                      <controls:Badge x:Name="Left" Grid.Column="1" Text="{Binding DaysLeftText}" Kind="Neutral" Icon="Clock" VerticalAlignment="Center" feat:Edge.Left="{DynamicResource Space.8}" />
                      <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Style="{DynamicResource Text.Caption}" TextWrapping="Wrap" feat:Edge.Top="{DynamicResource Space.4}">
                        <Run Text="Collected " /><Run Text="{Binding CollectedText, Mode=OneWay}" /><Run Text=", expires " /><Run Text="{Binding ExpiresText, Mode=OneWay}" />
                      </TextBlock>
                    </Grid>
                  </Border>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsFirst}" Value="True">
                      <Setter TargetName="First" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsExpiring}" Value="True">
                      <Setter TargetName="Left" Property="Kind" Value="Warning" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </controls:CrispBorder>
          <TextBlock Style="{DynamicResource Text.Caption}" Text="{Binding BagsMoreText}" TextWrapping="Wrap" feat:Edge.Top="{DynamicResource Space.8}" />
        </StackPanel>
      </ScrollViewer>
    </controls:SidePanel>
  </Grid>
</UserControl>
