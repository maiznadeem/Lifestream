<UserControl x:Class="Lifestream.Desktop.Features.Stock.StockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Lifestream.Desktop.Controls"
             xmlns:feat="clr-namespace:Lifestream.Desktop.Features"
             xmlns:stock="clr-namespace:Lifestream.Client.Features.Stock;assembly=Lifestream.Client"
             Focusable="False">
  <!-- Stock: one tile per blood type with units available, units expiring within 7 days and a flag that is an icon, words and a token colour (FEAT-19). -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <feat:StockSeverityToStatusConverter x:Key="SeverityToStatus" />
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Filters apply at once: they only choose which of the loaded tiles to show. -->
    <Grid KeyboardNavigation.TabNavigation="Local">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <controls:FormField Label="Show" feat:Edge.Right="{DynamicResource Space.16}">
        <ComboBox x:Name="ViewBox" ItemsSource="{Binding ViewOptions}" SelectedItem="{Binding ViewFilter, Mode=TwoWay}" DisplayMemberPath="Display" MinWidth="160"
                  AutomationProperties.Name="Show" />
      </controls:FormField>
      <controls:FormField Grid.Column="1" Label="Blood type" feat:Edge.Right="{DynamicResource Space.16}">
        <ComboBox x:Name="BloodTypeBox" ItemsSource="{Binding BloodTypeOptions}" SelectedItem="{Binding BloodTypeFilter, Mode=TwoWay}" DisplayMemberPath="Display" MinWidth="160"
                  AutomationProperties.Name="Blood type" />
      </controls:FormField>
      <Button Grid.Column="2" Style="{DynamicResource Button.Ghost}" Content="Clear filters" Command="{Binding ClearFiltersCommand}" VerticalAlignment="Bottom" feat:Edge.Bottom="{DynamicResource Space.16}"
              Visibility="{Binding HasFilters, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Clear filters" />
      <TextBlock Grid.Column="3" Style="{DynamicResource Text.Body}" Text="{Binding SummaryText}" Foreground="{DynamicResource Brush.TextSecondary}" HorizontalAlignment="Right"
                 VerticalAlignment="Bottom" feat:Edge.Bottom="{DynamicResource Space.24}" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Stock summary" />
    </Grid>

    <controls:LoadSurface Grid.Row="1" State="{Binding State}" SkeletonKind="StockTiles" ErrorMessage="{Binding ErrorMessage}" ErrorDetail="{Binding ErrorDetail}"
                          RetryCommand="{Binding RetryCommand}" EmptyGlyph="&#xE7B8;" EmptyTitle="No stock figures yet" EmptyMessage="Stock appears here once blood has been donated.">
      <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
          <ItemsControl ItemsSource="{Binding Tiles}" Focusable="False" AutomationProperties.Name="Blood stock">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type stock:StockTile}">
                <Border Width="208" feat:Edge.Right="{DynamicResource Space.16}" feat:Edge.Bottom="{DynamicResource Space.16}" Padding="{DynamicResource Pad.16}" Background="{DynamicResource Brush.SurfaceRaised}" BorderBrush="{DynamicResource Brush.BorderSubtle}"
                        BorderThickness="1" CornerRadius="{DynamicResource Radius.Card}" AutomationProperties.Name="{Binding AutomationName}">
                  <StackPanel>
                    <TextBlock Style="{DynamicResource Text.Display}" Text="{Binding BloodTypeText}" />
                    <TextBlock Style="{DynamicResource Text.Body}" Text="{Binding AvailableText}" feat:Edge.Top="{DynamicResource Space.4}" />
                    <TextBlock Style="{DynamicResource Text.Caption}" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding ExpiringText}" TextWrapping="Wrap" feat:Edge.Top="{DynamicResource Space.4}" feat:Edge.Bottom="{DynamicResource Space.12}" />
                    <!-- Flag: a chip (icon, words, token colour) when low or expiring; a tick and "In stock" otherwise. -->
                    <controls:StatusChip x:Name="Flag" Status="{Binding Severity, Converter={StaticResource SeverityToStatus}}" Visibility="Collapsed" />
                    <StackPanel x:Name="InStock" Orientation="Horizontal">
                      <controls:IconText Style="{DynamicResource Text.Icon}" Text="&#xE73E;" FontSize="12" Foreground="{DynamicResource Brush.StatusSuccess}" VerticalAlignment="Center" feat:Edge.Right="{DynamicResource Space.8}" />
                      <TextBlock Style="{DynamicResource Text.Caption}" Text="In stock" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Style="{DynamicResource Text.Caption}" Foreground="{DynamicResource Brush.TextMuted}" Text="{Binding ThresholdText}" feat:Edge.Top="{DynamicResource Space.8}" />
                  </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Severity}" Value="LowStock">
                    <Setter TargetName="Flag" Property="Visibility" Value="Visible" />
                    <Setter TargetName="InStock" Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Severity}" Value="ExpiringSoon">
                    <Setter TargetName="Flag" Property="Visibility" Value="Visible" />
                    <Setter TargetName="InStock" Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <controls:EmptyState Glyph="&#xE71C;" Title="No blood types match" Message="Change the filters to see stock again." ActionText="Clear filters"
                             ActionCommand="{Binding ClearFiltersCommand}" Visibility="{Binding NothingMatches, Converter={StaticResource BoolToVisibility}}" />
      </Grid>
    </controls:LoadSurface>
  </Grid>
</UserControl>
