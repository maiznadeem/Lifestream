<UserControl x:Class="Lifestream.Desktop.Features.Appointments.RecordDonationDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Lifestream.Desktop.Controls"
             xmlns:feat="clr-namespace:Lifestream.Desktop.Features"
             xmlns:dialogs="clr-namespace:Lifestream.Desktop.Features.Dialogs"
             xmlns:appointments="clr-namespace:Lifestream.Desktop.Features.Appointments"
             Focusable="False" IsTabStop="False">
  <!-- The "Record donation" dialog: who and when come from the appointment (read-only), then the eligibility banner, the units, a reason when the donor isn't eligible, and notes. The data context is the RecordDonationDialogViewModel. -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </UserControl.Resources>
  <dialogs:DialogFrame>
    <dialogs:DialogFrame.Fields>
      <StackPanel>
        <Grid feat:Edge.Bottom="{DynamicResource Space.16}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Style="{DynamicResource Text.Caption}" Foreground="{DynamicResource Brush.TextMuted}" Text="Donor" />
            <TextBlock Style="{DynamicResource Text.Body}" Text="{Binding DonorName}" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="1" feat:Edge.Left="{DynamicResource Space.24}">
            <TextBlock Style="{DynamicResource Text.Caption}" Foreground="{DynamicResource Brush.TextMuted}" Text="Blood type" />
            <TextBlock Style="{DynamicResource Text.Body}" Text="{Binding BloodTypeText}" />
          </StackPanel>
          <StackPanel Grid.Column="2" feat:Edge.Left="{DynamicResource Space.24}">
            <TextBlock Style="{DynamicResource Text.Caption}" Foreground="{DynamicResource Brush.TextMuted}" Text="Appointment" />
            <TextBlock Style="{DynamicResource Text.Body}" Text="{Binding AppointmentText}" />
          </StackPanel>
        </Grid>

        <appointments:EligibilityBannerView DataContext="{Binding Banner}" />

        <controls:FormField Label="Units (required)" IsRequired="True" controls:FormFocus.FieldName="Units" Error="{Binding [Units]}">
          <ComboBox ItemsSource="{Binding UnitChoices}" DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding Units, Mode=TwoWay}" AutomationProperties.Name="Units donated" />
        </controls:FormField>
        <controls:FormField Label="Reason for recording an ineligible donor (required)" IsRequired="True" controls:FormFocus.FieldName="OverrideReason" Error="{Binding [OverrideReason]}"
                            Visibility="{Binding Banner.RequiresReason, Converter={StaticResource BoolToVisibility}}" Hint="It is stored in the receipt's notes.">
          <TextBox Text="{Binding OverrideReason, UpdateSourceTrigger=PropertyChanged}" MaxLength="300" TextWrapping="Wrap" AutomationProperties.Name="Override reason" />
        </controls:FormField>
        <controls:FormField Label="Notes" controls:FormFocus.FieldName="Notes" Error="{Binding [Notes]}">
          <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" TextWrapping="Wrap" AcceptsReturn="True" MinLines="2" AutomationProperties.Name="Notes" />
        </controls:FormField>
      </StackPanel>
    </dialogs:DialogFrame.Fields>
  </dialogs:DialogFrame>
</UserControl>
