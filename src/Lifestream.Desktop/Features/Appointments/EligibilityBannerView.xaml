<UserControl x:Class="Lifestream.Desktop.Features.Appointments.EligibilityBannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Lifestream.Desktop.Controls"
             xmlns:feat="clr-namespace:Lifestream.Desktop.Features"
             Focusable="False" IsTabStop="False">
  <!-- The eligibility banner (FEAT-09): a headline with an icon, then the facts that decide it. Colour is never the only signal: the icon and the words say eligible or not. The data context is the EligibilityBannerViewModel. -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <Style x:Key="BannerFrame" TargetType="Border">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding State}" Value="Eligible">
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.StatusSuccess}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="NotEligible">
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.StatusWarning}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="BannerGlyph" TargetType="controls:IconText">
      <Setter Property="FontFamily" Value="{DynamicResource Font.Icons}" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Icon}" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="Text" Value="&#xE946;" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding State}" Value="Checking">
          <Setter Property="Text" Value="&#xE895;" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Eligible">
          <Setter Property="Text" Value="&#xE73E;" />
          <Setter Property="Foreground" Value="{DynamicResource Brush.StatusSuccess}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="NotEligible">
          <Setter Property="Text" Value="&#xE7BA;" />
          <Setter Property="Foreground" Value="{DynamicResource Brush.StatusWarning}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <controls:CrispBorder x:Name="Frame" Style="{StaticResource BannerFrame}" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" Background="{DynamicResource Brush.SurfacePressed}"
          BorderThickness="1" CornerRadius="{DynamicResource Radius.Control}" feat:Edge.PadX="{DynamicResource Space.12}" feat:Edge.PadY="{DynamicResource Space.8}" feat:Edge.Bottom="{DynamicResource Space.16}"
          AutomationProperties.Name="Eligibility" AutomationProperties.LiveSetting="Polite">
    <StackPanel>
      <StackPanel Orientation="Horizontal">
        <controls:IconText x:Name="Glyph" Style="{StaticResource BannerGlyph}" VerticalAlignment="Center" feat:Edge.Right="{DynamicResource Space.8}" />
        <TextBlock x:Name="Headline" Style="{DynamicResource Text.Label}" Text="{Binding Headline}" VerticalAlignment="Center" />
      </StackPanel>
      <ItemsControl ItemsSource="{Binding Lines}" Focusable="False" feat:Edge.Top="{DynamicResource Space.4}" AutomationProperties.Name="Eligibility details">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Style="{DynamicResource Text.Body}" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding}" TextWrapping="Wrap" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </controls:CrispBorder>
</UserControl>
