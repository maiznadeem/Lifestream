<UserControl x:Class="Lifestream.Desktop.Features.Appointments.EligibilityBannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Lifestream.Desktop.Controls"
             Focusable="False" IsTabStop="False">
  <!-- The eligibility banner (FEAT-09), direction A: a soft card with an icon and the headline (green when eligible, amber when not, neutral while checking or when the
       check could not be made), then the facts that decide it. Colour is never the only signal: the icon and the words say eligible or not. The data context is the
       EligibilityBannerViewModel. -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <Thickness x:Key="Banner.Pad">16,14,16,14</Thickness>
    <Thickness x:Key="Banner.Gap">0,0,0,20</Thickness>
    <Thickness x:Key="Banner.IconGap">0,1,12,0</Thickness>
  </UserControl.Resources>
  <Border x:Name="Frame" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Panel}"
          Padding="{StaticResource Banner.Pad}" Margin="{StaticResource Banner.Gap}" SnapsToDevicePixels="True"
          AutomationProperties.Name="Eligibility" AutomationProperties.LiveSetting="Polite">
    <Border.Style>
      <Style TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Layer2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Ink2}" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding State}" Value="Eligible">
            <Setter Property="Background" Value="{DynamicResource Brush.SuccessSoft}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.SuccessStroke}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Success}" />
          </DataTrigger>
          <DataTrigger Binding="{Binding State}" Value="NotEligible">
            <Setter Property="Background" Value="{DynamicResource Brush.WarningSoft}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Warning}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </Border.Style>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <controls:Icon x:Name="Glyph" Size="20" VerticalAlignment="Top" Margin="{StaticResource Banner.IconGap}">
        <controls:Icon.Style>
          <Style TargetType="controls:Icon">
            <Setter Property="Kind" Value="Info" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding State}" Value="Checking">
                <Setter Property="Kind" Value="Sync" />
              </DataTrigger>
              <DataTrigger Binding="{Binding State}" Value="Eligible">
                <Setter Property="Kind" Value="Checkc" />
              </DataTrigger>
              <DataTrigger Binding="{Binding State}" Value="NotEligible">
                <Setter Property="Kind" Value="Alert" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </controls:Icon.Style>
      </controls:Icon>
      <StackPanel Grid.Column="1">
        <TextBlock x:Name="Headline" Style="{DynamicResource Text.BodyStrong}" Foreground="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}"
                   Text="{Binding Headline}" TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding Lines}" Focusable="False" Margin="{DynamicResource Inset.T4}" AutomationProperties.Name="Eligibility details">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Style="{DynamicResource Text.Secondary}" Text="{Binding}" TextWrapping="Wrap" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
