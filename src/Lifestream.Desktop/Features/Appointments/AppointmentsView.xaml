<UserControl x:Class="Lifestream.Desktop.Features.Appointments.AppointmentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Lifestream.Desktop.Controls"
             xmlns:feat="clr-namespace:Lifestream.Desktop.Features"
             xmlns:lists="clr-namespace:Lifestream.Desktop.Features.ListScreens"
             xmlns:services="clr-namespace:Lifestream.Desktop.Services"
             Focusable="False">
  <!-- Appointments: filters on top, the list (donor name with the id as secondary text, local time, status chip) with its page count, and on the right the appointment's actions and facts or the booking form. -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <feat:BloodTypeTextConverter x:Key="BloodTypeText" />
    <feat:NullToCollapsedConverter x:Key="NullToCollapsed" />
    <feat:NullToVisibleConverter x:Key="NullToVisible" />
    <feat:AppointmentStatusKindConverter x:Key="StatusKind" />
    <feat:AppointmentStatusTextConverter x:Key="StatusText" />
    <feat:LocalWhenConverter x:Key="LocalWhen" />
    <feat:IdTextConverter x:Key="IdText" />
    <Style x:Key="RecordLink" TargetType="Hyperlink">
      <Setter Property="Foreground" Value="{DynamicResource Brush.StatusInfo}" />
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <DockPanel KeyboardNavigation.TabNavigation="Local">
      <Button x:Name="AddButton" DockPanel.Dock="Right" Style="{DynamicResource Button.Primary}" Command="{Binding AddCommand}" VerticalAlignment="Bottom" feat:Edge.Bottom="{DynamicResource Space.16}"
              AutomationProperties.Name="Book appointment" ToolTip="Ctrl+N">
        <StackPanel Orientation="Horizontal">
          <controls:IconText Style="{DynamicResource Text.Icon}" Text="&#xE710;" feat:Edge.Right="{DynamicResource Space.8}" VerticalAlignment="Center" />
          <TextBlock Text="Book appointment" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <WrapPanel>
        <controls:FormField Label="Search" feat:Edge.Right="{DynamicResource Space.16}" MinWidth="200">
          <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="Search appointments by donor name">
            <TextBox.InputBindings>
              <KeyBinding Key="Enter" Command="{Binding SearchNowCommand}" />
            </TextBox.InputBindings>
          </TextBox>
        </controls:FormField>
        <controls:FormField Label="Status" feat:Edge.Right="{DynamicResource Space.16}">
          <ComboBox x:Name="StatusBox" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding StatusFilter, Mode=TwoWay}" DisplayMemberPath="Display" MinWidth="150" AutomationProperties.Name="Status" />
        </controls:FormField>
        <controls:FormField Label="Blood type" feat:Edge.Right="{DynamicResource Space.16}">
          <ComboBox x:Name="BloodTypeBox" ItemsSource="{Binding BloodTypeOptions}" SelectedItem="{Binding BloodTypeFilter, Mode=TwoWay}" DisplayMemberPath="Display" MinWidth="150" AutomationProperties.Name="Blood type" />
        </controls:FormField>
        <controls:FormField Label="Donor" feat:Edge.Right="{DynamicResource Space.16}" MinWidth="220">
          <controls:RecordPicker x:Name="DonorFilterBox" Kind="Donor" Label="Donor" SelectedOption="{Binding DonorFilter, Mode=TwoWay}" />
        </controls:FormField>
        <Button Style="{DynamicResource Button.Ghost}" Content="Clear filters" Command="{Binding ClearFiltersCommand}" VerticalAlignment="Bottom" feat:Edge.Bottom="{DynamicResource Space.16}"
                Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Clear filters" />
      </WrapPanel>
    </DockPanel>

    <lists:ScreenWakingNotice Grid.Row="1" />
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="360" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="400" />
      </Grid.ColumnDefinitions>
      <controls:LoadSurface x:Name="ListSurface" State="{Binding State}" SkeletonKind="List" SkeletonColumns="2*,100,*,130"
                            ErrorMessage="{Binding ErrorMessage}" ErrorDetail="{Binding ErrorDetail}" RetryCommand="{Binding RetryCommand}"
                            EmptyGlyph="&#xE787;" EmptyTitle="{Binding EmptyTitle}" EmptyMessage="{Binding EmptyMessage}" EmptyActionText="{Binding EmptyActionText}"
                            EmptyActionCommand="{Binding EmptyActionCommand}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <controls:LifestreamDataGrid x:Name="Grid" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" SortCommand="{Binding SortCommand}"
                                       SortColumn="{Binding SortColumn, Mode=OneWay}" SortDescending="{Binding SortDescending, Mode=OneWay}"
                                       AutomationProperties.Name="Appointments">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="Donor" Width="2*" MinWidth="170" CanUserSort="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel VerticalAlignment="Center" feat:Edge.Left="{DynamicResource Space.12}" feat:Edge.Right="{DynamicResource Space.12}">
                      <TextBlock TextTrimming="CharacterEllipsis">
                        <Hyperlink Style="{StaticResource RecordLink}" Command="{Binding DataContext.OpenDonorCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"
                                   AutomationProperties.Name="Open donor">
                          <Run Text="{Binding DonorName, Mode=OneWay}" />
                        </Hyperlink>
                      </TextBlock>
                      <TextBlock Style="{DynamicResource Text.Caption}" Foreground="{DynamicResource Brush.TextMuted}" Text="{Binding DonorId, Converter={StaticResource IdText}}" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Blood type" Width="100" CanUserSort="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding DonorBloodType, Converter={StaticResource BloodTypeText}}" Style="{DynamicResource DataGrid.TextCell}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Appointment" Width="*" MinWidth="150" SortMemberPath="slot">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding SlotStartUtc, Converter={StaticResource LocalWhen}}" Style="{DynamicResource DataGrid.TextCell}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Status" Width="130" CanUserSort="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <controls:StatusChip Status="{Binding Status, Converter={StaticResource StatusKind}}" Label="{Binding Status, Converter={StaticResource StatusText}}" feat:Edge.Left="{DynamicResource Space.12}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </controls:LifestreamDataGrid>
          <lists:ListFooter Grid.Row="1" />
        </Grid>
      </controls:LoadSurface>

      <Grid Grid.Column="2">
        <lists:ActionDetailPane Visibility="{Binding Editor, Converter={StaticResource NullToVisible}}">
          <lists:ActionDetailPane.Actions>
            <WrapPanel>
              <Button Style="{DynamicResource Button.Primary}" Command="{Binding RecordDonationCommand}" feat:Edge.Right="{DynamicResource Space.8}" feat:Edge.Bottom="{DynamicResource Space.8}"
                      AutomationProperties.Name="Record donation" controls:ButtonAssist.IsBusy="{Binding RecordDonationCommand.IsRunning}" controls:ButtonAssist.BusyText="Recording...">
                <StackPanel Orientation="Horizontal">
                  <controls:IconText Style="{DynamicResource Text.Icon}" Text="&#xEB52;" feat:Edge.Right="{DynamicResource Space.8}" VerticalAlignment="Center" />
                  <TextBlock Text="Record donation" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Style="{DynamicResource Button.Secondary}" Command="{Binding RescheduleCommand}" feat:Edge.Right="{DynamicResource Space.8}" feat:Edge.Bottom="{DynamicResource Space.8}"
                      AutomationProperties.Name="Reschedule">
                <StackPanel Orientation="Horizontal">
                  <controls:IconText Style="{DynamicResource Text.Icon}" Text="&#xE787;" feat:Edge.Right="{DynamicResource Space.8}" VerticalAlignment="Center" />
                  <TextBlock Text="Reschedule" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Style="{DynamicResource Button.Danger}" Command="{Binding CancelAppointmentCommand}" feat:Edge.Right="{DynamicResource Space.8}" feat:Edge.Bottom="{DynamicResource Space.8}"
                      AutomationProperties.Name="Cancel appointment" controls:ButtonAssist.IsBusy="{Binding CancelAppointmentCommand.IsRunning}" controls:ButtonAssist.BusyText="Cancelling...">
                <StackPanel Orientation="Horizontal">
                  <controls:IconText Style="{DynamicResource Text.Icon}" Text="&#xE711;" feat:Edge.Right="{DynamicResource Space.8}" VerticalAlignment="Center" />
                  <TextBlock Text="Cancel appointment" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Style="{DynamicResource Button.Secondary}" Command="{Binding ViewReceiptCommand}" feat:Edge.Right="{DynamicResource Space.8}" feat:Edge.Bottom="{DynamicResource Space.8}"
                      AutomationProperties.Name="View receipt">
                <StackPanel Orientation="Horizontal">
                  <controls:IconText Style="{DynamicResource Text.Icon}" Text="&#xE8A5;" feat:Edge.Right="{DynamicResource Space.8}" VerticalAlignment="Center" />
                  <TextBlock Text="View receipt" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </WrapPanel>
          </lists:ActionDetailPane.Actions>
        </lists:ActionDetailPane>
        <ContentControl Content="{Binding Editor}" ContentTemplateSelector="{x:Static services:ViewLocator.Instance}" IsTabStop="False" Focusable="False"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="{Binding Editor, Converter={StaticResource NullToCollapsed}}" />
      </Grid>
    </Grid>
  </Grid>
</UserControl>
