<ResourceDictionary xmlns:controls="clr-namespace:Lifestream.Desktop.Controls" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:assist="clr-namespace:Lifestream.Desktop.Controls">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Lifestream;component/Theme/Tokens.xaml" />
    <ResourceDictionary Source="/Lifestream;component/Theme/Motion.xaml" />
    <ResourceDictionary Source="/Lifestream;component/Theme/Typography.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- Text input: the label lives above the field (FormField), never inside it; an optional placeholder (InputAssist.Placeholder) shows
       inside while the field is empty. Focus turns the border to the accent colour and draws a 2 px accent line along the bottom. The
       placeholder is not part of the value: there is no Text trick, it is a separate element. -->
  <Style x:Key="Input.Base" TargetType="Control">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderInput}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="MinHeight" Value="{StaticResource Height.Control}" />
    <Setter Property="Padding" Value="{DynamicResource Inset.H12}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style x:Key="TextBox.Lifestream" TargetType="TextBox" BasedOn="{StaticResource Input.Base}">
    <Setter Property="CaretBrush" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Primary}" />
    <Setter Property="ContextMenu" Value="{DynamicResource ContextMenu.Editor}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <!-- Rest: raised fill and a quiet border. Hover: a lighter fill. Focus: a darker fill, the accent border and a 2 px accent line along
               the bottom, faded in and out over Motion.Fast. The layers are separate borders so the change can animate (opacity, not colour). -->
          <Grid SnapsToDevicePixels="True">
            <controls:CrispBorder x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.Control}" />
            <Border x:Name="HoverFill" Background="{DynamicResource Brush.SurfaceInputHover}" CornerRadius="{StaticResource Radius.Control}" Margin="{DynamicResource Pad.1}" Opacity="0" IsHitTestVisible="False" />
            <Border x:Name="FocusFill" Background="{DynamicResource Brush.SurfaceInputFocus}" CornerRadius="{StaticResource Radius.Control}" Margin="{DynamicResource Pad.1}" Opacity="0" IsHitTestVisible="False" />
            <TextBlock x:Name="Placeholder" Text="{TemplateBinding assist:InputAssist.Placeholder}" Margin="{TemplateBinding Padding}" Padding="{DynamicResource Inset.L2}"
                       VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}" FontSize="{TemplateBinding FontSize}" FontFamily="{TemplateBinding FontFamily}"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" IsHitTestVisible="False" Visibility="Collapsed" />
            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"
                          Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
            <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom" CornerRadius="{StaticResource Radius.Underline}" Margin="{DynamicResource Inset.H1}"
                    Background="{DynamicResource Brush.FocusRing}" Opacity="0" IsHitTestVisible="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="FocusFill" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" />
                    <DoubleAnimation Storyboard.TargetName="Underline" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="FocusFill" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" />
                    <DoubleAnimation Storyboard.TargetName="Underline" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsReadOnly" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.SurfaceCanvas}" />
            </Trigger>
            <Trigger Property="Validation.HasError" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.StatusDanger}" />
              <Setter TargetName="Underline" Property="Background" Value="{DynamicResource Brush.StatusDanger}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
              <Setter TargetName="HoverFill" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Text" Value="" />
                <Condition Property="IsEnabled" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <!-- The error is shown by FormField under the field, so the built-in red adorner is switched off. -->
    <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
  </Style>

  <Style x:Key="PasswordBox.Lifestream" TargetType="PasswordBox" BasedOn="{StaticResource Input.Base}">
    <Setter Property="CaretBrush" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Primary}" />
    <Setter Property="ContextMenu" Value="{DynamicResource ContextMenu.Paste}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <!-- Rest: raised fill and a quiet border. Hover: a lighter fill. Focus: a darker fill, the accent border and a 2 px accent line along
               the bottom, faded in and out over Motion.Fast. The layers are separate borders so the change can animate (opacity, not colour). -->
          <Grid SnapsToDevicePixels="True">
            <controls:CrispBorder x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.Control}" />
            <Border x:Name="HoverFill" Background="{DynamicResource Brush.SurfaceInputHover}" CornerRadius="{StaticResource Radius.Control}" Margin="{DynamicResource Pad.1}" Opacity="0" IsHitTestVisible="False" />
            <Border x:Name="FocusFill" Background="{DynamicResource Brush.SurfaceInputFocus}" CornerRadius="{StaticResource Radius.Control}" Margin="{DynamicResource Pad.1}" Opacity="0" IsHitTestVisible="False" />
            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False" />
            <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom" CornerRadius="{StaticResource Radius.Underline}" Margin="{DynamicResource Inset.H1}"
                    Background="{DynamicResource Brush.FocusRing}" Opacity="0" IsHitTestVisible="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="FocusFill" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" />
                    <DoubleAnimation Storyboard.TargetName="Underline" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="FocusFill" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" />
                    <DoubleAnimation Storyboard.TargetName="Underline" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
              <Setter TargetName="HoverFill" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Combo box: keyboard focusable, typed items, the popup lists items bound to the ItemsSource. -->
  <Style x:Key="ComboBoxItem.Lifestream" TargetType="ComboBoxItem">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="MinHeight" Value="{StaticResource Height.Compact}" />
    <Setter Property="Padding" Value="{DynamicResource Inset.H12V4}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="{StaticResource Radius.Control}">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceSelected}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ComboBox.Lifestream" TargetType="ComboBox" BasedOn="{StaticResource Input.Base}">
    <Setter Property="ItemContainerStyle" Value="{StaticResource ComboBoxItem.Lifestream}" />
    <Setter Property="IsTabStop" Value="True" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                          AutomationProperties.Name="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}, StringFormat='{}{0} options'}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Grid>
                    <controls:CrispBorder x:Name="Box" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                            BorderThickness="1" CornerRadius="{StaticResource Radius.Control}" />
                    <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom" CornerRadius="{StaticResource Radius.Underline}" Margin="{DynamicResource Inset.H1}"
                            Background="{DynamicResource Brush.FocusRing}" Visibility="Collapsed" />
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.SurfaceInputHover}" />
                    </Trigger>
                    <DataTrigger Binding="{Binding IsDropDownOpen, RelativeSource={RelativeSource AncestorType=ComboBox}}" Value="True">
                      <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.SurfaceInputFocus}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ComboBox}}" Value="True">
                      <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}" />
                      <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <Grid IsHitTestVisible="False" Margin="{TemplateBinding Padding}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
              <controls:IconText Grid.Column="1" Style="{StaticResource Text.Icon}" Text="&#xE70D;" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" />
            </Grid>
            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" HorizontalOffset="-8" AllowsTransparency="True" Focusable="False"
                   PopupAnimation="None" StaysOpen="False">
              <controls:Card MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                             Background="{DynamicResource Brush.SurfaceRaised}" BorderBrush="{DynamicResource Brush.BorderCard}" BorderThickness="1" Elevation="2"
                             CornerRadius="{StaticResource Radius.Card}" Padding="{DynamicResource Pad.4}" Margin="{DynamicResource Inset.Popup}">
                <ScrollViewer>
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                </ScrollViewer>
              </controls:Card>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CheckBox.Lifestream" TargetType="CheckBox">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="MinHeight" Value="{StaticResource Height.Compact}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:CrispBorder x:Name="Box" Width="20" Height="20" BorderThickness="1" BorderBrush="{DynamicResource Brush.BorderInput}"
                    Background="{DynamicResource Brush.SurfaceRaised}" CornerRadius="{StaticResource Radius.Control}" VerticalAlignment="Center">
              <controls:IconText x:Name="Mark" Style="{StaticResource Text.Icon}" Text="&#xE73E;" FontSize="{StaticResource FontSize.Body}"
                         Foreground="{DynamicResource Brush.TextOnPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            </controls:CrispBorder>
            <ContentPresenter Grid.Column="1" Margin="{DynamicResource Inset.L8}" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Primary}" />
              <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}" />
              <Setter TargetName="Box" Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ToolTip.Lifestream" TargetType="ToolTip">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="Background" Value="{DynamicResource Brush.SurfacePressed}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderInput}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="{DynamicResource Inset.H8V4}" />
    <Setter Property="MaxWidth" Value="360" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <controls:CrispBorder Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource Radius.Control}" Padding="{TemplateBinding Padding}">
            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
          </controls:CrispBorder>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TextBox" BasedOn="{StaticResource TextBox.Lifestream}" />
  <Style TargetType="PasswordBox" BasedOn="{StaticResource PasswordBox.Lifestream}" />
  <Style TargetType="ComboBox" BasedOn="{StaticResource ComboBox.Lifestream}" />
  <Style TargetType="CheckBox" BasedOn="{StaticResource CheckBox.Lifestream}" />
  <Style TargetType="ToolTip" BasedOn="{StaticResource ToolTip.Lifestream}" />

  <!-- Any other control that takes keyboard focus gets the same 2 px ring, drawn only for keyboard focus (WPF shows the
       focus visual only after keyboard input). -->
  <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="{DynamicResource Inset.Neg3}" RadiusX="11" RadiusY="11" StrokeThickness="{StaticResource Size.FocusRing}"
                     Stroke="{DynamicResource Brush.FocusRing}" SnapsToDevicePixels="True" IsHitTestVisible="False" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
