<ResourceDictionary xmlns:controls="clr-namespace:Lifestream.Desktop.Controls" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="clr-namespace:Lifestream.Desktop.Theme">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Lifestream;component/Theme/Tokens.xaml" />
    <ResourceDictionary Source="/Lifestream;component/Theme/Motion.xaml" />
    <ResourceDictionary Source="/Lifestream;component/Theme/Typography.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- Menus (SHELL-26) of direction A. WPF's own menu styles take the system menu font (Segoe UI, 12) from the system settings, so every menu the user can open is themed
       here: the account menu, the Cut/Copy/Paste menu of every text field, and the Copy/Select all menu of the receipt. The styles are implicit (a menu or an
       item with no style of its own gets them) and name the family and the body size themselves, so they never depend on what a popup inherits.
       The surface is Layer with a 1 px Stroke, radius 8 and padding 4; its shadow (0 8 16 at 14 %) is a separate Border behind it inside a Grid whose margin gives the
       blur room, so the popup (which allows transparency) does not clip it and no effect ever touches text. -->
  <Style x:Key="MenuItem.Lifestream" TargetType="MenuItem">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="MinHeight" Value="{StaticResource Height.Control}" />
    <Setter Property="Padding" Value="{StaticResource Pad.Field}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="{StaticResource Radius.Small}"
                  MinHeight="{TemplateBinding MinHeight}" SnapsToDevicePixels="True">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <!-- The optional icon column: the Icon property (an Icon element). It takes no room when there is none. -->
              <ContentPresenter x:Name="IconHost" ContentSource="Icon" Margin="{DynamicResource Inset.R10}" VerticalAlignment="Center" />
              <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True" />
              <TextBlock x:Name="Gesture" Grid.Column="2" Text="{TemplateBinding InputGestureText}" FontFamily="{DynamicResource Font.Family}"
                         FontSize="{StaticResource FontSize.Caption}" Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center" Margin="{DynamicResource Inset.L24}" />
              <controls:Icon x:Name="Check" Grid.Column="3" Kind="Check" Size="15" Margin="{DynamicResource Inset.L12}" VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
              <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="">
              <Setter TargetName="Gesture" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Check" Property="Visibility" Value="Visible" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Selected}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ContextMenu.Lifestream" TargetType="ContextMenu">
    <!-- A context menu opens in a tree of its own: it takes the app's text rendering here, as a tool tip does (Theme/TextDefaults.cs). -->
    <Setter Property="theme:TextDefaults.Apply" Value="True" />
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="HasDropShadow" Value="False" />
    <!-- The popup starts where the shadow room starts: pull it back so the visible surface sits on the placement point. -->
    <Setter Property="HorizontalOffset" Value="-12" />
    <Setter Property="VerticalOffset" Value="-2" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Grid Margin="{DynamicResource Inset.L12T6R12B20}" SnapsToDevicePixels="True">
            <Border Background="{DynamicResource Brush.Layer}" CornerRadius="{StaticResource Radius.Panel}" IsHitTestVisible="False">
              <Border.Effect>
                <DropShadowEffect BlurRadius="{StaticResource Elevation.Flyout.Blur}" ShadowDepth="{StaticResource Elevation.Flyout.Offset}" Direction="270"
                                  Opacity="{StaticResource Elevation.Flyout.Opacity}" Color="{DynamicResource Color.Shadow}" />
              </Border.Effect>
            </Border>
            <controls:CrispBorder Background="{DynamicResource Brush.Layer}" BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1" Padding="{StaticResource Pad.4}"
                    CornerRadius="{StaticResource Radius.Panel}" MinWidth="200">
              <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
            </controls:CrispBorder>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
    <Setter Property="Margin" Value="{StaticResource Inset.V4}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="1" Background="{DynamicResource Brush.Stroke}" SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="MenuItem" BasedOn="{StaticResource MenuItem.Lifestream}" />
  <Style TargetType="ContextMenu" BasedOn="{StaticResource ContextMenu.Lifestream}" />

  <!-- The menu WPF builds for a text field on right-click is its own (Segoe UI), so a field is given this one. The commands act on the field the menu opened on. -->
  <ContextMenu x:Key="ContextMenu.Editor" x:Shared="False" Style="{StaticResource ContextMenu.Lifestream}">
    <MenuItem Header="Cut" Command="ApplicationCommands.Cut" InputGestureText="Ctrl+X" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
    <MenuItem Header="Copy" Command="ApplicationCommands.Copy" InputGestureText="Ctrl+C" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
    <MenuItem Header="Paste" Command="ApplicationCommands.Paste" InputGestureText="Ctrl+V" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
    <Separator />
    <MenuItem Header="Select all" Command="ApplicationCommands.SelectAll" InputGestureText="Ctrl+A" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
  </ContextMenu>

  <ContextMenu x:Key="ContextMenu.Paste" x:Shared="False" Style="{StaticResource ContextMenu.Lifestream}">
    <MenuItem Header="Paste" Command="ApplicationCommands.Paste" InputGestureText="Ctrl+V" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
  </ContextMenu>

  <ContextMenu x:Key="ContextMenu.Document" x:Shared="False" Style="{StaticResource ContextMenu.Lifestream}">
    <MenuItem Header="Copy" Command="ApplicationCommands.Copy" InputGestureText="Ctrl+C" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
    <MenuItem Header="Select all" Command="ApplicationCommands.SelectAll" InputGestureText="Ctrl+A" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
  </ContextMenu>
</ResourceDictionary>
