<ResourceDictionary xmlns:controls="clr-namespace:Lifestream.Desktop.Controls" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Lifestream.Desktop.Controls">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Lifestream;component/Theme/Tokens.xaml" />
    <ResourceDictionary Source="/Lifestream;component/Theme/Motion.xaml" />
    <ResourceDictionary Source="/Lifestream;component/Theme/Typography.xaml" />
    <ResourceDictionary Source="/Lifestream;component/Controls/Buttons.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- Empty state: icon, one-line cause, one action. -->
  <Style TargetType="local:EmptyState">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:EmptyState">
          <StackPanel MaxWidth="420" Margin="{StaticResource Pad.32}">
            <controls:IconText Style="{StaticResource Text.Icon}" Text="{TemplateBinding Glyph}" FontSize="40" Foreground="{DynamicResource Brush.TextMuted}"
                       HorizontalAlignment="Center" Margin="{DynamicResource Gap.Field}" />
            <TextBlock Style="{StaticResource Text.Heading}" Text="{TemplateBinding Title}" TextAlignment="Center" />
            <TextBlock x:Name="MessageText" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.TextSecondary}"
                       Text="{TemplateBinding Message}" TextAlignment="Center" Margin="{DynamicResource Inset.T8}" />
            <Button x:Name="ActionButton" Style="{StaticResource Button.Primary}" Content="{TemplateBinding ActionText}" Command="{TemplateBinding ActionCommand}"
                    HorizontalAlignment="Center" Margin="{DynamicResource Inset.T24}" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="Message" Value="{x:Null}">
              <Setter TargetName="MessageText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="ActionCommand" Value="{x:Null}">
              <Setter TargetName="ActionButton" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Error state: plain cause, Retry, technical detail behind Details. -->
  <Style TargetType="local:ErrorState">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:ErrorState">
          <StackPanel MaxWidth="480" Margin="{StaticResource Pad.32}">
            <controls:IconText Style="{StaticResource Text.Icon}" Text="&#xE783;" FontSize="40" Foreground="{DynamicResource Brush.StatusDanger}"
                       HorizontalAlignment="Center" Margin="{DynamicResource Gap.Field}" />
            <TextBlock x:Name="PART_Message" Style="{StaticResource Text.Heading}" Text="{TemplateBinding Message}" TextAlignment="Center"
                       AutomationProperties.LiveSetting="Assertive" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="{DynamicResource Inset.T24}">
              <Button x:Name="RetryButton" Style="{StaticResource Button.Primary}" Content="Retry" Command="{TemplateBinding RetryCommand}" Margin="{DynamicResource Inset.R8}" />
              <ToggleButton x:Name="DetailsToggle" Content="Details" IsChecked="{Binding IsDetailOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            AutomationProperties.Name="Details">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" MinHeight="{StaticResource Height.Control}" Padding="{DynamicResource Inset.H16}" CornerRadius="{StaticResource Radius.Control}"
                            Background="Transparent" BorderBrush="{DynamicResource Brush.BorderInput}" BorderThickness="1">
                      <TextBlock Text="{TemplateBinding Content}" Style="{StaticResource Text.Label}" Foreground="{DynamicResource Brush.TextPrimary}"
                                 VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                      </Trigger>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfacePressed}" />
                      </Trigger>
                      <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}" />
                        <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
            </StackPanel>
            <Border x:Name="DetailPanel" Visibility="Collapsed" Margin="{DynamicResource Inset.T16}" Padding="{DynamicResource Pad.12}" Background="{DynamicResource Brush.SurfaceRaised}"
                    CornerRadius="{StaticResource Radius.Control}">
              <StackPanel>
                <TextBox x:Name="PART_Detail" Text="{Binding Detail, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                         MinHeight="0" Padding="{DynamicResource Pad.8}" AutomationProperties.Name="Technical details" />
                <Button Style="{StaticResource Button.Ghost}" Content="Copy" Command="{Binding CopyDetailCommand, RelativeSource={RelativeSource TemplatedParent}}" HorizontalAlignment="Left" Margin="{DynamicResource Inset.T8}" />
              </StackPanel>
            </Border>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsDetailOpen" Value="True">
              <Setter TargetName="DetailPanel" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="RetryCommand" Value="{x:Null}">
              <Setter TargetName="RetryButton" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Detail" Value="{x:Null}">
              <Setter TargetName="DetailsToggle" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Status chip: icon + text + token colour. -->
  <Style TargetType="local:StatusChip">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:StatusChip">
          <Border MinHeight="24" Padding="{DynamicResource Inset.H8}" CornerRadius="{StaticResource Radius.Pill}" Background="{DynamicResource Brush.SurfaceRaised}"
                  BorderBrush="{TemplateBinding AccentBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <controls:IconText Style="{StaticResource Text.Icon}" Text="{TemplateBinding Glyph}" FontSize="12" Foreground="{TemplateBinding AccentBrush}"
                         VerticalAlignment="Center" Margin="{DynamicResource Inset.R6}" />
              <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextPrimary}" Text="{TemplateBinding DisplayText}"
                         TextWrapping="NoWrap" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Form field: label above, hint, error with icon below. -->
  <Style TargetType="local:FormField">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Margin" Value="{StaticResource Gap.Field}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:FormField">
          <StackPanel>
            <TextBlock x:Name="PART_Label" Style="{StaticResource Text.Label}" Text="{TemplateBinding Label}" Margin="{DynamicResource Inset.B4}" />
            <ContentPresenter />
            <TextBlock x:Name="HintText" Style="{StaticResource Text.Caption}" Text="{TemplateBinding Hint}" Margin="{DynamicResource Inset.T4}" />
            <StackPanel x:Name="ErrorRow" Orientation="Horizontal" Margin="{DynamicResource Inset.T4}">
              <controls:IconText Style="{StaticResource Text.Icon}" Text="&#xE783;" FontSize="12" Foreground="{DynamicResource Brush.StatusDanger}" VerticalAlignment="Top" Margin="{DynamicResource Inset.T2R6}" />
              <TextBlock x:Name="PART_Error" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.StatusDanger}" Text="{TemplateBinding Error}"
                         AutomationProperties.LiveSetting="Assertive" />
            </StackPanel>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="Hint" Value="{x:Null}">
              <Setter TargetName="HintText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Hint" Value="">
              <Setter TargetName="HintText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="HasError" Value="True">
              <Setter TargetName="HintText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Error" Value="{x:Null}">
              <Setter TargetName="ErrorRow" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Error" Value="">
              <Setter TargetName="ErrorRow" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Chart frame: the chart, or the same numbers as a table. -->
  <Style TargetType="local:ChartFrame">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:ChartFrame">
          <controls:Card Background="{DynamicResource Brush.SurfaceRaised}" BorderBrush="{DynamicResource Brush.BorderCard}" BorderThickness="1" CornerRadius="{StaticResource Radius.Card}" Padding="{DynamicResource Pad.16}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid Margin="{DynamicResource Inset.B12}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Text.Heading}" Text="{TemplateBinding Title}" VerticalAlignment="Center" />
                <ToggleButton x:Name="TableToggle" Grid.Column="1" IsChecked="{Binding IsTableShown, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                              AutomationProperties.Name="View as table" ToolTip="View as table">
                  <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                      <Border x:Name="Bd" MinHeight="32" MinWidth="40" Padding="{DynamicResource Inset.H12}" CornerRadius="{StaticResource Radius.Control}" Background="Transparent"
                              BorderBrush="{DynamicResource Brush.BorderInput}" BorderThickness="1">
                        <local:IconText x:Name="Glyph" Style="{StaticResource Text.Icon}" Text="&#xE9D9;" VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Foreground="{DynamicResource Brush.TextPrimary}" />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                          <Setter TargetName="Glyph" Property="Text" Value="&#xE9D2;" />
                          <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfacePressed}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                          <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}" />
                          <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </ToggleButton.Template>
                </ToggleButton>
              </Grid>
              <ContentPresenter x:Name="ChartHost" Grid.Row="1" />
              <local:LifestreamDataGrid x:Name="PART_Table" Grid.Row="1" Visibility="Collapsed" AutomationProperties.Name="Chart data table" />
            </Grid>
          </controls:Card>
          <ControlTemplate.Triggers>
            <Trigger Property="IsTableShown" Value="True">
              <Setter TargetName="ChartHost" Property="Visibility" Value="Hidden" />
              <Setter TargetName="PART_Table" Property="Visibility" Value="Visible" />
              <Setter TargetName="TableToggle" Property="AutomationProperties.Name" Value="View as chart" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Load surface: skeleton, content, empty and error in one cell. -->
  <Style TargetType="local:LoadSurface">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:LoadSurface">
          <Grid>
            <ContentPresenter x:Name="PART_Content" />
            <local:Skeleton x:Name="PART_Skeleton" Visibility="Hidden" Kind="{TemplateBinding SkeletonKind}" ColumnWidths="{TemplateBinding SkeletonColumns}" />
            <Border x:Name="PART_WakingBanner" Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="{DynamicResource Inset.T16}" Padding="{DynamicResource Inset.H16V12}"
                    Background="{DynamicResource Brush.SurfacePressed}" BorderBrush="{DynamicResource Brush.StatusInfo}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Card}">
              <StackPanel Orientation="Horizontal">
                <controls:IconText Style="{StaticResource Text.Icon}" Text="&#xE895;" Foreground="{DynamicResource Brush.StatusInfo}" VerticalAlignment="Center" Margin="{DynamicResource Inset.R12}" />
                <TextBlock Style="{StaticResource Text.Body}" Text="Waking up the server, this can take up to a minute" VerticalAlignment="Center" Margin="{DynamicResource Inset.R16}"
                           TextWrapping="NoWrap" />
                <Button Style="{StaticResource Button.Secondary}" Content="Retry" Command="{TemplateBinding RetryCommand}" MinHeight="32" Margin="{DynamicResource Inset.R8}" />
                <Button x:Name="PART_CancelWaking" Style="{StaticResource Button.Ghost}" Content="Cancel" />
              </StackPanel>
            </Border>
            <local:EmptyState x:Name="PART_Empty" Visibility="Collapsed" Glyph="{TemplateBinding EmptyGlyph}" Title="{TemplateBinding EmptyTitle}"
                              Message="{TemplateBinding EmptyMessage}" ActionText="{TemplateBinding EmptyActionText}" ActionCommand="{TemplateBinding EmptyActionCommand}" />
            <local:ErrorState x:Name="PART_Error" Visibility="Collapsed" Message="{TemplateBinding ErrorMessage}" Detail="{TemplateBinding ErrorDetail}"
                              RetryCommand="{TemplateBinding RetryCommand}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="State" Value="Loading">
              <Setter TargetName="PART_Content" Property="Visibility" Value="Hidden" />
              <Setter TargetName="PART_Skeleton" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="State" Value="Waking">
              <Setter TargetName="PART_Content" Property="Visibility" Value="Hidden" />
              <Setter TargetName="PART_Skeleton" Property="Visibility" Value="Visible" />
              <Setter TargetName="PART_WakingBanner" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="State" Value="Empty">
              <Setter TargetName="PART_Content" Property="Visibility" Value="Hidden" />
              <Setter TargetName="PART_Empty" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="State" Value="Error">
              <Setter TargetName="PART_Content" Property="Visibility" Value="Hidden" />
              <Setter TargetName="PART_Error" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
