<ResourceDictionary xmlns:controls="clr-namespace:Lifestream.Desktop.Controls" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Lifestream.Desktop.Controls">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Lifestream;component/Theme/Tokens.xaml" />
    <ResourceDictionary Source="/Lifestream;component/Theme/Motion.xaml" />
    <ResourceDictionary Source="/Lifestream;component/Theme/Typography.xaml" />
    <ResourceDictionary Source="/Lifestream;component/Controls/Buttons.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- Surfaces of direction A, "Ward": empty and error states, status chip, form field, chart frame, load surface. Colours are DynamicResource brushes. -->

  <!-- Spacing used only here (the shared tokens have no exact match) -->
  <Thickness x:Key="Surfaces.Pad.Frame">20,26,20,26</Thickness>
  <Thickness x:Key="Surfaces.Gap.Action">0,14,0,0</Thickness>
  <Thickness x:Key="Surfaces.Gap.Label">0,0,0,6</Thickness>
  <Thickness x:Key="Surfaces.Gap.Help">0,6,0,0</Thickness>
  <Thickness x:Key="Surfaces.Gap.Subtitle">10,0,0,0</Thickness>
  <Thickness x:Key="Surfaces.Gap.Legend">0,0,14,0</Thickness>

  <!-- A subtle text toggle (Button.Subtle.Small look: Hover fill, Selected fill while on) for "Details" and "View as table". -->
  <Style x:Key="Surfaces.SubtleToggle" TargetType="ToggleButton">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.None}" />
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Label}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="MinHeight" Value="{StaticResource Height.Compact}" />
    <Setter Property="Padding" Value="{StaticResource Pad.ButtonSmall}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid x:Name="Host" SnapsToDevicePixels="True" Background="Transparent">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" />
                    <DoubleAnimation Storyboard.TargetName="PressedLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" />
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="MouseOver">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" />
                    <DoubleAnimation Storyboard.TargetName="PressedLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" />
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" />
                    <DoubleAnimation Storyboard.TargetName="PressedLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" />
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Disabled" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="CheckedLayer" Opacity="0" Background="{DynamicResource Brush.Selected}" CornerRadius="{StaticResource Radius.Control}" IsHitTestVisible="False" />
            <Border x:Name="HoverLayer" Opacity="0" Background="{DynamicResource Brush.Hover}" CornerRadius="{StaticResource Radius.Control}" IsHitTestVisible="False" />
            <Border x:Name="PressedLayer" Opacity="0" Background="{DynamicResource Brush.Selected}" CornerRadius="{StaticResource Radius.Control}" IsHitTestVisible="False" />
            <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
            <controls:CrispBorder x:Name="FocusRing" Margin="{DynamicResource Inset.Neg4}" CornerRadius="{StaticResource Radius.FocusRing}" BorderThickness="{StaticResource Thickness.FocusRing}"
                                  BorderBrush="{DynamicResource Brush.Focus}" Visibility="Collapsed" IsHitTestVisible="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="CheckedLayer" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="controls:FocusAssist.ShowRing" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Empty state (.empty): a dashed Stroke2 frame (a Rectangle, since a border cannot dash) on Layer; Icon (or the old Glyph when Icon is None), title, message, action. -->
  <Style TargetType="local:EmptyState">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:EmptyState">
          <Grid>
            <Rectangle Fill="{DynamicResource Brush.Layer}" Stroke="{DynamicResource Brush.Stroke2}" StrokeThickness="1" StrokeDashArray="3 3" RadiusX="8" RadiusY="8"
                       SnapsToDevicePixels="False" IsHitTestVisible="False" />
            <StackPanel Margin="{StaticResource Surfaces.Pad.Frame}" HorizontalAlignment="Center">
              <controls:Icon x:Name="IconPart" Kind="{TemplateBinding Icon}" Size="32" IsFilled="True" Foreground="{DynamicResource Brush.Ink3}" HorizontalAlignment="Center" />
              <controls:IconText x:Name="GlyphPart" Style="{StaticResource Text.Icon}" Text="{TemplateBinding Glyph}" FontSize="32" Foreground="{DynamicResource Brush.Ink3}"
                                 HorizontalAlignment="Center" Visibility="Collapsed" />
              <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{TemplateBinding Title}" TextAlignment="Center" Margin="{StaticResource Inset.T12}" />
              <TextBlock x:Name="MessageText" Style="{StaticResource Text.Secondary}" MaxWidth="360" Text="{TemplateBinding Message}" TextAlignment="Center"
                         Margin="{StaticResource Inset.T4}" />
              <Button x:Name="ActionButton" Style="{StaticResource Button.Secondary.Small}" Content="{TemplateBinding ActionText}" Command="{TemplateBinding ActionCommand}"
                      HorizontalAlignment="Center" Margin="{StaticResource Surfaces.Gap.Action}" />
            </StackPanel>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="None">
              <Setter TargetName="IconPart" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="GlyphPart" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="Message" Value="{x:Null}">
              <Setter TargetName="MessageText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="ActionCommand" Value="{x:Null}">
              <Setter TargetName="ActionButton" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Error state: the empty state's frame with a solid Stroke2 edge, a Critical alert icon, plain cause, Retry, technical detail behind Details. -->
  <Style TargetType="local:ErrorState">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:ErrorState">
          <controls:CrispBorder Background="{DynamicResource Brush.Layer}" BorderBrush="{DynamicResource Brush.Stroke2}" BorderThickness="1" CornerRadius="{StaticResource Radius.Panel}">
            <StackPanel MaxWidth="480" Margin="{StaticResource Surfaces.Pad.Frame}" HorizontalAlignment="Center">
              <controls:Icon Kind="Alert" Size="32" Foreground="{DynamicResource Brush.Critical}" HorizontalAlignment="Center" />
              <TextBlock x:Name="PART_Message" Style="{StaticResource Text.Body}" Text="{TemplateBinding Message}" TextAlignment="Center" Margin="{StaticResource Inset.T12}"
                         AutomationProperties.LiveSetting="Assertive" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="{StaticResource Surfaces.Gap.Action}">
                <Button x:Name="RetryButton" Style="{StaticResource Button.Secondary.Small}" Content="Retry" Command="{TemplateBinding RetryCommand}" Margin="{StaticResource Inset.R8}" />
                <ToggleButton x:Name="DetailsToggle" Style="{StaticResource Surfaces.SubtleToggle}" Content="Details"
                              IsChecked="{Binding IsDetailOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" AutomationProperties.Name="Details" />
              </StackPanel>
              <controls:CrispBorder x:Name="DetailPanel" Visibility="Collapsed" Margin="{StaticResource Inset.T16}" Padding="{StaticResource Pad.12}" Background="{DynamicResource Brush.Layer2}"
                                    BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1" CornerRadius="{StaticResource Radius.Control}">
                <StackPanel>
                  <TextBox x:Name="PART_Detail" Text="{Binding Detail, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                           MinHeight="0" Padding="{StaticResource Pad.8}" AutomationProperties.Name="Technical details" />
                  <Button Style="{StaticResource Button.Subtle.Small}" Content="Copy" Command="{Binding CopyDetailCommand, RelativeSource={RelativeSource TemplatedParent}}"
                          HorizontalAlignment="Left" Margin="{StaticResource Inset.T8}" />
                </StackPanel>
              </controls:CrispBorder>
            </StackPanel>
          </controls:CrispBorder>
          <ControlTemplate.Triggers>
            <Trigger Property="IsDetailOpen" Value="True">
              <Setter TargetName="DetailPanel" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="RetryCommand" Value="{x:Null}">
              <Setter TargetName="RetryButton" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Detail" Value="{x:Null}">
              <Setter TargetName="DetailsToggle" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Status chip: the Badge look (soft fill by status) with the status icon; the chip carries the accessible name. -->
  <Style TargetType="local:StatusChip">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:StatusChip">
          <controls:Badge Text="{TemplateBinding DisplayText}" Kind="{TemplateBinding Kind}" Icon="{TemplateBinding Icon}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Form field: label (13 Medium Ink2) 6 above, the input, hint (12 Ink3) 6 below, or the error (12 Critical with a 14 alert icon). -->
  <Style TargetType="local:FormField">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Margin" Value="{StaticResource Gap.Field}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:FormField">
          <StackPanel>
            <TextBlock x:Name="PART_Label" Style="{StaticResource Text.Label}" Text="{TemplateBinding Label}" Margin="{StaticResource Surfaces.Gap.Label}" />
            <ContentPresenter />
            <TextBlock x:Name="HintText" Style="{StaticResource Text.Caption}" Text="{TemplateBinding Hint}" Margin="{StaticResource Surfaces.Gap.Help}" />
            <StackPanel x:Name="ErrorRow" Orientation="Horizontal" Margin="{StaticResource Surfaces.Gap.Help}">
              <controls:Icon Kind="Alert" Size="14" Foreground="{DynamicResource Brush.Critical}" VerticalAlignment="Center" Margin="{StaticResource Inset.R6}" />
              <TextBlock x:Name="PART_Error" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Critical}" Text="{TemplateBinding Error}"
                         VerticalAlignment="Center" AutomationProperties.LiveSetting="Assertive" />
            </StackPanel>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="Hint" Value="{x:Null}">
              <Setter TargetName="HintText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Hint" Value="">
              <Setter TargetName="HintText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="HasError" Value="True">
              <Setter TargetName="HintText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Error" Value="{x:Null}">
              <Setter TargetName="ErrorRow" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Error" Value="">
              <Setter TargetName="ErrorRow" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <!-- While the field shows an error, the input inside takes the error look (the Critical edge and bar), whatever kind of input it is. -->
      <Trigger Property="HasError" Value="True">
        <Setter Property="controls:InputAssist.HasError" Value="True" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Chart frame: the Section look (Layer panel, 15 SemiBold heading, a subtle "View as table" toggle), then the chart or the same numbers as a table. -->
  <Style TargetType="local:ChartFrame">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Padding" Value="{StaticResource Pad.PanelBody}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:ChartFrame">
          <controls:CrispBorder Background="{DynamicResource Brush.Layer}" BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1" CornerRadius="{StaticResource Radius.Panel}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid Margin="{StaticResource Pad.PanelHeader}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Text.Heading}" Text="{TemplateBinding Title}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           AutomationProperties.HeadingLevel="Level2" />
                <TextBlock x:Name="SubtitleText" Grid.Column="1" Style="{StaticResource Text.Secondary}" Foreground="{DynamicResource Brush.Ink3}" Text="{TemplateBinding Subtitle}"
                           TextWrapping="NoWrap" VerticalAlignment="Center" Margin="{StaticResource Surfaces.Gap.Subtitle}" />
                <ContentPresenter x:Name="LegendHost" Grid.Column="3" Content="{TemplateBinding Legend}" VerticalAlignment="Center" Margin="{StaticResource Surfaces.Gap.Legend}" />
                <ToggleButton x:Name="TableToggle" Grid.Column="4" Style="{StaticResource Surfaces.SubtleToggle}" Content="View as table"
                              IsChecked="{Binding IsTableShown, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" AutomationProperties.Name="View as table" />
              </Grid>
              <Grid Grid.Row="1" Margin="{TemplateBinding Padding}">
                <ContentPresenter x:Name="ChartHost" />
                <local:LifestreamDataGrid x:Name="PART_Table" Visibility="Collapsed" AutomationProperties.Name="Chart data table" />
              </Grid>
            </Grid>
          </controls:CrispBorder>
          <ControlTemplate.Triggers>
            <Trigger Property="Subtitle" Value="{x:Null}">
              <Setter TargetName="SubtitleText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Subtitle" Value="">
              <Setter TargetName="SubtitleText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Legend" Value="{x:Null}">
              <Setter TargetName="LegendHost" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsTableShown" Value="True">
              <Setter TargetName="ChartHost" Property="Visibility" Value="Hidden" />
              <Setter TargetName="PART_Table" Property="Visibility" Value="Visible" />
              <Setter TargetName="TableToggle" Property="Content" Value="View as chart" />
              <Setter TargetName="TableToggle" Property="AutomationProperties.Name" Value="View as chart" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Load surface: skeleton, content, empty and error in one cell; the waking banner is InfoSoft with a Stroke edge. Only the state on show takes room: the
       skeleton is collapsed outside Loading and Waking and the content is collapsed in Empty and Error, so the empty and error states start at the top of
       the surface (where the list's first row would be) on every screen, whatever height the skeleton or a hidden table would have had. While loading, the
       content stays hidden (not collapsed), so a surface that sizes to its content keeps its place. -->
  <Style TargetType="local:LoadSurface">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:LoadSurface">
          <Grid>
            <ContentPresenter x:Name="PART_Content" />
            <local:Skeleton x:Name="PART_Skeleton" Visibility="Collapsed" Kind="{TemplateBinding SkeletonKind}" ColumnWidths="{TemplateBinding SkeletonColumns}" />
            <controls:CrispBorder x:Name="PART_WakingBanner" Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="{StaticResource Inset.T16}"
                                  Padding="{StaticResource Inset.H16V12}" Background="{DynamicResource Brush.InfoSoft}" BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1"
                                  CornerRadius="{StaticResource Radius.Panel}">
              <StackPanel Orientation="Horizontal">
                <controls:Icon Kind="Sync" Size="16" Foreground="{DynamicResource Brush.Info}" VerticalAlignment="Center" Margin="{StaticResource Inset.R12}" />
                <TextBlock Style="{StaticResource Text.Body}" Text="Waking up the server, this can take about a minute and a half" VerticalAlignment="Center" Margin="{StaticResource Inset.R16}"
                           TextWrapping="NoWrap" />
                <Button Style="{StaticResource Button.Secondary.Small}" Content="Retry" Command="{TemplateBinding RetryCommand}" Margin="{StaticResource Inset.R8}" />
                <Button x:Name="PART_CancelWaking" Style="{StaticResource Button.Subtle.Small}" Content="Cancel" />
              </StackPanel>
            </controls:CrispBorder>
            <local:EmptyState x:Name="PART_Empty" Visibility="Collapsed" VerticalAlignment="Top" Icon="{TemplateBinding EmptyIcon}" Glyph="{TemplateBinding EmptyGlyph}" Title="{TemplateBinding EmptyTitle}"
                              Message="{TemplateBinding EmptyMessage}" ActionText="{TemplateBinding EmptyActionText}" ActionCommand="{TemplateBinding EmptyActionCommand}" />
            <local:ErrorState x:Name="PART_Error" Visibility="Collapsed" VerticalAlignment="Top" Message="{TemplateBinding ErrorMessage}" Detail="{TemplateBinding ErrorDetail}"
                              RetryCommand="{TemplateBinding RetryCommand}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="State" Value="Loading">
              <Setter TargetName="PART_Content" Property="Visibility" Value="Hidden" />
              <Setter TargetName="PART_Skeleton" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="State" Value="Waking">
              <Setter TargetName="PART_Content" Property="Visibility" Value="Hidden" />
              <Setter TargetName="PART_Skeleton" Property="Visibility" Value="Visible" />
              <Setter TargetName="PART_WakingBanner" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="State" Value="Empty">
              <Setter TargetName="PART_Content" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="PART_Empty" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="State" Value="Error">
              <Setter TargetName="PART_Content" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="PART_Error" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
