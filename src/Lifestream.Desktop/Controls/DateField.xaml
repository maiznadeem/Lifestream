<UserControl x:Class="Lifestream.Desktop.Controls.DateField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Lifestream.Desktop.Controls"
             Focusable="False" IsTabStop="False">
  <Grid>
    <!-- The text is always in the one app format (dd MMM yyyy); typing another format is refused with a message, never guessed. -->
    <TextBox x:Name="Box" Padding="{DynamicResource Inset.L12R44}" MaxLength="11" LostFocus="OnBoxLostFocus" KeyDown="OnBoxKeyDown" AutomationProperties.HelpText="Format: 05 Mar 2022" />
    <Button x:Name="OpenButton" Style="{DynamicResource Button.Icon}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="{DynamicResource Inset.R4}" Click="OnOpenClick"
            AutomationProperties.Name="Open calendar" ToolTip="Open calendar">
      <controls:IconText Style="{DynamicResource Text.Icon}" Text="&#xE787;" />
    </Button>
    <Popup x:Name="CalendarPopup" PlacementTarget="{Binding ElementName=Box}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
      <Border Margin="{DynamicResource Inset.T4B8}" Background="{DynamicResource Brush.SurfaceRaised}" BorderBrush="{DynamicResource Brush.BorderInput}" BorderThickness="1"
              CornerRadius="{DynamicResource Radius.Card}" Padding="{DynamicResource Pad.4}">
        <Calendar x:Name="Picker" SelectedDatesChanged="OnCalendarChanged" Background="{DynamicResource Brush.SurfaceRaised}" Foreground="{DynamicResource Brush.TextPrimary}"
                  BorderThickness="0" AutomationProperties.Name="Calendar" />
      </Border>
    </Popup>
  </Grid>
</UserControl>
