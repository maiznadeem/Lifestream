<ResourceDictionary xmlns:controls="clr-namespace:Lifestream.Desktop.Controls" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:assist="clr-namespace:Lifestream.Desktop.Controls">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Lifestream;component/Theme/Tokens.xaml" />
    <ResourceDictionary Source="/Lifestream;component/Theme/Motion.xaml" />
    <ResourceDictionary Source="/Lifestream;component/Theme/Typography.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- Selection controls of direction A, "Ward": radio button, toggle switch, segmented control and tabs. Each has hover, pressed, keyboard focus ring and disabled states, every colour
       from tokens. Keys:
         RadioButton.Lifestream (implicit for RadioButton) .... an 18 px circle
         ToggleSwitch ............................................ style for a CheckBox: a 40 x 20 switch with an optional label
         Segmented / Segmented.Item ............................ style for a ListBox (and its items): the segmented well
         Segmented.Well + Segmented.Option ................... the same look from RadioButtons: <Border Style="Segmented.Well"><StackPanel Orientation="Horizontal"> RadioButtons with Style="Segmented.Option" and one GroupName
         Tabs / Tabs.Item ........................................ style for a TabControl (and its TabItems): underline tabs
         Tab.Option + Tabs.Strip ................................... the same look from RadioButtons for a page header: <Border Style="Tabs.Strip"><StackPanel Orientation="Horizontal" Margin="{DynamicResource Inset.BN1}"> RadioButtons
                                                                    with Style="Tab.Option" and one GroupName (the -1 lets the 2 px bar of the selected tab cover the strip's line) -->

  <!-- Radio button: an 18 px circle, a Stroke2 ring; selected: a Primary ring with an 8 px Primary dot. The label is 13 px Ink2 with an 8 px gap. -->
  <Style x:Key="RadioButton.Lifestream" TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Label}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
    <Setter Property="MinHeight" Value="{StaticResource Height.Compact}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid VerticalAlignment="Center">
              <controls:CrispBorder x:Name="Ring" Width="18" Height="18" BorderThickness="1" BorderBrush="{DynamicResource Brush.Stroke2}"
                      Background="{DynamicResource Brush.Layer}" CornerRadius="{DynamicResource Radius.9}">
                <Border x:Name="Dot" Width="8" Height="8" CornerRadius="{DynamicResource Radius.4}" Background="{DynamicResource Brush.Primary}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
              </controls:CrispBorder>
              <controls:CrispBorder x:Name="FocusRing" Margin="{DynamicResource Inset.Neg4}" CornerRadius="{DynamicResource Radius.13}" BorderThickness="{StaticResource Thickness.FocusRing}"
                      BorderBrush="{DynamicResource Brush.Focus}" Visibility="Collapsed" IsHitTestVisible="False" />
            </Grid>
            <ContentPresenter x:Name="Label" Grid.Column="1" Margin="{DynamicResource Inset.L8}" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="HasContent" Value="False">
              <Setter TargetName="Label" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Ring" Property="Background" Value="{DynamicResource Brush.Layer2}" />
              <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Brush.StrokeStrong}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Ring" Property="Background" Value="{DynamicResource Brush.Selected}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
              <Setter TargetName="Ring" Property="BorderThickness" Value="2" />
              <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="assist:FocusAssist.ShowRing" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
              <Setter TargetName="Ring" Property="Background" Value="{DynamicResource Brush.Layer2}" />
              <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Brush.Stroke}" />
              <Setter TargetName="Dot" Property="Background" Value="{DynamicResource Brush.Stroke2}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="RadioButton" BasedOn="{StaticResource RadioButton.Lifestream}" />

  <!-- Toggle switch (a CheckBox): a 40 x 20 track, radius 10. Off: Layer with a 1 px StrokeStrong border and a 12 px Ink2 knob at the left. On: a Primary track with a 12 px OnPrimary
       knob at the right. The knob slides over Motion.Fast. -->
  <Style x:Key="ToggleSwitch" TargetType="CheckBox">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Label}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
    <Setter Property="MinHeight" Value="{StaticResource Height.Compact}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="40" Height="20" VerticalAlignment="Center">
              <controls:CrispBorder x:Name="Track" BorderThickness="1" BorderBrush="{DynamicResource Brush.StrokeStrong}" Background="{DynamicResource Brush.Layer}" CornerRadius="{DynamicResource Radius.10}" />
              <Border x:Name="Knob" Width="12" Height="12" CornerRadius="{DynamicResource Radius.6}" Background="{DynamicResource Brush.Ink2}" HorizontalAlignment="Left" VerticalAlignment="Center"
                      Margin="{DynamicResource Inset.L4}" IsHitTestVisible="False">
                <Border.RenderTransform>
                  <TranslateTransform X="0" />
                </Border.RenderTransform>
              </Border>
              <controls:CrispBorder x:Name="FocusRing" Margin="{DynamicResource Inset.Neg4}" CornerRadius="{DynamicResource Radius.14}" BorderThickness="{StaticResource Thickness.FocusRing}"
                      BorderBrush="{DynamicResource Brush.Focus}" Visibility="Collapsed" IsHitTestVisible="False" />
            </Grid>
            <ContentPresenter x:Name="Label" Grid.Column="1" Margin="{DynamicResource Inset.L10}" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="HasContent" Value="False">
              <Setter TargetName="Label" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Layer2}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Primary}" />
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
              <Setter TargetName="Knob" Property="Background" Value="{DynamicResource Brush.OnPrimary}" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="20" Duration="{StaticResource Motion.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="{StaticResource Motion.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True" />
                <Condition Property="IsChecked" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.PrimaryHover}" />
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.PrimaryHover}" />
            </MultiTrigger>
            <Trigger Property="assist:FocusAssist.ShowRing" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Layer2}" />
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.Stroke}" />
              <Setter TargetName="Knob" Property="Background" Value="{DynamicResource Brush.Ink3}" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsEnabled" Value="False" />
                <Condition Property="IsChecked" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Stroke2}" />
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.Stroke2}" />
              <Setter TargetName="Knob" Property="Background" Value="{DynamicResource Brush.Layer}" />
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Segmented control: a well (ink at 6 %, radius 8, padding 3, 2 between segments); a segment has padding 5 12, radius 6, 13 px Ink2; the selected one is a Layer face, Ink, SemiBold, with a
       soft 0 1 2 shadow drawn by a separate Border behind it (never an effect on the text). -->
  <Style x:Key="Segmented.Item" TargetType="ListBoxItem">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Label}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
    <Setter Property="Padding" Value="{DynamicResource Inset.H12V5}" />
    <Setter Property="Margin" Value="{DynamicResource Inset.H1}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid SnapsToDevicePixels="True">
            <Border x:Name="FaceShadow" Background="{DynamicResource Brush.Layer}" CornerRadius="{StaticResource Radius.Control}" Visibility="Collapsed" IsHitTestVisible="False">
              <Border.Effect>
                <DropShadowEffect BlurRadius="2" ShadowDepth="1" Direction="270" Opacity="0.12" Color="{DynamicResource Color.Shadow}" />
              </Border.Effect>
            </Border>
            <Border x:Name="HoverLayer" Background="{DynamicResource Brush.Layer}" Opacity="0" CornerRadius="{StaticResource Radius.Control}" IsHitTestVisible="False" />
            <Border x:Name="Face" Background="Transparent" CornerRadius="{StaticResource Radius.Control}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
            <controls:CrispBorder x:Name="FocusRing" Margin="{DynamicResource Inset.Neg3}" CornerRadius="{StaticResource Radius.Panel}" BorderThickness="{StaticResource Thickness.FocusRing}"
                    BorderBrush="{DynamicResource Brush.Focus}" Visibility="Collapsed" IsHitTestVisible="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0.6" Duration="{StaticResource Motion.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Brush.Layer}" />
              <Setter TargetName="FaceShadow" Property="Visibility" Value="Visible" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="assist:FocusAssist.ShowRing" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Segmented" TargetType="ListBox">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Label}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="{DynamicResource Inset.H2V3}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="SelectionMode" Value="Single" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource Segmented.Item}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <Border Background="{DynamicResource Brush.Well}" CornerRadius="{StaticResource Radius.Panel}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ItemsPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The same segmented look from RadioButtons (one GroupName): the well is a Border, the segments are RadioButtons. -->
  <Style x:Key="Segmented.Well" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.Well}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Panel}" />
    <Setter Property="Padding" Value="{DynamicResource Inset.H2V3}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="Segmented.Option" TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Label}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
    <Setter Property="Padding" Value="{DynamicResource Inset.H12V5}" />
    <Setter Property="Margin" Value="{DynamicResource Inset.H1}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid SnapsToDevicePixels="True">
            <Border x:Name="FaceShadow" Background="{DynamicResource Brush.Layer}" CornerRadius="{StaticResource Radius.Control}" Visibility="Collapsed" IsHitTestVisible="False">
              <Border.Effect>
                <DropShadowEffect BlurRadius="2" ShadowDepth="1" Direction="270" Opacity="0.12" Color="{DynamicResource Color.Shadow}" />
              </Border.Effect>
            </Border>
            <Border x:Name="HoverLayer" Background="{DynamicResource Brush.Layer}" Opacity="0" CornerRadius="{StaticResource Radius.Control}" IsHitTestVisible="False" />
            <Border x:Name="Face" Background="Transparent" CornerRadius="{StaticResource Radius.Control}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
            </Border>
            <controls:CrispBorder x:Name="FocusRing" Margin="{DynamicResource Inset.Neg3}" CornerRadius="{StaticResource Radius.Panel}" BorderThickness="{StaticResource Thickness.FocusRing}"
                    BorderBrush="{DynamicResource Brush.Focus}" Visibility="Collapsed" IsHitTestVisible="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0.6" Duration="{StaticResource Motion.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Brush.Layer}" />
              <Setter TargetName="FaceShadow" Property="Visibility" Value="Visible" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="assist:FocusAssist.ShowRing" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Tabs (underline): items with padding 8 10 and 13 px text; the selected tab is SemiBold Ink with a 2 px Blood bar along its bottom; the others are Ink2; a 1 px Stroke line runs
       under the strip. -->
  <Style x:Key="Tabs.Item" TargetType="TabItem">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Label}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
    <Setter Property="Padding" Value="{DynamicResource Inset.H10V8}" />
    <Setter Property="Margin" Value="{DynamicResource Inset.R2}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True">
            <Border x:Name="HoverLayer" Background="{DynamicResource Brush.Hover}" Opacity="0" CornerRadius="{StaticResource Radius.Small}" IsHitTestVisible="False" />
            <ContentPresenter x:Name="Header" ContentSource="Header" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
            <Border x:Name="Bar" Height="2" VerticalAlignment="Bottom" Background="{DynamicResource Brush.Blood}" Visibility="Collapsed" IsHitTestVisible="False" />
            <controls:CrispBorder x:Name="FocusRing" Margin="{DynamicResource Inset.Neg3}" CornerRadius="{StaticResource Radius.Panel}" BorderThickness="{StaticResource Thickness.FocusRing}"
                    BorderBrush="{DynamicResource Brush.Focus}" Visibility="Collapsed" IsHitTestVisible="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
              <Setter Property="FontWeight" Value="SemiBold" />
              <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="assist:FocusAssist.ShowRing" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Tabs" TargetType="TabControl">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Label}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource Tabs.Item}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <Grid KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
              <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource Brush.Stroke}" />
              <TabPanel x:Name="HeaderPanel" IsItemsHost="True" Background="Transparent" KeyboardNavigation.TabIndex="1" />
            </Grid>
            <Border Grid.Row="1" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabIndex="2">
              <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The same underline look from RadioButtons (one GroupName), for the view tabs in a page header. -->
  <Style x:Key="Tabs.Strip" TargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="Tab.Option" TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Label}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
    <Setter Property="Padding" Value="{DynamicResource Inset.H10V8}" />
    <Setter Property="Margin" Value="{DynamicResource Inset.R2}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True">
            <Border x:Name="HoverLayer" Background="{DynamicResource Brush.Hover}" Opacity="0" CornerRadius="{StaticResource Radius.Small}" IsHitTestVisible="False" />
            <ContentPresenter x:Name="Header" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
            <Border x:Name="Bar" Height="2" VerticalAlignment="Bottom" Background="{DynamicResource Brush.Blood}" Visibility="Collapsed" IsHitTestVisible="False" />
            <controls:CrispBorder x:Name="FocusRing" Margin="{DynamicResource Inset.Neg3}" CornerRadius="{StaticResource Radius.Panel}" BorderThickness="{StaticResource Thickness.FocusRing}"
                    BorderBrush="{DynamicResource Brush.Focus}" Visibility="Collapsed" IsHitTestVisible="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
              <Setter Property="FontWeight" Value="SemiBold" />
              <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="assist:FocusAssist.ShowRing" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
