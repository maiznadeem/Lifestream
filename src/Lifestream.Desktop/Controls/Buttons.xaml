<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:assist="clr-namespace:Lifestream.Desktop.Controls">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Lifestream;component/Theme/Tokens.xaml" />
    <ResourceDictionary Source="/Lifestream;component/Theme/Motion.xaml" />
    <ResourceDictionary Source="/Lifestream;component/Theme/Typography.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- Buttons of direction A, "Ward" (the .btn CSS): 34 tall (28 small), radius 6, 14 Medium, a 1 px border. One template, variants by style: primary, secondary
       (tonal is the same), subtle (ghost is the same), danger, icon (square), chip (dashed "+ Blood group" filter), each with a Small size. Six states each (idle, hover,
       pressed, keyboard focus, busy, disabled), all colours from tokens. The Content may be a StackPanel with an Icon and a label: the Icon follows the Foreground. -->

  <Style x:Key="FocusVisual.None">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <ControlTemplate x:Key="Button.Template" TargetType="Button">
    <assist:ButtonHost x:Name="Host" SnapsToDevicePixels="True">
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal">
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" />
              <DoubleAnimation Storyboard.TargetName="PressedLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" />
            </Storyboard>
          </VisualState>
          <VisualState x:Name="MouseOver">
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" />
              <DoubleAnimation Storyboard.TargetName="PressedLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" />
            </Storyboard>
          </VisualState>
          <VisualState x:Name="Pressed">
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" />
              <DoubleAnimation Storyboard.TargetName="PressedLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" />
            </Storyboard>
          </VisualState>
          <VisualState x:Name="Disabled" />
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>

      <assist:CrispBorder x:Name="Rest" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.Control}" />
      <Border x:Name="HoverLayer" Opacity="0" Margin="{TemplateBinding BorderThickness}" Background="{TemplateBinding assist:ButtonAssist.HoverBackground}"
              CornerRadius="{StaticResource Radius.Control}" IsHitTestVisible="False" />
      <Border x:Name="PressedLayer" Opacity="0" Margin="{TemplateBinding BorderThickness}" Background="{TemplateBinding assist:ButtonAssist.PressedBackground}"
              CornerRadius="{StaticResource Radius.Control}" IsHitTestVisible="False" />
      <!-- The primary variant's 1 px bottom shade (inset 0 -1px): a line inside the template, no effect. Other variants set no Sheen brush. -->
      <Border x:Name="Sheen" Height="1" VerticalAlignment="Bottom" Margin="{DynamicResource Inset.L4R4B1}" Background="{TemplateBinding assist:ButtonAssist.Sheen}"
              IsHitTestVisible="False" SnapsToDevicePixels="True" />

      <!-- The label layer and the busy layer share one cell and are both measured (Hidden, not Collapsed), so the button
           is as wide as the wider of the two and nothing moves when it turns busy. An icon-only button has no busy text (see the HasLabel trigger). -->
      <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        RecognizesAccessKey="True" />
      <StackPanel x:Name="BusyLayer" Orientation="Horizontal" Visibility="Hidden" Margin="{TemplateBinding Padding}"
                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
        <Path x:Name="Spinner" Width="14" Height="14" Margin="{DynamicResource Inset.R8}" Stretch="Uniform" StrokeThickness="2"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{TemplateBinding Foreground}"
              Data="M 8,1 A 7,7 0 1 1 1,8" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
          <Path.RenderTransform>
            <RotateTransform x:Name="SpinnerRotate" Angle="0" />
          </Path.RenderTransform>
        </Path>
        <TextBlock x:Name="BusyLabel" VerticalAlignment="Center" TextWrapping="NoWrap"
                   Text="{TemplateBinding assist:ButtonAssist.BusyText}" />
      </StackPanel>

      <assist:CrispBorder x:Name="FocusRing" Margin="{DynamicResource Inset.Neg4}" CornerRadius="{StaticResource Radius.FocusRing}" BorderThickness="{StaticResource Thickness.FocusRing}"
              BorderBrush="{DynamicResource Brush.Focus}" Visibility="Collapsed" IsHitTestVisible="False" />
    </assist:ButtonHost>
    <ControlTemplate.Triggers>
      <Trigger Property="assist:FocusAssist.ShowRing" Value="True">
        <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
      </Trigger>
      <!-- An icon-only button (ButtonHost finds no visible text in the content) turns busy with the spinner alone: the busy text is not measured,
           so the button is as wide as its icon, busy or not. -->
      <Trigger Property="assist:ButtonAssist.HasLabel" Value="False">
        <Setter TargetName="BusyLabel" Property="Visibility" Value="Collapsed" />
        <Setter TargetName="Spinner" Property="Margin" Value="0" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Sheen" Property="Visibility" Value="Collapsed" />
      </Trigger>
      <Trigger Property="assist:ButtonAssist.IsBusy" Value="True">
        <Setter TargetName="Content" Property="Visibility" Value="Hidden" />
        <Setter TargetName="BusyLayer" Property="Visibility" Value="Visible" />
        <Trigger.EnterActions>
          <BeginStoryboard x:Name="SpinStoryboard">
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="SpinnerRotate" Storyboard.TargetProperty="Angle" From="0" To="360"
                               Duration="{StaticResource Motion.SpinnerTurn}" RepeatBehavior="{StaticResource Motion.SpinnerRepeat}" />
            </Storyboard>
          </BeginStoryboard>
        </Trigger.EnterActions>
        <Trigger.ExitActions>
          <StopStoryboard BeginStoryboardName="SpinStoryboard" />
        </Trigger.ExitActions>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <!-- The dashed filter chip ("+ Blood group"): the same states, with a dashed 1 px rectangle for the edge (a border cannot dash). -->
  <ControlTemplate x:Key="Button.Chip.Template" TargetType="Button">
    <Grid x:Name="Host" SnapsToDevicePixels="True">
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal">
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" />
              <DoubleAnimation Storyboard.TargetName="PressedLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" />
            </Storyboard>
          </VisualState>
          <VisualState x:Name="MouseOver">
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" />
              <DoubleAnimation Storyboard.TargetName="PressedLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" />
            </Storyboard>
          </VisualState>
          <VisualState x:Name="Pressed">
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" />
              <DoubleAnimation Storyboard.TargetName="PressedLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" />
            </Storyboard>
          </VisualState>
          <VisualState x:Name="Disabled" />
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>

      <Border x:Name="Rest" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.Control}" />
      <Border x:Name="HoverLayer" Opacity="0" Margin="{TemplateBinding BorderThickness}" Background="{TemplateBinding assist:ButtonAssist.HoverBackground}"
              CornerRadius="{StaticResource Radius.Control}" IsHitTestVisible="False" />
      <Border x:Name="PressedLayer" Opacity="0" Margin="{TemplateBinding BorderThickness}" Background="{TemplateBinding assist:ButtonAssist.PressedBackground}"
              CornerRadius="{StaticResource Radius.Control}" IsHitTestVisible="False" />
      <Rectangle x:Name="Dash" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" StrokeDashArray="3 3" RadiusX="6" RadiusY="6"
                 SnapsToDevicePixels="False" IsHitTestVisible="False" />
      <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        RecognizesAccessKey="True" />
      <assist:CrispBorder x:Name="FocusRing" Margin="{DynamicResource Inset.Neg4}" CornerRadius="{StaticResource Radius.FocusRing}" BorderThickness="{StaticResource Thickness.FocusRing}"
              BorderBrush="{DynamicResource Brush.Focus}" Visibility="Collapsed" IsHitTestVisible="False" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="assist:FocusAssist.ShowRing" Value="True">
        <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="Button.Base" TargetType="Button">
    <Setter Property="Template" Value="{StaticResource Button.Template}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.None}" />
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="MinHeight" Value="{StaticResource Height.Control}" />
    <Setter Property="MinWidth" Value="{StaticResource Height.Control}" />
    <Setter Property="Padding" Value="{StaticResource Pad.Button}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="assist:ButtonAssist.BusyText" Value="Working..." />
  </Style>

  <!-- Primary: the one main action. Pressed text is on-primary at 80 %. -->
  <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.OnPrimary}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="assist:ButtonAssist.HoverBackground" Value="{DynamicResource Brush.PrimaryHover}" />
    <Setter Property="assist:ButtonAssist.PressedBackground" Value="{DynamicResource Brush.PrimaryPressed}" />
    <Setter Property="assist:ButtonAssist.Sheen" Value="{DynamicResource Brush.PrimaryPressed}" />
    <Style.Triggers>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnPrimaryPressed}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="{DynamicResource Brush.Layer2}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke}" />
        <Setter Property="Cursor" Value="Arrow" />
      </Trigger>
      <!-- Busy wins over disabled: a command that is running disables its button, but it must look busy, not dead. -->
      <Trigger Property="assist:ButtonAssist.IsBusy" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnPrimary}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Cursor" Value="Wait" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="AutomationProperties.ItemStatus" Value="Busy" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Button.Secondary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Background" Value="{DynamicResource Brush.Layer}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke2}" />
    <Setter Property="assist:ButtonAssist.HoverBackground" Value="{DynamicResource Brush.Hover}" />
    <Setter Property="assist:ButtonAssist.PressedBackground" Value="{DynamicResource Brush.Selected}" />
    <Style.Triggers>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="{DynamicResource Brush.Layer2}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke}" />
        <Setter Property="Cursor" Value="Arrow" />
      </Trigger>
      <Trigger Property="assist:ButtonAssist.IsBusy" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.Layer}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke2}" />
        <Setter Property="Cursor" Value="Wait" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="AutomationProperties.ItemStatus" Value="Busy" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Subtle: the quiet action (no fill, no edge until hovered). Ghost is the same. It has no fill of its own, so it sits on whatever is behind it (a panel,
       the page canvas, Mica): its hover and pressed fills are tints of ink (Well 6 %, then CaptionHover 9 % over it), which show on every one of those. The
       opaque Hover token is the canvas colour, give or take a shade, and vanished there. -->
  <Style x:Key="Button.Subtle" TargetType="Button" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="assist:ButtonAssist.HoverBackground" Value="{DynamicResource Brush.Well}" />
    <Setter Property="assist:ButtonAssist.PressedBackground" Value="{DynamicResource Brush.CaptionHover}" />
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Cursor" Value="Arrow" />
      </Trigger>
      <Trigger Property="assist:ButtonAssist.IsBusy" Value="True">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Cursor" Value="Wait" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="AutomationProperties.ItemStatus" Value="Busy" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Button.Ghost" TargetType="Button" BasedOn="{StaticResource Button.Subtle}" />

  <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Background" Value="{DynamicResource Brush.Layer}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Critical}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.CriticalStroke}" />
    <Setter Property="assist:ButtonAssist.HoverBackground" Value="{DynamicResource Brush.CriticalSoft}" />
    <Setter Property="assist:ButtonAssist.PressedBackground" Value="{DynamicResource Brush.CriticalPressed}" />
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="{DynamicResource Brush.Layer2}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke}" />
        <Setter Property="Cursor" Value="Arrow" />
      </Trigger>
      <Trigger Property="assist:ButtonAssist.IsBusy" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.Layer}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Critical}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.CriticalStroke}" />
        <Setter Property="Cursor" Value="Wait" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="AutomationProperties.ItemStatus" Value="Busy" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Icon: a square 34 x 34 subtle button holding one Icon. -->
  <Style x:Key="Button.Icon" TargetType="Button" BasedOn="{StaticResource Button.Subtle}">
    <Setter Property="Width" Value="{StaticResource Height.Control}" />
    <Setter Property="Height" Value="{StaticResource Height.Control}" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <!-- Tonal is the secondary look in direction A. -->
  <Style x:Key="Button.Tonal" TargetType="Button" BasedOn="{StaticResource Button.Secondary}" />

  <!-- Chip: the dashed "+ Blood group" filter chip, 34 tall. -->
  <Style x:Key="Button.Chip" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
    <Setter Property="Template" Value="{StaticResource Button.Chip.Template}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke2}" />
  </Style>

  <!-- Small variants: 28 tall, padding 10, 13 px. -->
  <Style x:Key="Button.Primary.Small" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
    <Setter Property="MinHeight" Value="{StaticResource Height.Compact}" />
    <Setter Property="MinWidth" Value="{StaticResource Height.Compact}" />
    <Setter Property="Padding" Value="{StaticResource Pad.ButtonSmall}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Label}" />
  </Style>
  <Style x:Key="Button.Secondary.Small" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
    <Setter Property="MinHeight" Value="{StaticResource Height.Compact}" />
    <Setter Property="MinWidth" Value="{StaticResource Height.Compact}" />
    <Setter Property="Padding" Value="{StaticResource Pad.ButtonSmall}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Label}" />
  </Style>
  <Style x:Key="Button.Subtle.Small" TargetType="Button" BasedOn="{StaticResource Button.Subtle}">
    <Setter Property="MinHeight" Value="{StaticResource Height.Compact}" />
    <Setter Property="MinWidth" Value="{StaticResource Height.Compact}" />
    <Setter Property="Padding" Value="{StaticResource Pad.ButtonSmall}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Label}" />
  </Style>
  <Style x:Key="Button.Danger.Small" TargetType="Button" BasedOn="{StaticResource Button.Danger}">
    <Setter Property="MinHeight" Value="{StaticResource Height.Compact}" />
    <Setter Property="MinWidth" Value="{StaticResource Height.Compact}" />
    <Setter Property="Padding" Value="{StaticResource Pad.ButtonSmall}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Label}" />
  </Style>
  <Style x:Key="Button.Icon.Small" TargetType="Button" BasedOn="{StaticResource Button.Icon}">
    <Setter Property="MinHeight" Value="{StaticResource Height.Compact}" />
    <Setter Property="MinWidth" Value="{StaticResource Height.Compact}" />
    <Setter Property="Width" Value="{StaticResource Height.Compact}" />
    <Setter Property="Height" Value="{StaticResource Height.Compact}" />
  </Style>

  <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}" />
</ResourceDictionary>
