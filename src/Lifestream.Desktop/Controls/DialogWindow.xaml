<chrome:ChromeWindow x:Class="Lifestream.Desktop.Controls.DialogWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Lifestream.Desktop.Controls"
                     xmlns:chrome="clr-namespace:Lifestream.Desktop.Chrome"
                     xmlns:theme="clr-namespace:Lifestream.Desktop.Theme" theme:TextDefaults.Apply="True"
                     Title="Lifestream" Width="544" MaxHeight="824" SizeToContent="Height" IsDialog="True" ResizeMode="NoResize"
                     WindowStyle="None" AllowsTransparency="True" Background="Transparent" ExtendsContentIntoTitleBar="True" TitleBarHeight="88"
                     WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <!-- The confirmation and error dialog, on direction A's dialog surface like every form dialog (Features/Dialogs/FormDialogWindow): the window itself is
       transparent and keeps 32 px of room around the DialogSurface for its shadow (Width 544 = a 480 surface + 2 x 32); the surface draws the 12 px corners,
       the 1 px stroke, the title, the body and the footer with the buttons. The top 88 px (the shadow room and the title row) drag the window. A confirmation
       has no close button: Cancel (which has the initial focus) and Esc are the ways out. -->
  <chrome:ChromeWindow.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </chrome:ChromeWindow.Resources>
  <controls:DialogSurface x:Name="Surface" Margin="{DynamicResource Pad.32}" Padding="{DynamicResource Inset.L24T16R24B24}">
    <StackPanel>
      <TextBlock x:Name="BodyText" Style="{DynamicResource Text.Body}" Foreground="{DynamicResource Brush.Ink2}" TextWrapping="Wrap" />
      <StackPanel x:Name="DetailsPanel" Margin="{DynamicResource Inset.T16}" Visibility="Collapsed">
        <ToggleButton x:Name="DetailsToggle" Style="{DynamicResource Surfaces.SubtleToggle}" Content="Details" HorizontalAlignment="Left" AutomationProperties.Name="Details" />
        <TextBox x:Name="DetailsBox" IsReadOnly="True" TextWrapping="Wrap" Margin="{DynamicResource Inset.T8}" Padding="{DynamicResource Pad.8}" MinHeight="0" AutomationProperties.Name="Technical details"
                 Visibility="{Binding IsChecked, ElementName=DetailsToggle, Converter={StaticResource BoolToVisibility}}" />
      </StackPanel>
    </StackPanel>
    <controls:DialogSurface.Footer>
      <StackPanel Orientation="Horizontal">
        <Button x:Name="CancelButton" Style="{DynamicResource Button.Secondary}" Content="Cancel" IsCancel="True" Margin="{DynamicResource Inset.R8}" />
        <Button x:Name="PrimaryButton" Style="{DynamicResource Button.Danger}" Content="Delete" Click="OnPrimaryClick" />
      </StackPanel>
    </controls:DialogSurface.Footer>
  </controls:DialogSurface>
</chrome:ChromeWindow>
