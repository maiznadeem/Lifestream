<chrome:ChromeWindow x:Class="Lifestream.Desktop.Controls.DialogWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:chrome="clr-namespace:Lifestream.Desktop.Chrome"
                     Title="Lifestream" Width="480" SizeToContent="Height" IsDialog="True" ResizeMode="NoResize"
                     WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <chrome:ChromeWindow.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </chrome:ChromeWindow.Resources>
  <Grid Margin="24,16,24,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock x:Name="HeadingText" Style="{DynamicResource Text.Heading}" AutomationProperties.HeadingLevel="Level1" />
    <TextBlock x:Name="BodyText" Grid.Row="1" Style="{DynamicResource Text.Body}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,8,0,0" />
    <StackPanel x:Name="DetailsPanel" Grid.Row="2" Margin="0,16,0,0" Visibility="Collapsed">
      <ToggleButton x:Name="DetailsToggle" Content="Details" HorizontalAlignment="Left" AutomationProperties.Name="Details">
        <ToggleButton.Template>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bd" MinHeight="32" Padding="12,0" CornerRadius="{DynamicResource Radius.Control}" Background="Transparent" BorderBrush="{DynamicResource Brush.BorderInput}"
                    BorderThickness="1">
              <TextBlock Text="{TemplateBinding Content}" Style="{DynamicResource Text.Label}" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfacePressed}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}" />
                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </ToggleButton.Template>
      </ToggleButton>
      <TextBox x:Name="DetailsBox" IsReadOnly="True" TextWrapping="Wrap" Margin="0,8,0,0" Padding="8" MinHeight="0" AutomationProperties.Name="Technical details"
               Visibility="{Binding IsChecked, ElementName=DetailsToggle, Converter={StaticResource BoolToVisibility}}" />
    </StackPanel>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
      <Button x:Name="CancelButton" Style="{DynamicResource Button.Secondary}" Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
      <Button x:Name="PrimaryButton" Style="{DynamicResource Button.Danger}" Content="Delete" Click="OnPrimaryClick" />
    </StackPanel>
  </Grid>
</chrome:ChromeWindow>
