<ResourceDictionary xmlns:controls="clr-namespace:Lifestream.Desktop.Controls" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Lifestream.Desktop.Controls">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Lifestream;component/Theme/Tokens.xaml" />
    <ResourceDictionary Source="/Lifestream;component/Theme/Motion.xaml" />
    <ResourceDictionary Source="/Lifestream;component/Theme/Typography.xaml" />
    <ResourceDictionary Source="/Lifestream;component/Controls/Inputs.xaml" />
    <ResourceDictionary Source="/Lifestream;component/Controls/Buttons.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- The password field: the two boxes (masked and revealed) are the ordinary input look; the reveal toggle is a 16 px Eye / Eyeoff icon in Ink3 at the right. The part names are
       the ones PasswordField.cs looks up (PART_Password, PART_Plain, PART_Toggle). -->
  <Style TargetType="local:PasswordField">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:PasswordField">
          <Grid>
            <PasswordBox x:Name="PART_Password" Padding="{DynamicResource Inset.L10R40}" AutomationProperties.Name="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}" />
            <TextBox x:Name="PART_Plain" Padding="{DynamicResource Inset.L10R40}" Visibility="Collapsed" IsReadOnly="{TemplateBinding IsReadOnly}"
                     AutomationProperties.Name="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}" />
            <ToggleButton x:Name="PART_Toggle" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="{DynamicResource Inset.R3}" Width="28" Height="28"
                          IsChecked="{Binding IsRevealed, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                          AutomationProperties.Name="Show password" Focusable="True" Cursor="Hand">
              <ToggleButton.Style>
                <Style TargetType="ToggleButton">
                  <Setter Property="ToolTip" Value="Show password" />
                  <Style.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter Property="ToolTip" Value="Hide password" />
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </ToggleButton.Style>
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Grid>
                    <Border x:Name="Bd" CornerRadius="{StaticResource Radius.Control}" Background="Transparent" />
                    <controls:Icon x:Name="Glyph" Kind="Eye" Size="16" Foreground="{DynamicResource Brush.Ink3}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <controls:CrispBorder x:Name="FocusRing" Margin="{DynamicResource Inset.Neg4}" CornerRadius="{StaticResource Radius.FocusRing}" BorderThickness="{StaticResource Thickness.FocusRing}"
                            BorderBrush="{DynamicResource Brush.Focus}" Visibility="Collapsed" IsHitTestVisible="False" />
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                      <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="Glyph" Property="Kind" Value="Eyeoff" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                      <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Selected}" />
                    </Trigger>
                    <Trigger Property="controls:FocusAssist.ShowRing" Value="True">
                      <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsRevealed" Value="True">
              <Setter TargetName="PART_Password" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="PART_Plain" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="ShowToggle" Value="False">
              <Setter TargetName="PART_Toggle" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsReadOnly" Value="True">
              <Setter TargetName="PART_Toggle" Property="IsEnabled" Value="False" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
