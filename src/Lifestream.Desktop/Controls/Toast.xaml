<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:common="clr-namespace:Lifestream.Client.Common;assembly=Lifestream.Client"
                    xmlns:controls="clr-namespace:Lifestream.Desktop.Controls">
  <!-- A toast item is shown by ToastView; this is the only thing the host needs to know. -->
  <DataTemplate DataType="{x:Type common:ToastItem}">
    <controls:ToastView />
  </DataTemplate>
</ResourceDictionary>
