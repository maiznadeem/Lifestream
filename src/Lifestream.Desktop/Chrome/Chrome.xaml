<ResourceDictionary xmlns:controls="clr-namespace:Lifestream.Desktop.Controls" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:chrome="clr-namespace:Lifestream.Desktop.Chrome">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Lifestream;component/Theme/Tokens.xaml" />
    <ResourceDictionary Source="/Lifestream;component/Theme/Typography.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- Caption buttons: 46 x 32 DIP. The highlight is the whole button, and that same rectangle is the hit-test region. -->
  <Style x:Key="CaptionButton" TargetType="Button">
    <Setter Property="Width" Value="{StaticResource Width.CaptionButton}" />
    <Setter Property="Height" Value="{StaticResource Height.CaptionButton}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="Transparent">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfacePressed}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CaptionButton.Close" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="Transparent">
            <ContentPresenter x:Name="Glyph" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Primary}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnPrimary}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.PrimaryPressed}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnPrimary}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="chrome:ChromeWindow">
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceCanvas}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <!-- Small text is laid out on whole pixels (GDI-compatible metrics) so 12 to 14 DIP text is crisp with ClearType; the large text styles opt back
         into Ideal, where sub-pixel positioning looks better (Theme/Typography.xaml). -->
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    <!-- The app icon in the title bar, the taskbar and Alt+Tab (the same .ico as the executable's). -->
    <Setter Property="Icon" Value="pack://application:,,,/Lifestream;component/Assets/Lifestream.ico" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="chrome:ChromeWindow">
          <Border x:Name="PART_Root" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="1">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="{StaticResource Grid.Height.Caption}" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid Background="Transparent">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="{DynamicResource Inset.L12}" VerticalAlignment="Center">
                  <Image x:Name="CaptionMark" Source="{DynamicResource Image.LogoSmall}" Width="16" Height="16" Margin="{DynamicResource Inset.R8}" VerticalAlignment="Center"
                         RenderOptions.BitmapScalingMode="HighQuality" />
                  <TextBlock Style="{StaticResource Text.Label}" Text="{TemplateBinding Title}" Foreground="{DynamicResource Brush.TextSecondary}"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" AutomationProperties.Name="Window title" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                  <Button x:Name="PART_Minimize" Style="{StaticResource CaptionButton}" Command="{x:Static SystemCommands.MinimizeWindowCommand}"
                          AutomationProperties.Name="Minimize" ToolTip="Minimize">
                    <controls:IconText Style="{StaticResource Text.Icon}" Text="&#xE921;" FontSize="12" />
                  </Button>
                  <!-- Not hit-testable by WPF: Windows answers HTMAXBUTTON for it, which gives Snap Layouts. It highlights from IsMaximizeHovered. -->
                  <Border x:Name="PART_Maximize" Width="{StaticResource Width.CaptionButton}" Height="{StaticResource Height.CaptionButton}" Background="Transparent"
                          AutomationProperties.Name="Maximize" AutomationProperties.HelpText="Maximize or restore the window">
                    <controls:IconText x:Name="MaximizeGlyph" Style="{StaticResource Text.Icon}" Text="&#xE922;" FontSize="12" Foreground="{DynamicResource Brush.TextPrimary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <Button x:Name="PART_Close" Style="{StaticResource CaptionButton.Close}" Command="{x:Static SystemCommands.CloseWindowCommand}"
                          AutomationProperties.Name="Close" ToolTip="Close">
                    <controls:IconText Style="{StaticResource Text.Icon}" Text="&#xE8BB;" FontSize="12" />
                  </Button>
                </StackPanel>
              </Grid>
              <AdornerDecorator Grid.Row="1">
                <ContentPresenter />
              </AdornerDecorator>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="WindowState" Value="Maximized">
              <Setter TargetName="MaximizeGlyph" Property="Text" Value="&#xE923;" />
              <Setter TargetName="PART_Maximize" Property="AutomationProperties.Name" Value="Restore" />
              <Setter TargetName="PART_Root" Property="BorderThickness" Value="0" />
            </Trigger>
            <Trigger Property="IsMaximizeHovered" Value="True">
              <Setter TargetName="PART_Maximize" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
            </Trigger>
            <Trigger Property="IsMaximizePressed" Value="True">
              <Setter TargetName="PART_Maximize" Property="Background" Value="{DynamicResource Brush.SurfacePressed}" />
            </Trigger>
            <Trigger Property="IsDialog" Value="True">
              <Setter TargetName="PART_Minimize" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="PART_Maximize" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
