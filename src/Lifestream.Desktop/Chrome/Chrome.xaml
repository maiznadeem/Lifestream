<ResourceDictionary xmlns:controls="clr-namespace:Lifestream.Desktop.Controls" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:chrome="clr-namespace:Lifestream.Desktop.Chrome">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Lifestream;component/Theme/Tokens.xaml" />
    <ResourceDictionary Source="/Lifestream;component/Theme/Motion.xaml" />
    <ResourceDictionary Source="/Lifestream;component/Theme/Typography.xaml" />
    <ResourceDictionary Source="/Lifestream;component/Theme/Images.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- Caption buttons (direction A): 46 DIP wide, as tall as the title bar. Rest: Ink glyph on nothing; hover: ink at 9 %; pressed: ink at 5 %
       with the glyph at 70 %; close hover: #C42B1C with a white glyph. The highlight is the whole button, and that same rectangle is the hit-test region. -->
  <Style x:Key="CaptionButton" TargetType="Button">
    <Setter Property="Width" Value="{StaticResource Width.CaptionButton}" />
    <Setter Property="Height" Value="{Binding TitleBarHeight, RelativeSource={RelativeSource AncestorType=chrome:ChromeWindow}}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="Transparent">
            <ContentPresenter x:Name="Glyph" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.CaptionHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.CaptionPressed}" />
              <Setter TargetName="Glyph" Property="Opacity" Value="0.7" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CaptionButton.Close" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="Transparent">
            <ContentPresenter x:Name="Glyph" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.CloseHover}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.OnCloseHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.CloseHover}" />
              <Setter TargetName="Glyph" Property="Opacity" Value="0.7" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.OnCloseHover}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The app mark of direction A: a blood drop with a white stream wave. Scales to any size; the colours follow the theme. -->
  <Style TargetType="controls:LogoMark">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:LogoMark">
          <Viewbox Stretch="Uniform">
            <Canvas Width="32" Height="32">
              <Path Data="{StaticResource Geometry.LogoDrop}" Fill="{DynamicResource Brush.Blood}" />
              <Path Data="{StaticResource Geometry.LogoWave}" Stroke="{DynamicResource Brush.OnBlood}" StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Canvas>
          </Viewbox>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="chrome:ChromeWindow">
    <!-- The window paints the Mica fallback; on Windows 11 the window's copy of Brush.Mica is transparent and real Mica shows through. -->
    <Setter Property="Background" Value="{DynamicResource Brush.Mica}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <!-- Small text is laid out on whole pixels (GDI-compatible metrics) so hinted 12 to 15 DIP Onest is crisp with ClearType; the 20 DIP and larger
         text styles opt back into Ideal, where sub-pixel positioning looks better (Theme/Typography.xaml, Fonts/README.md). -->
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    <Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
    <!-- The app icon in the title bar, the taskbar and Alt+Tab (the same .ico as the executable's). -->
    <Setter Property="Icon" Value="pack://application:,,,/Lifestream;component/Assets/Lifestream.ico" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="chrome:ChromeWindow">
          <controls:CrispBorder x:Name="PART_Root" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition x:Name="CaptionRow" Height="{Binding TitleBarHeight, RelativeSource={RelativeSource TemplatedParent}}" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <AdornerDecorator x:Name="ContentHost" Grid.Row="1">
                <ContentPresenter />
              </AdornerDecorator>
              <!-- The default caption: the mark and the window title (dialogs). Hidden when the content draws its own title bar. -->
              <StackPanel x:Name="DefaultCaption" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <controls:LogoMark x:Name="CaptionMark" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Style="{StaticResource Text.Label}" Text="{TemplateBinding Title}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" AutomationProperties.Name="Window title" />
              </StackPanel>
              <StackPanel x:Name="CaptionButtons" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="10">
                <Button x:Name="PART_Minimize" Style="{StaticResource CaptionButton}" Command="{x:Static SystemCommands.MinimizeWindowCommand}"
                        AutomationProperties.Name="Minimize" ToolTip="Minimize">
                  <controls:IconText Style="{StaticResource Text.Icon}" Text="&#xE921;" FontSize="10" />
                </Button>
                <!-- Not hit-testable by WPF: Windows answers HTMAXBUTTON for it, which gives Snap Layouts. It highlights from IsMaximizeHovered. -->
                <Border x:Name="PART_Maximize" Width="{StaticResource Width.CaptionButton}" Height="{Binding TitleBarHeight, RelativeSource={RelativeSource TemplatedParent}}" Background="Transparent"
                        AutomationProperties.Name="Maximize" AutomationProperties.HelpText="Maximize or restore the window">
                  <controls:IconText x:Name="MaximizeGlyph" Style="{StaticResource Text.Icon}" Text="&#xE922;" FontSize="10" Foreground="{DynamicResource Brush.Ink}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Button x:Name="PART_Close" Style="{StaticResource CaptionButton.Close}" Command="{x:Static SystemCommands.CloseWindowCommand}"
                        AutomationProperties.Name="Close" ToolTip="Close">
                  <controls:IconText Style="{StaticResource Text.Icon}" Text="&#xE8BB;" FontSize="10" />
                </Button>
              </StackPanel>
            </Grid>
          </controls:CrispBorder>
          <ControlTemplate.Triggers>
            <Trigger Property="ExtendsContentIntoTitleBar" Value="True">
              <Setter TargetName="ContentHost" Property="Grid.Row" Value="0" />
              <Setter TargetName="ContentHost" Property="Grid.RowSpan" Value="2" />
              <Setter TargetName="DefaultCaption" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="WindowState" Value="Maximized">
              <Setter TargetName="MaximizeGlyph" Property="Text" Value="&#xE923;" />
              <Setter TargetName="PART_Maximize" Property="AutomationProperties.Name" Value="Restore" />
            </Trigger>
            <Trigger Property="IsMaximizeHovered" Value="True">
              <Setter TargetName="PART_Maximize" Property="Background" Value="{DynamicResource Brush.CaptionHover}" />
            </Trigger>
            <Trigger Property="IsMaximizePressed" Value="True">
              <Setter TargetName="PART_Maximize" Property="Background" Value="{DynamicResource Brush.CaptionPressed}" />
              <Setter TargetName="MaximizeGlyph" Property="Opacity" Value="0.7" />
            </Trigger>
            <Trigger Property="IsDialog" Value="True">
              <Setter TargetName="PART_Minimize" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="PART_Maximize" Property="Visibility" Value="Collapsed" />
              <Setter Property="Background" Value="{DynamicResource Brush.Layer}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
