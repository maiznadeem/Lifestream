<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Timing tests are tagged Category=Perf and run alone in a perf pass: run them with: dotnet test, filter Category=Perf; an explicit filter replaces this default. -->
    <VSTestTestCaseFilter>Category!=Perf</VSTestTestCaseFilter>
  </PropertyGroup>
  <ItemGroup>
    <!-- xUnit's default (conservative) parallel algorithm, on purpose. The aggressive one starts another class whenever one awaits SQL Server; on 8 cores that
         saved 16 s, but on the 4 processors of a CI runner, shared with SQL Server, it starts more than the server can answer in time (requests of
         milliseconds took up to 30 s and a different timing-dependent test failed in about one run in three) and the run is slower (150 s against 134 s). -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <ProjectReference Include="..\..\src\Lifestream.Api\Lifestream.Api.csproj" />
  </ItemGroup>
</Project>
